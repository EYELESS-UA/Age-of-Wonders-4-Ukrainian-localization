msgid "DLC@SECRETSOFTHEARCHMAGES@STORY_EVENT@1167_1515@BUTTON_3"
msgstr "Uwolnij <<acc:c:{EventUnit}>> od przysigi i zapiecztuj <<acc:c:{EventStructure}>>."

