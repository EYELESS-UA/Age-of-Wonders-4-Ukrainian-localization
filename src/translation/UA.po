msgstr "Вознесіння: Віщун"

msgid "DLC@ARCHONPROPHECY@META_EMPIRE@ASCENSION_TRAIT@ASCENDED_DIVINER@PROP_DESCRIPTION"
msgstr "Дружні юніти в радіусі {ASCENDED_DIVINER_TARGETER>AREA>Radius} отримують {GLOBAL.PROPERTIES.PRECOGNITION.Hyperlink}."

msgid "DLC@ARCHONPROPHECY@META_EMPIRE@ASCENSION_TRAIT@ASCENDED_DIVINER@PROP_NAME"
msgstr "Вознесений віщун"

msgid "DLC@ARCHONPROPHECY@META_EMPIRE@ASCENSION_TRAIT@GUARDIAN_ANGEL@HERO_TRAIT_DESCRIPTION"
msgstr "Отримує {GLOBAL.PROPERTIES.GUARDIAN_ANGEL_AUTO_SPELL.Hyperlink}."

