msgid "WILDLIFE_UNITPROPERTIES@WILDHUNT_PRESENCE_04@NAME"
msgstr "Вплив Відчаю^mn{1}x{2}"

msgid "WILDLIFE_UNITPROPERTIES@WILDHUNT_PRESENCE_04@PROP_DESCRIPTION"
msgstr ""
"Юніти власника ефекту отримують:[bulletlist][bullet/]{GLOBAL.PROPERTIES.MORALE_DRAIN.Hyperlink}[bullet/]+%{amount} до шкоди проти "
