msgstr "Очки чаклування +{CP_BONUS_OPERATION>PointsToGive}"

msgid "UNITPROPERTIES@CP_BONUS@PROPERTY@@NAME"
msgstr "Бонус до вартості чаклування"

msgid "UNITPROPERTIES@CP_BONUS@PROPERTY@NAME"
msgstr "Бонус до вартості чаклування"

msgid "UNITPROPERTIES@CP_BONUS_GREATER@PROPERTY@NAME"
msgstr "Посилений бонус до вартості чаклування"

msgid "UNITPROPERTIES@CUMBERSOME@DESCRIPTION"
msgstr "Цей юніт рухається повільніше у тактичному бою."

msgid "UNITPROPERTIES@CUMBERSOME@NAME"
msgstr "Незграбність"

msgid "UNITPROPERTIES@CURSE_EATER@DESCRIPTION"
msgstr ""
"На початку кожного ходу:[bulletlist][bullet/]Юніт втрачає один випадковий негативний ефект і відновлює {heal} "
