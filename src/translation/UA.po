msgid "DEFAULT@LORD@TALYA@BIO@HERO_2"
msgstr "Траву потрібно косити; зло потрібно викорінювати. Священний обов'язок святого — піклуватися про Господню ділянку."

msgid "DEFAULT@LORD@TALYA@BIO@HERO_3"
