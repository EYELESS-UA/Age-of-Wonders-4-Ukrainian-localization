"{GLOBAL.PROPERTIES.CONSTRUCT.Hyperlink}>>."

msgid "UNITPROPERTIES@CONSTRUCT_SLAYER@NAME"
msgstr "Знищувач конструктів"

msgid "UNITPROPERTIES@CP_BONUS@DESCRIPTION"
msgstr ""
"Надає +{CP_BONUS_OPERATION>PointsToGive} [optactical/] [hyperlink,GLOBAL.CombatCastingPoint]одиниць для чаклування у бою[/"
