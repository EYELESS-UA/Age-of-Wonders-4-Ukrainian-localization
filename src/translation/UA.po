msgid "CONCEPT@SPIRIT_RESISTANCE@NAME"
msgstr "Опір духу"

msgid "CONCEPT@STATUS_RESISTANCE@DESCRIPTION"
msgstr "Опір статусам зменшує ймовірність отримання негативних ефектів статусу на юніта."

