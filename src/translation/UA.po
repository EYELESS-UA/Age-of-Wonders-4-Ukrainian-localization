msgstr "[hyperlink,GLOBAL.VaultsphereLoreConcept]Сфероскарб[/hyperlink]"

msgid "INTERFACE@LORE_CONCEPT@VAULTSPHERE@TITLE"
msgstr "Сфероскарб"

