msgid "CONCEPT@SPIRIT_RESISTANCE@DESCRIPTION"
msgstr "Опір духу знижує [damageSpirit/] [hyperlink,GLOBAL.SpiritDamageConcept]духову шкоду[/hyperlink]."

msgid "CONCEPT@SPIRIT_RESISTANCE@HYPERLINK"
