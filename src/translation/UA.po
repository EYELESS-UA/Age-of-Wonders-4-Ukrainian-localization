msgstr "{Shop} знищено!"

msgid "INTERFACE@EVENT@SHOP_STRUCTURE_DESTROYED@NOT_OWNER_DESCRIPTION"
msgstr "{Shop} в <<g:domain^p,OwnerSide>> був знищений {KillerSide}."

msgid "INTERFACE@EVENT@SHOP_STRUCTURE_DESTROYED@OWNER_DESCRIPTION"
msgstr "{KillerSide} знищив {Shop} в твоїх володіннях. Ти отримуєш скаргу проти <<P:KillerSide>>."

msgid "INTERFACE@EVENT@SHOP_STRUCTURE_DESTROYED@SETTING"
msgstr "[white]Shop Name[/white] знищено!"

