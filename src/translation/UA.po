msgid "TACTICAL_AI_PROFILE@HARD@NAME"
msgstr "Складний+"

msgid "TACTICAL_AI_PROFILE@MEDIUM@DESCRIPTION"
msgstr "Штучний інтелект використовуватиме оптимальне позиціонування та буде зосереджений на вбивстві юнітівю"

msgid "TACTICAL_AI_PROFILE@MEDIUM@NAME"
msgstr "Складний"

msgid "TC_PROPERTY@FRIENDLY_TRANSFORMATION@ASTRAL_ATTUNEMENT@ATTACKER@DESCRIPTION"
