"місцевості, на якій знаходиться юніт.[bullet/]+{amount2} шкоди від атак залежно від місцевості, на якій знаходиться юніт.[/"
"bulletlist][br/]{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "DLC@GIANTKINGS@TOME_GEOMANCY@SKILL2@SPIRIT@NAME"
msgstr "Геомантична кристалізація: Дух"

msgid "DLC@GIANTKINGS@TOME_GEOMANCY@SKILL3@DESCRIPTION"
msgstr ""
