msgid "DLC@GIANTKINGS@SHOPS_STRATEGIC@TRAINING_CAMP@UNIT@NAME"
msgstr "Огр-тренер^Mn{1}n{2}"

msgid "DLC@GIANTKINGS@SHOPS_STRATEGIC@TRAINING_CAMP@VIGOR_SKILL"
msgstr "Підвищена енергійність"

msgid "DLC@GIANTKINGS@SHOPS_STRATEGIC@TRAINING_CAMP_MORTAL_ONLY"
msgstr "Лише смертні чемпіони можуть змінювати клас."

msgid "DLC@GIANTKINGS@SHOPS_STRATEGIC@TRAINING_CAMP_NO_PANTHEON"
msgstr "Герої пантеону не можуть змінювати клас."

msgid "DLC@GIANTKINGS@SHOPS_TACTICAL@CART@NAME"
msgstr "Кошик"

msgid "DLC@GIANTKINGS@SHOP_OGRES_UNIT_ABILITIES_01@DESCRIPTION"
msgstr ""
"Отримані цільові ворожі юніти:[bulletlist][bullet/]{amount} {GLOBAL.PROPERTIES.SUNDERED_DEFENSE.Hyperlink} протягом "
"{SUNDERED_DEFENSE_EFFECT_DESCRIPTION>NumTurns} [hyperlink,GLOBAL.TurnConcept]ходи[/hyperlink].[bullet/]{amount} "
"{GLOBAL.PROPERTIES.SUNDERED_RESISTANCE.Hyperlink} на {SUNDERED_RESISTANCE_EFFECT_DESCRIPTION>NumTurns} "
"[hyperlink,GLOBAL.TurnConcept]ходи[/hyperlink][bullet/]{amount} {GLOBAL.PROPERTIES.STATUS_VULNERABILITY.Hyperlink} на "
"{STATUS_VULNERABILITY_DESCRIPTION>NumTurns} [hyperlink,GLOBAL.TurnConcept]ходи[/hyperlink]"

msgid "DLC@GIANTKINGS@SHOP_OGRES_UNIT_ABILITIES_01@NAME"
msgstr "Викриття саботажу^nn{1}x{2}"

msgid "DLC@GIANTKINGS@SHOP_OGRES_UNIT_ABILITIES_02@DESCRIPTION"
msgstr ""
"Ворожі юніти в радіусі {REVEAL_FEARS_TARGETER>AREA>Radius}-хрестовини мають базовий "
"{REVEAL_FEARS_RESISTANCE_CHECK>ResolvedStrength}% втратити {REVEAL_FEARS_MORALE>Morale Change} "
"{GLOBAL.UnitMoraleConcept.Hyperlink}."

msgid "DLC@GIANTKINGS@SHOP_OGRES_UNIT_ABILITIES_02@NAME"
msgstr "Виявити страхи"

msgid "DLC@GIANTKINGS@SHOP_OGRES_UNIT_ABILITIES_03@DESCRIPTION"
msgstr "Цільові дружні одиниці отримують {amount} випадковий <<m:{GLOBAL.PositiveStatusEffectConcept.Hyperlink}>>."

msgid "DLC@GIANTKINGS@SHOP_OGRES_UNIT_ABILITIES_03@NAME"
msgstr "Поради експертів"

msgid "DLC@GIANTKINGS@SHOP_OGRES_UNIT_ABILITIES_04@DESCRIPTION"
msgstr "Вибраний союзний юніт відновлює повне здоров’я у формі <<gen:c:{GLOBAL.TemporaryHitPointConcept.Hyperlink}>>."

msgid "DLC@GIANTKINGS@SHOP_OGRES_UNIT_ABILITIES_04@NAME"
msgstr "Поверніться в бій"

msgid "DLC@GIANTKINGS@SHOP_OGRES_UNIT_ABILITIES_05@DESCRIPTION"
msgstr "Цільовий дружній юніт відновлює всі свої <<m:{GLOBAL.ActionPointConcept.Hyperlink}>>."

msgid "DLC@GIANTKINGS@SHOP_OGRES_UNIT_ABILITIES_05@NAME"
msgstr "Спонукання до дії"

msgid "DLC@GIANTKINGS@SHOP_OGRES_UNIT_ABILITIES_06@DESCRIPTION"
msgstr ""
"Інші юніти в армії отримують на {EXPERT_TRAINER_EXTRA_XP>ResolvedProportion}% більше [happiness/] "
"[hyperlink,GLOBAL.CityStabilityConcept]стабільності міста[/hyperlink] за бій."

msgid "DLC@GIANTKINGS@SHOP_OGRES_UNIT_ABILITIES_06@NAME"
msgstr "Тренер-експерт"

msgid "DLC@GIANTKINGS@SHOP_OGRES_UNIT_ABILITIES_07@DESCRIPTION"
msgstr "Призиває випадкову звірину або драконячу бойову юніта III рівня.{LOC.CONCEPT@SUMMON_LIVE_SHARED}"

msgid "DLC@GIANTKINGS@SHOP_OGRES_UNIT_ABILITIES_07@NAME"
msgstr "Закликання більшої потвори^nn{1}x{2}x{3}"

msgid "DLC@GIANTKINGS@SHOP_OGRES_UNIT_ABILITIES_08@DESCRIPTION"
msgstr ""
"Дружній для цілей юніт-тварина або дракон:[bulletlist][bullet/]Лічить {NURTURE_HEAL>NumHitpointsToRestore} "
"[hyperlink,GLOBAL.TemporaryHitPointConcept][temphp/] тимчасових очок здоров'я[/hyperlink].[bullet/]Отримує {amount} "
"{GLOBAL.PROPERTIES.BOLSTERED_DEFENSE.Hyperlink} на {BOLSTERED_DEFENSE_EFFECT_DESCRIPTION>NumTurns} "
"[hyperlink,GLOBAL.TurnConcept]ходи[/hyperlink].[bullet/]Отримує {amount} {GLOBAL.PROPERTIES.BOLSTERED_RESISTANCE.Hyperlink} на "
"{BOLSTERED_RESISTANCE_EFFECT_DESCRIPTION>NumTurns} [hyperlink,GLOBAL.TurnConcept]ходи[/hyperlink].[/bulletlist]"

msgid "DLC@GIANTKINGS@SHOP_OGRES_UNIT_ABILITIES_08@NAME"
msgstr "Виховання"

msgid "DLC@GIANTKINGS@SHOP_OGRES_UNIT_ABILITIES_09@COMBAT_DESCRIPTION"
msgstr ""
"Тварини та дракони, що набуваються у власника цього ефекту, отримують:[bulletlist][bullet/]+"
"{BEASTMASTER_STAT_BONUS>BONUS>DEFENSE>Armor} {GLOBAL.DefenseConcept.Hyperlink}[bullet/]+"
"{BEASTMASTER_STAT_BONUS>BONUS>DEFENSE>Resistance} {GLOBAL.ResistanceConcept.Hyperlink}[bullet/]+"
"{BEASTMASTER_DAMAGE>ResolvedMultiplier}% шкоди[/bulletlist]"

msgid "DLC@GIANTKINGS@SHOP_OGRES_UNIT_ABILITIES_09@DESCRIPTION"
msgstr ""
"Поки цей юніт перебуває в бою, загони тварин та драконів отримують:[bulletlist][bullet/]+"
"{BEASTMASTER_STAT_BONUS>BONUS>DEFENSE>Armor} {GLOBAL.DefenseConcept.Hyperlink}[bullet/]+"
"{BEASTMASTER_STAT_BONUS>BONUS>DEFENSE>Resistance} {GLOBAL.ResistanceConcept.Hyperlink}[bullet/]+"
"{BEASTMASTER_DAMAGE>ResolvedMultiplier}% шкоди[/bulletlist]"

msgid "DLC@GIANTKINGS@SHOP_OGRES_UNIT_ABILITIES_09@NAME"
msgstr "Повелитель Звірів"

msgid "DLC@GIANTKINGS@SHOP_OGRES_UNIT_ABILITIES_09@PROP_DESCRIPTION"
msgstr ""
"Юніт має:[bulletlist][bullet/]+{BEASTMASTER_STAT_BONUS>BONUS>DEFENSE>Armor} {GLOBAL.DefenseConcept.Hyperlink}[bullet/]+"
"{BEASTMASTER_STAT_BONUS>BONUS>DEFENSE>Resistance} {GLOBAL.ResistanceConcept.Hyperlink}[bullet/]+"
"{BEASTMASTER_DAMAGE>ResolvedMultiplier}% пошкоджень[/bulletlist]"

msgid "DLC@GIANTKINGS@SHOP_OGRES_UNIT_ABILITIES_10@DESCRIPTION"
msgstr ""
"Коли цей юніт гине, дружні юніти-тварини та дракони отримують:[bulletlist][bullet/]{amount} "
"{GLOBAL.PROPERTIES.STRENGTHENED.Hyperlink} на {STRENGTHENED_EFFECT_DESCRIPTION>NumTurns} [hyperlink,GLOBAL.TurnConcept]ходи[/"
"hyperlink].[bullet/]{GLOBAL.PROPERTIES.BERSERK.Hyperlink} на {BERSERK_DESCRIPTION_2>NumTurns} [hyperlink,GLOBAL.TurnConcept]ходи[/"
"hyperlink].[/bulletlist]"

msgid "DLC@GIANTKINGS@SHOP_OGRES_UNIT_ABILITIES_10@NAME"
msgstr "Батько стада^f"

msgid "DLC@GIANTKINGS@SOTTK_FINISHER@CULT_LEADER_EFFECTS_TOOLTIP"
msgstr ""
"Кожного разу, коли ти накладаєш чари душепрокляття, існує {IntChance}% ймовірності, що до твого володаря приєднається армія "
"культістів. Сила цієї армії залежить від рівня накладених чарів душепрокляття. У разі можливості активації кількох додаткових "
"ефектів душепрокляття, ймовірність підсумовується, але активується максимум {IntMax} ефектів."

msgid "DLC@GIANTKINGS@SOTTK_FINISHER@CULT_LEADER_TOOLTIP"
msgstr "До кінця гри ти є очільником культу <<gen:{GLOBAL.TraitorKingCultLoreConcept.Hyperlink}>>."

msgid "DLC@GIANTKINGS@SPAWNERS@LITHORINE_SPAWNER@DESCRIPTION"
msgstr ""
"Формація кристав, що неконтрольовано відтворює літорин.[br/]Залишена без нагляду, вона зміцниться і розширить територію, виславши "
"армії вторгнення."

msgid "DLC@GIANTKINGS@SPAWNERS@LITHORINE_SPAWNER@LORE"
msgstr ""
"Неприборканий сад, у якому ростуть скелі й літорит. З його глибин виливаються орди кам’яних потвор, що захищають свою територію. "
"Старші велетні з давно загубленої Мирриди колись творили й керували синтетичними істотами, яких у народі називали літоритами. "
"Істотам із саду, всупереч законам природи, якось вдалося відродити ту іскру життя. Очевидно, навіть синтетичне життя здатне "
"прокласти собі шлях."

msgid "DLC@GIANTKINGS@SPAWNERS@LITHORINE_SPAWNER@NAME"
msgstr "Колиска литоринів^f"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_722@BODY_FOOTER"
msgstr "Втікач помічає воїнів. З гарчанням, <<p:EnemyUnit>> хапає сусідній {EnemyUnit} та кидає його в {EventUnit}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_722@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Втікач {EnemyUnit} помічає ваших воїнів. З гарчанням, <<p:EnemyUnit>> хапає сусідній {EventUnit} і кидає його у вас."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_722@BODY_HEADER"
msgstr ""
"{EventHero} веде своє військо суходолом крізь тріщини й звуки стогону до озера лави, на якому було зведено споруду <<gen:c:"
"{EventStructure}>>."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_722@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr ""
"Твоє військо йде суходолом крізь тріщини та гуркіт обвалів до озера лави, на якому було зведено споруду <<gen:c:{EventStructure}>>."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_722@BODY_LORE"
msgstr ""
"{EventHero.FirstName} знаходить усередині <<EnemyUnit{покинутого й забутого/покинуту й забуту}>> <<acc:c:{EnemyUnit}>>, що "
"сидить<<EnemyUnit{ого/а}>> на підлозі в’язниці. Навколо <<EnemyUnit{нього/неї}>> в’ються десятки літоринових створінь. {EnemyUnit} "
"піднімає двох із них і вдаряє один об одного. На подив <<EventHero{твого героя/твоєї героїні}>> і на потіху <<gen:c:{EnemyUnit}>>, "
"<<c:m:{EventUnit}>> зливаються в нову юніта: <<acc:c:{EventUnitB}>>!"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_722@BODY_LORE@HERO_IS_PLAYERLE"
msgstr ""
"Усередині ви знайдете <<a:EnemyUnit>> вирвався з <<o:EnemyUnit>> камери, що сиділи навпочіпки на підлозі в'язниці. Десятки "
"літорінських істот, які влаштували тут свій вулик, повзають навколо <<P:EnemyUnit>>. {EnemyUnit} підбирає два <<m:EventUnit>> і "
"розбиває їх одне об одного. На ваш подив, і <<G:entertainment^n,EnemyUnit>>, <<m:EventUnit>> зберіть знову в {EventUnitB}!"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_722@BUTTON_0"
msgstr "Братися! До зброї!"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_722@BUTTON_1"
msgstr "Кинути аварійне оглушливе закляття [mana/] на <<acc:c:m:{EventUnit}>>."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_722@BUTTON_2"
msgstr "Впливає на швидкість пересування літоринових шкідників."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_722@BUTTON_3"
msgstr "Полиши місце події."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_722@BUTTON_4"
msgstr "Загін, до бою! Навіть наймогутніші не встоять перед тисячами ударів, завданих одночасно!"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_722@BUTTON_5"
msgstr "Накажи шахтарям [structureprod/] з міста {EventCity} бити в панцирі літоринових створінь."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_722@TITLE"
msgstr "Первісна глина"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_723@BODY_FOOTER"
msgstr ""
"Туші літорину відправляють до {EventCity} для використання як будівельні матеріали. Що ще ви конфіскуєте перед тим, як залишити "
"<<G:walls^p,EventStructure>>?"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_723@BODY_HEADER"
msgstr "Останні літорінські істоти розсипаються. {EnemyUnit} лежить на <<G:feet^p,EventHero>>, переможений."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_723@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Останні літорійські істоти розсипаються. {EnemyUnit} лежить біля ваших ніг, переможений."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_723@BODY_LORE"
msgstr ""
"{EventHero.FirstName} припускає, що зараження Літоріном зробило стіни в'язниці пористими та крихкими, що дозволило {EnemyUnit} "
"втекти. Звір нарешті піднімає <<r:EnemyUnit>> вгору та обережно спостерігає <<G:every action^n,{EventHero.FirstName}>>. "
"Використовуючи жести, ваш [hyperlink, GLOBAL.HeroConcept]<<EventHero{hero/heroine}>>[/hyperlink] повідомляє {EnemyUnit}, що "
"<<p:EventHero>> звільнить <<P:EnemyUnit>> з {EventStructure} якщо <<p:EnemyUnit>> готовий боротися за вас. Бегемот зрештою киває."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_723@BODY_LORE@HERO_IS_PLAYERLE"
msgstr ""
"Ви припускаєте, що нашестя Літоріну зробило стіни в'язниці пористими та крихкими, що дозволило {EnemyUnit} втекти. Звір нарешті "
"піднімається <<r:EnemyUnit>> піднімається та обережно спостерігає за кожною вашою дією. За допомогою жестів ви повідомляєте "
"{EnemyUnit}, що звільните <<P:EnemyUnit>> з {EventStructure} якщо <<p:EnemyUnit>> готовий боротися за вас. Бегемот зрештою киває."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_723@BUTTON_0"
msgstr "Добути коштовне каміння [gold/] з туш літоринових створінь."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_723@BUTTON_1"
msgstr "Зберіть {EventUnit} з уламків. [unit/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_723@BUTTON_2"
msgstr "Гілка {EventUnitB} слугуватиме {EventItem}. [item/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_723@TITLE"
msgstr "Первісна глина: наслідки"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_724@BODY_FOOTER"
msgstr ""
"У момент, коли {EnemyUnit} звільняється, <<EnemyUnit{його/її}>> сили повертаються. Як {EventHero.FirstName} впорається з "
"<<EnemyUnit{його/її}>> побратимами та союзниками?"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_724@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr ""
"У той момент, коли {EnemyUnit} звільняється, <<EnemyUnit{його/її}>> сили повертаються. Як ти впораєшся з <<EnemyUnit{його/її}>> "
"побратимами та союзниками?"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_724@BODY_HEADER"
msgstr ""
"{EventHero} та <<EventHero{його/її}>> юніти марширують повз <<EventStructure{вражаючу/вражаючий}>> <<acc:c:{EventStructure}>>. "
"<<EventHero{Твій герой/Твоя героїня}>> помічає неглибокі колії в гарячому болоті, що ведуть до входу. {EventHero.FirstName} "
"заходить усередину."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_724@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr ""
"Разом зі своїм військом ви маршуєте крізь <<EventStructure{захопливу/захопливе}>> <<acc:c:{EventStructure}>>. Ти помічаєш "
"неглибокі колії в гарячому ґрунті, що ведуть до входу, після чого заходиш усередину."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_724@BODY_LORE"
msgstr ""
"Всередині пахне кислотою. Великі фрески зображують, як стійкий {GLOBAL.GiantsLoreConcept.Hyperlink} приборкав бегемотiв з "
"{GLOBAL.UrwildernessLoreConcept.Hyperlink}. На фресках зображено одного надзвичайно безжального {EnemyUnit} та його остаточне "
"скуття [hyperlink,GLOBAL.ArchonsLoreConcept]Архонтами[/hyperlink]. {EventHero.FirstName} незабаром дізнається жахливу правду: цей "
"{EventStructure} містить той самий {EnemyUnit}! Що ще гірше, <<o:EnemyUnit>> Змієпоклонники зламали <<o:EnemyUnit>> ланцюги, а "
"тепер намагаються їх роз'їсти <<o:EnemyUnit>> Нашийник Архонта!"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_724@BODY_LORE@HERO_IS_PLAYERLE"
msgstr ""
"Всередині пахне кислотою. Великі фрески зображують, як стійкий {GLOBAL.GiantsLoreConcept.Hyperlink} приборкав бегемотiв з "
"{GLOBAL.UrwildernessLoreConcept.Hyperlink}. На фресках зображено одного надзвичайно безжального {EnemyUnit} та його остаточне "
"скуття [hyperlink,GLOBAL.ArchonsLoreConcept]Архонтами[/hyperlink]. Невдовзі ви дізнаєтеся жахливу правду: цей {EventStructure} "
"містить той самий {EnemyUnit}! Що ще гірше, <<o:EnemyUnit>> Змієпоклонники зламали <<o:EnemyUnit>> ланцюги, а тепер намагаються їх "
"роз'їсти <<o:EnemyUnit>> Нашийник Архонта!"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_724@BUTTON_0"
msgstr "Атакуй, щоб відсікти <<EnemyUnit{йому/їй}>> голову!"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_724@BUTTON_1"
msgstr "Знешкодити руки кари, використовуючи прості закляття. [mana/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_724@BUTTON_2"
msgstr "Посиль оборону архонтів, щоб уповільнити втечу <<gen:{EnemyUnit}>>."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_724@BUTTON_3"
msgstr "Відступити з цього первісного гнізда мий."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_724@BUTTON_4"
msgstr "Напустіть їх одне на одного!"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_724@BUTTON_5"
msgstr "Використай протиотруту [food/] з міста {EventCity}, щоб захиститися від отрути вив."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_724@TITLE"
msgstr "Вовчі війни"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_725@BODY_FOOTER"
msgstr ""
"Незабаром залишки корозійних парів розтопляться всередині {EventStructure}. Що потрібно зробити {EventHero}, поки не стало надто "
"пізно?"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_725@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Незабаром залишки корозійних парів розтануть у {EventStructure}. Що ви приймете, поки не пізно?"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_725@BODY_HEADER"
msgstr "По коліна в отруті та кислоті, ваші переможні воїни оточені мертвими Зміями. І один убитий {EnemyUnit}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_725@BODY_LORE"
msgstr ""
"Збентежений {EventUnit} прагне непомітно вислизнути. {EventHero.FirstName} мало звертає уваги на <<P:EventUnit>>, натомість "
"оглядаючи вже розкладаюче тіло Василіска. <<Cp:EventHero>> висмикує один з <<G:fangs^p,EnemyUnit>> і вважає, що він підходить для "
"{EventItem}. Тільки тоді <<p:EventHero>> знайдіть яйце василіска. Воно хитається та тріскається. Нащадок василіска може бути "
"виведений для боротьби за вас!"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_725@BODY_LORE@HERO_IS_PLAYERLE"
msgstr ""
"Збентежений {EventUnit} прагне непомітно вислизнути. Ви мало звертаєте уваги на <<P:EventUnit>>, замість цього оглядаючи вже "
"розкладається труп Василіска. Ви висмикуєте один з <<G:fangs^p,EnemyUnit>> і оцініть, що воно виходить за {EventItem}. Тільки тоді "
"ви знайдете яйце василіска. Воно хитається та тріскається. Потомство василіска може бути виведене для боротьби за вас!"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_725@BUTTON_0"
msgstr "Зібрати вушка й ікла впалих виверн. [unitprod/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_725@BUTTON_1"
msgstr "Захопіть {EventUnit} [unit/], перш ніж він відповзе геть."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_725@BUTTON_2"
msgstr "Створити новий {EventUnitB} [unit/] з <<G:corpse^n,EnemyUnit>>."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_725@BUTTON_3"
msgstr "Навчися використовувати яд <<gen:c:m:{EnemyUnit}>> [knowledge/] у бою."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_725@GUARANTEED_REWARD_PRISONER"
msgstr "Ти отримуєш доступ до вивільнення первісного гніву, завдяки чому здобуваєш <<acc:c:{unit}>>."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_725@TITLE"
msgstr "Вовчі війни: наслідки"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_736@BODY_FOOTER"
msgstr ""
"Чи бажаєш підтримати нашу місію? {GLOBAL.EternalSagesLoreConcept.Hyperlink} хочуть співпрацювати з тобою в обмін на таємниці, що "
"зберігаються у скарбницях міста {EventHouse}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_736@BODY_HEADER"
msgstr ""
"Плаваюча формація кам'яних облич звертається до вас: «Вітаємо вас». Монотонний голос {EventHouseLord.FirstName} з "
"{GLOBAL.CrystalDwellingConcept.Hyperlink} з {EventHouse.Name} резонує у вашому черепі."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_736@BODY_LORE"
msgstr ""
"Істота з кам’яними обличчями продовжує: не бійтеся нас, будь ласка, бо ми не маємо до вас злих намірів. Колись ми мали амбіції, "
"подібні до ваших, коли володарювали великою [hyperlink,GLOBAL.MyrridaLoreConcept]Міррідою[/hyperlink]. Але тепер ми ще могутніші. "
"Ми — {GLOBAL.EternalSagesLoreConcept.Hyperlink}. Спостерігаємо. Ведемо хроніки. Записуємо всі знання, що надходять до нас із "
"космосу. Обличчя формації не виражають жодних емоцій, але в тоні голосу істоти відчувається надія."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_736@BUTTON_0"
msgstr "Досліди <<acc:{GLOBAL.EternalSagesLoreConcept.Name}>> з міста {EventHouse}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_736@BUTTON_1"
msgstr "«Залишу я вас самих в пошуках нових знань.»"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_736@BUTTON_2"
msgstr "Дізнайся більше про завдання, які мають для тебе {GLOBAL.EternalSagesLoreConcept.Name}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_736@TITLE"
msgstr "{EventHouse} (осілий) зустріч"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_737@BODY_FOOTER"
msgstr ""
"«Ми, {GLOBAL.EternalSagesLoreConcept.Name}, винагородимо вашу допомогу», — підсумовує {EventHouseLord}. «Ви навічно запрошені до "
"нашого {GLOBAL.CrystalDwellingConcept.Hyperlink} для обміну знаннями та секретами»."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_737@BODY_HEADER"
msgstr ""
"Плаваюча формація кам'яних облич звертається до вас: «{EventHouse} вітає вас, <<PlayerLeader{brother/sister}>>. Я "
"{EventHouseLord.FirstName}.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_737@BODY_LORE"
msgstr ""
"«Нас об’єднує давня родина, хоча наші шляхи розійшлися еони тому». Ви чули про [hyperlink,GLOBAL.GiantKingLoreConcept]Стародавніх "
"Велетнів[/hyperlink], які перетворювали себе на кристали, щоб зберегти не лише себе, а й свої знання. «Ми, вчені космосу, гостро "
"відзначаємо твою мобільність, Велетне. Не через заздрість. А з корисності. Як і наша {EventHouseRace}, наша мудрість може привести "
"тебе до ерудиції». Голос кам’янолицьої сутності монотонний, проте не позбавлений надії."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_737@BUTTON_0"
msgstr "Дослідити кристалічне поселення {EventHouse}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_737@BUTTON_1"
msgstr "Прощавайте. Можливо, колись іншим разом поділитеся зі мною таємницями Мірриди."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_737@BUTTON_2"
msgstr "Запропонуйте допомогу {GLOBAL.EternalSagesLoreConcept.Name} у пошуках знань."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_737@TITLE"
msgstr "{EventHouse} (вічні) зустріч"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_740@BODY_FOOTER"
msgstr ""
"{EventStackLeader} та група {EventHouseRace} — це дослідники, відправлені {GLOBAL.CrystalDwellingConcept.Hyperlink}. Як діятиме "
"{EventHero.FirstName}?"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_740@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr ""
"{EventStackLeader} та група {EventHouseRace} — це дослідники, відправлені {GLOBAL.CrystalDwellingConcept.Hyperlink}. Як ви будете "
"діяти далі?"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_740@BODY_HEADER"
msgstr ""
"Ваші війська виявляють групу воїнів з {EventHouse}, які мовчки дивляться на {EventStructure}. {EventStackLeader} помічає тебе."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_740@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr ""
"Ваші війська виявляють групу воїнів з {EventHouse}, які мовчки дивляться на {EventStructure}. {EventStackLeader} повідомлення "
"{EventHero}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_740@BODY_HEADER@NO_HERO_IN_STACK"
msgstr ""
"Ваші війська виявляють групу воїнів з {EventHouse}, які мовчки дивляться на {EventStructure}. {EventStackLeader} помічає вашу "
"армію."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_740@BODY_LORE"
msgstr ""
"Хоча <<EventStackLeader{його/її}>> війська продовжують спостерігати за {EventStructure}, подібними до статуй, {EventStackLeader} "
"повертається обличчям до {EventHero.FirstName}. <<EventStackLeader{Він/Вона}>> передає завчену промову: «Цю територію досліджують "
"{GLOBAL.EternalSagesLoreConcept.Hyperlink}. Наша місія — записати незібрані знання. Будь ласка, залиште нас займатися нашими "
"справами». {EventStackLeader} зауважує {EventHero.FirstName}, але <<EventStackLeader{його/її}>> погляд порожній, ніби "
"прислухається до чогось — або когось — далекого."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_740@BODY_LORE@HERO_IS_PLAYERLE"
msgstr ""
"Хоча <<EventStackLeader{його/її}>> війська продовжують спостерігати за {EventStructure}, ніби статуями, {EventStackLeader} "
"повертається до вас обличчям. <<EventStackLeader{Він/Вона}>> передає завчену промову: «Цю територію досліджують "
"{GLOBAL.EternalSagesLoreConcept.Hyperlink}. Наша місія — записати незібрані знання. Будь ласка, залиште нас займатися нашими "
"справами». {EventStackLeader} спостерігає за вами, але <<EventStackLeader{його/її}>> погляд порожній, ніби прислухається до чогось "
"— або когось — далекого."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_740@BODY_LORE@NO_HERO_IN_STACK"
msgstr ""
"Хоча <<EventStackLeader{його/її}>> війська продовжують спостерігати за {EventStructure}, подібними до статуй, {EventStackLeader} "
"повертається обличчям до ваших воїнів. <<EventStackLeader{Він/Вона}>> передає завчену промову: «Цю територію досліджують "
"{GLOBAL.EternalSagesLoreConcept.Hyperlink}. Наша місія — записати незібрані знання. Будь ласка, залиште нас займатися нашими "
"справами». {EventStackLeader} спостерігає за вашою армією, але <<EventStackLeader{його/її}>> погляд порожній, ніби прислухається "
"до чогось — або когось — далекого."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_740@BUTTON_0"
msgstr "Допоможіть {EventStackLeader} пройти опитування [knowledge/] про {EventStructure}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_740@BUTTON_1"
msgstr ""
"\"Забудьте про це {EventStructure}. Доставте мій {EventItem} [item/] до {GLOBAL.EternalSagesLoreConcept.Name} для експертизи.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_740@BUTTON_2"
msgstr "Подаруй магічні кристали [mana/] місту {EventHouse}, щоб {EventHouseRace} покинули це місце."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_740@BUTTON_3"
msgstr "Змусьте воїнів, наповнених кристалами, покинути {EventStructure}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_740@BUTTON_4"
msgstr "Атакуйте нерухомих слуг {GLOBAL.EternalSagesLoreConcept.Name}!"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_740@BUTTON_5"
msgstr "Залиште {EventStructure} воїнам {GLOBAL.EternalSagesLoreConcept.Name}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_740@TITLE"
msgstr "Вічні дослідники"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_764@BODY_FOOTER"
msgstr ""
"Оскільки ми не можемо покинути місто {EventHouse}, ми цінуємо вашу здатність здобувати те, чого самі не в силі досягти, — "
"стверджують {GLOBAL.EternalSagesLoreConcept.Hyperlink}. Просимо вас допомогти нам у пошуках знань."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_764@BODY_HEADER"
msgstr "{GLOBAL.EternalSagesLoreConcept.Hyperlink} зв’язуються з тобою зі своєї кришталевої бібліотеки в місті {EventHouse}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_764@BODY_LORE"
msgstr ""
"Вітаю, {PlayerLeader.TitleName}! — звертається до тебе {EventHouseLord}. Минуло трохи часу відтоді, як ми востаннє спілкувалися. "
"Як знаєш, ми досліджуємо краї в пошуках мудрості. Намагаємось хронікувати й оберігати всі знання, якими володіє космос. Ми "
"припускаємо, що ти зацікавлен<<PlayerLeader{y/a}>> у підтримці нашої справи. Звісно, ми винагородимо тебе за твої зусилля."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_764@BUTTON_2"
msgstr "Відкинь пропозицію, представлену <<acc:{GLOBAL.EternalSagesLoreConcept.Name}>>."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_764@TITLE"
msgstr "Зваба до вічного забуття"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_765@BODY_FOOTER"
msgstr ""
"Анімовані воїни з глини тренують свою зброю на {EventHero.FirstName}, зобов'язані захищати свого творця: нищівного {EnemyUnit}! "
"Захистіть себе!"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_765@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr ""
"Анімовані воїни з глини націлюють свою зброю на тебе, зобов'язані захищати свого творця: того, хто молочить {EnemyUnit}! "
"Захистяйся!"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_765@BODY_HEADER"
msgstr ""
"Серед величезного лавового басейну {EventHero} виявляє надзвичайно високий {EventStructure}. Невеликі ворота пропонують шлях "
"всередину."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_765@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr ""
"Серед величезного лавового басейну ви виявите надзвичайно високий {EventStructure}. Невеликі ворота пропонують шлях всередину."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_765@BODY_LORE"
msgstr ""
"Ваша армія входить у склепінчастий двір, прикрашений глиняними статуями, немов нерухомі тюремні охоронці, де {EventHero.FirstName} "
"виявляє {EnemyUnit}, що летить високо над ними! <<Co:EnemyUnit>> властиве тепло розплавило ланцюг Архонтів, який виснажив "
"<<o:EnemyUnit>> сила. Бадьоре полум'я падає з <<G:wings^p,EnemyUnit>>, що пасуться об теракотові статуї воїнів, розпалюючи життя у "
"скульптурних охоронцях!"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_765@BODY_LORE@HERO_IS_PLAYERLE"
msgstr ""
"Ваше військо входить у склепінчастий двір, прикрашений глиняними статуями, немов нерухомі тюремні охоронці, де ви виявляєте "
"{EnemyUnit}, що летить високо над вами! <<Co:EnemyUnit>> властиве тепло розплавило ланцюг Архонтів, який виснажив <<o:EnemyUnit>> "
"сила. Бадьоре полум'я падає з <<G:wings^p,EnemyUnit>>, що пасуться об теракотові статуї воїнів, розпалюючи життя у скульптурних "
"охоронцях!"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_765@BUTTON_0"
msgstr "До атаки! Тягни її та її глиняних охоронців!"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_765@BUTTON_1"
msgstr "Нівелюй [mana/] здатність воскресіння глиняних вояків."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_765@BUTTON_2"
msgstr "Використовуючи крижані вітри, змусь глину, з якої зліплені солдати, потріскатися."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_765@BUTTON_3"
msgstr "Ескейпуйте {EventStructure} та поверніть значення наступного разу."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_765@BUTTON_4"
msgstr "Засліпи {EnemyUnit} яскравою кулею блискавки."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_765@BUTTON_5"
msgstr "Відправ [unitprod/] додаткову броню до міста {EventCity} для кращого захисту загонів."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_765@BUTTON_6"
msgstr "Скористайся лавою з навколишніх озер і підпали глину, з якої зліплені воїни!"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_765@TITLE"
msgstr "Дотик променя"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_766@BODY_FOOTER"
msgstr "Перш ніж {EventStructure} обвалиться в басейн лави, що {EventHero} спробує врятувати?"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_766@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Перш ніж {EventStructure} обвалиться в калюжу лави, що ви намагаєтеся врятувати?"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_766@BODY_HEADER"
msgstr "Ваша армія стоїть переможцем над уламками розкришених глиняних воїнів та велетенською оболонкою {EnemyUnit}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_766@BODY_LORE"
msgstr ""
"Метелик упав на ланцюг Архонтів, який висмоктував життя з {EnemyUnit} протягом стількох століть. Несподівано енергетична дуга "
"повертається з ланцюга назад у {EnemyUnit}, який знову відроджується, як і дві глиняні статуї {EventUnit} та {EventUnitB}, що "
"залишилися. Відроджений {EnemyUnit} підкоряється вам. Однак, щоб він покинув {EventStructure}, структуру потрібно зруйнувати."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_766@BUTTON_0"
msgstr "Забери глиняні фрагменти [structureprod/] повалених посґв до міста {EventCity}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_766@BUTTON_1"
msgstr "Збери зброю [unitprod/], що її носять глиняні воїни для міста {PlayerCapital}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_766@BUTTON_2"
msgstr "Досліди життєдайні ефекти аромола, щоб покращити [unitHero/] героя: {EventHero.FirstName}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_766@BUTTON_2@HERO_IS_PLAYERLE"
msgstr "Досліди життєдайні ефекти аромола, щоб удосконалити [unitHero/] себе."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_766@TITLE"
msgstr "Дотик полум’я: наслідки"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_780@BODY_FOOTER"
msgstr "Чи зможете ви очистити {EventSpawner}, щоб отримати {EventArtifact} для Кришталевого Оселі?"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_780@BODY_HEADER"
msgstr "{GLOBAL.EternalSagesLoreConcept.Hyperlink} підходить до тебе з пропозицією."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_780@BODY_LORE"
msgstr ""
"«Ми виявили місцезнаходження реліквії, яку давно вважали загубленою. {EventArtifact} знаходиться в {EventSpawner} {EventDirection} "
"{EventCity}», — кажуть вони вам монотонним голосом. «Ми хочемо вивчити {EventArtifact} та зберігати його в наших величезних "
"кристалічних бібліотеках. Однак {EventSpawner} не без захисників, що ускладнює повернення {EventArtifact}»."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_780@BUTTON_0"
msgstr "\"Я поверну цю реліквію у {EventSpawner}.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_780@TITLE"
msgstr "Повернення {EventArtifact}"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_781@BODY_FOOTER"
msgstr "{GLOBAL.EternalSagesLoreConcept.Hyperlink} прагнуть вивчити {EventArtifact}. Чи дотримаєте ви свого слова та повернете його?"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_781@BODY_HEADER"
msgstr "Ви відновили {EventArtifact} з {EventSpawner}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_781@BODY_LORE"
msgstr ""
"{GLOBAL.EternalSagesLoreConcept.Name} вже помітили ваш успіх і спілкуються з вами здалеку. «Ви добре впоралися, "
"{PlayerLeader.Title}», — монотонно звертається до вас їхній посланець. «Ми можемо нарешті розкрити таємниці, які приховує "
"{EventArtifact}»."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_781@BUTTON_0"
msgstr "Віддайте {EventArtifact} {GLOBAL.EternalSagesLoreConcept.Name}. [allegiance/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_781@BUTTON_1"
msgstr "Залиште {EventArtifact} собі, розгнівавши {GLOBAL.EternalSagesLoreConcept.Name}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_781@TITLE"
msgstr "Повернення {EventArtifact}: Наслідки"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_798@BODY_FOOTER"
msgstr ""
"\"Ви можете захопити {EventStackLeader}, після збиття <<P:EventStackLeader>> у {EventSpawner}, використовуючи цю літоритову "
"капсулу. Це увічнить <<p:EventStackLeader>> всередині.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_798@BODY_HEADER"
msgstr "{GLOBAL.EternalSagesLoreConcept.Hyperlink} підходить до тебе з пробіркою."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_798@BODY_LORE"
msgstr ""
"«Ми зацікавлені у вивченні та збереженні різних істот, що населяють ці царства», – заявляють вони. «Одна з істот, якої бракує в "
"нашій колекції, – це {EventStackLeader}. Нещодавно ми виявили <<G:nest^n,EventStackLeader>> поблизу: a {EventSpawner} "
"{EventDirection} {EventCity}.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_798@BUTTON_0"
msgstr "«Я повернуся із захопленим {EventStackLeader}.»"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_798@TITLE"
msgstr "Захоплюючи <<m:EventStackLeader>>"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_799@BODY_FOOTER"
msgstr ""
"{GLOBAL.EternalSagesLoreConcept.Hyperlink} прагнуть отримати {EventStackLeader}. Чи виконаєте ви свій квест і передасте "
"<<P:EventStackLeader>> до них?"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_799@BODY_HEADER"
msgstr "{EventStackLeader} успішно інкапсульовано у великому кристалі літориту. {EventSpawner} демонтовано."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_799@BODY_LORE"
msgstr ""
"{GLOBAL.EternalSagesLoreConcept.Name} вже помітили ваш успіх і спілкуються з вами здалеку. «Ви добре впоралися, "
"{PlayerLeader.Title}», — монотонно звертається до вас їхній посланець. «Ми можемо нарешті вивчити {EventStackLeader} та "
"<<o:EventStackLeader>> поведінка на всю вічність.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_799@BUTTON_0"
msgstr "Запропонуйте {EventStackLeader} на вірність {GLOBAL.EternalSagesLoreConcept.Name}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_799@BUTTON_1"
msgstr "Приборкайте {EventStackLeader} для себе [unit/], розгнівавши {GLOBAL.EternalSagesLoreConcept.Name}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_799@TITLE"
msgstr "Захоплюючи <<m:EventStackLeader>>: Наслідки"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_821@BODY_FOOTER"
msgstr ""
"Чи викуєте ви {EventArtifact} для Кришталевої Оселі, щоб вони могли її вивчити? Ви отримаєте унікальний "
"[hyperlink,GLOBAL.ItemForgeConcept]креслення[/hyperlink]."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_821@BODY_FOOTER@FORGE_ITEM_VAR1"
msgstr ""
"Чи перекуватимете ви {EventArtifact} для Кришталевої Житла, щоб вони могли її вивчити? Ви отримаєте унікальний "
"[hyperlink,GLOBAL.ItemForgeConcept]креслення[/hyperlink]."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_821@BODY_HEADER"
msgstr "{GLOBAL.EternalSagesLoreConcept.Hyperlink} підходять до тебе з проханням."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_821@BODY_LORE"
msgstr ""
"«Ми давно розмірковували про силу гіпотетичної зброї. Такої собі {EventArtifact}, якщо хочете», — пояснюють вони глухим голосом. "
"«Якщо ця {EventArtifact} з'явиться на світ, ми хочемо зберегти та вивчити її. Ми вважаємо, що ви володієте "
"{GLOBAL.ItemForgeConcept.Hyperlink}. Ми можемо надати вам інструкції з кування, якщо ви погодитесь»."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_821@BODY_LORE@FORGE_ITEM_VAR1"
msgstr ""
"«Ми довго зберігали фрагменти {EventArtifact}, реліквії з давно втраченої епохи. Її сила оповідана в легендах». Незважаючи на "
"їхній монотонний голос, у словах {GLOBAL.EternalSagesLoreConcept.Name} відчувається натяк на збентеження. «На жаль, ми не змогли "
"самостійно полагодити предмет. Ми розуміємо, що ви керуєте {GLOBAL.ItemForgeConcept.Hyperlink}. Чи змогли б ви перекувати "
"{EventArtifact}?»"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_821@BUTTON_0"
msgstr "«Я підроблю для тебе {EventArtifact}»."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_821@TITLE"
msgstr "Кування {EventArtifact}"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_822@BODY_FOOTER"
msgstr "{GLOBAL.EternalSagesLoreConcept.Hyperlink} прагнуть вивчити наслідки {EventArtifact}. Чи ви передасте це?"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_822@BODY_HEADER"
msgstr "Ви створили {EventArtifact} у своїй Кузні Предметів."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_822@BODY_LORE"
msgstr ""
"{GLOBAL.EternalSagesLoreConcept.Name} відчули ваш успіх і знову звернулися до вас. «Ви добре впоралися, {PlayerLeader.Title}», — "
"монотонно звертається до вас їхній посланець. «Нам цікаво дізнатися про {EventArtifact} та його потенціал»."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_822@BUTTON_0"
msgstr "Віддайте {EventArtifact} {GLOBAL.EternalSagesLoreConcept.Name}. [allegiance/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_822@BUTTON_1"
msgstr "Залиште {EventArtifact} собі, розгнівавши {GLOBAL.EternalSagesLoreConcept.Name}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_822@TITLE"
msgstr "Кування {EventArtifact}: Наслідки"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_880@BODY_FOOTER"
msgstr ""
"Чи приймеш ти запрошення Вічних Мудреців стати Медіумом для їхнього ритуалу спілкування з іншими <<m:"
"{GLOBAL.CrystalDwellingConcept.Hyperlink}>>?"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_880@BODY_HEADER"
msgstr ""
"Це стало звичним видовищем: офіційне вітання {GLOBAL.EternalSagesLoreConcept.Hyperlink} у їхній кристалічній бібліотеці в "
"{EventHouse}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_880@BODY_LORE"
msgstr ""
"{EventHouseLord} пояснює монотонним голосом: «Ви виявилися цінним союзником у нашій справі, {PlayerLeader.TitleName}. Залишилася "
"ще одна послуга. Ми прагнемо зв’язатися з нашими розсіяними родичами по всьому {GLOBAL.AstralSeaLoreConcept.Hyperlink}. Щоб "
"поспілкуватися та обмінятися нашими об’єднаними знаннями з усіх царств і світів. Ритуал вимагає від людини дії як Медіума. Людини "
"зі здібностями {GLOBAL.GodirLoreConcept.Hyperlink}»."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_880@BUTTON_0"
msgstr "Погодься виконати роль медіума. Вікувічні Мудреці будуть вдячні й проведуть свій ритуал."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_880@BUTTON_1"
msgstr "Вдай, що погоджуєшся [evilact/] із наміром зірвати ритуал конклаву."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_880@BUTTON_2"
msgstr "Ввічливо відмов. Натомість попроси про приватний контакт із осередком [knowledge/]."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_880@TITLE"
msgstr "Спілкування серед кристалів"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_881@BODY_FOOTER"
msgstr ""
"Це Космічний Конклав, який {EventHouse} проявив, з вами в його центрі. Всезнаюча сила з усього "
"{GLOBAL.AstralSeaLoreConcept.Hyperlink} пронизує ваше безсмертне тіло."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_881@BODY_FOOTER@PLAYER_NOT_MEDIU"
msgstr "Космічний Конклав змушує цей світ наповнюватися всезнаючою силою з усього {GLOBAL.AstralSeaLoreConcept.Hyperlink}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_881@BODY_HEADER"
msgstr "Небосхил раптово освітився новими зірками, а потому з-під землі пролунав гул. Повітря набуло присмаку темряви."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_881@BODY_LORE"
msgstr ""
"Астральні зв'язки встановлюються між <<m:{GLOBAL.CrystalDwellingConcept.Hyperlink}>> в інших сферах, з'являючись у формі "
"таємничого виру. Патоки фіолетової енергії виникають між зірками, тягнучись до з'єднання з Медіумом. Відразу всі патоки торкнулися "
"{EventHouse}, змушуючи енергію вистрілювати назад у космос. Виплески незабаром досягають рівноваги. Зв'язки стабілізуються. "
"Космічний Конклав, спілкування серед {GLOBAL.EternalSagesLoreConcept.Hyperlink}, розпочався."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_881@BUTTON_0"
msgstr "Таємниці космосу — на відстані простягнутої руки."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_881@BUTTON_2"
msgstr "Ми можемо багато чого зрозуміти з такого оманливого знаку."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_881@TITLE"
msgstr "Космічний конклав"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_882@BODY_FOOTER"
msgstr ""
"Після космічної кульмінації твоєї співпраці з містом {EventHouse} ти святкуєш наукові досягнення, які є паливом для твоїх "
"особистих амбіцій."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_882@BODY_FOOTER@PLAYER_NOT_MEDIU"
msgstr "Космічне конклав дуже сприяло твоїм дослідженням. Ще невідомо, скільки від цього здобули твої суперники."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_882@BODY_HEADER"
msgstr ""
"Космічний Конклав завершився. {GLOBAL.CrystalDwellingConcept.Hyperlink} успішно поспілкувалися зі своїми родичами по всьому "
"космосу."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_882@BODY_LORE"
msgstr ""
"Ясність розуму, що дозволяє тобі по-новому сприймати світ і його приховані таємниці, — приголомшлива. Ти відчуваєш, ніби твій "
"розум раптово огорнула вата. Втім, хоча стан загостреного сприйняття минає, залишаються плоди цієї Епохи Пізнання. "
"{GLOBAL.EternalSagesLoreConcept.Hyperlink} повертаються задоволені до кришталевих твердинь, щоб продовжити там свої вічні "
"дослідження."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_882@BUTTON_0"
msgstr "Тепер я вже знаю, скільки ще лишилося вивчити."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_882@TITLE"
msgstr "Космічний конклав: наслідки"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_883@BODY_FOOTER"
msgstr ""
"Виявивши вашу зраду, {EventHouseLord.TitleName} з {EventHouse} зв'язується з вами. «Ви заплатите за це наругу!», "
"<<p:EventHouseLord>> бум. Але у вас вже є свій приз."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_883@BODY_HEADER"
msgstr "Небосхил раптово осяюється новими зірками, а згодом із землі долинає гудіння. Повітря набуває присмаку чорноти."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_883@BODY_LORE"
msgstr ""
"Астральні зв'язки встановлюються між <<m:{GLOBAL.CrystalDwellingConcept.Hyperlink}>> в інших сферах, з'являючись у формі "
"таємничого виру. Патча фіолетової енергії виникають між зірками, тягнучись до Медіума: вас. Але вони ніколи не знаходять своєї "
"мети. Ваші маги ініціюють контрритуал, змушуючи патча сплутуватися та неминуче вдаряти в {EventHouse}, як блискавки. Його вічні "
"структури руйнуються; його захисники розпадаються."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_883@BUTTON_0"
msgstr "Я маю владу над знанням. [knowledge/] Я <<PlayerLeader{матиму/матиму}>> владу також і над вами."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_883@TITLE"
msgstr "Вічна підступність"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_905@BODY_FOOTER"
msgstr "Як би ви підсумували свої амбіції щодо {EventUnit}?"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_905@BODY_HEADER"
msgstr "{EventUnit}, <<EventUnit{будучи одним/будучи однією}>> з твоїх піших підданих, запитує про твої плани на майбутнє."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_905@BODY_LORE"
msgstr ""
"«Мій {PlayerLeader.Title}, ти походиш з роду [hyperlink,GLOBAL.GiantKingLoreConcept]могутніх королів[/hyperlink] та вражаючих "
"воїнів. Твої предки колись визначали рельєф місцевості, течію річок та течію гір. Як спадкоємець могутності "
"{GLOBAL.MyrridaLoreConcept.Hyperlink}, твій {EventRace} цікавиться... які у тебе плани щодо цього королівства?»"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_905@BUTTON_0"
msgstr "Поверни Мірриді [influence/] її давню могутність."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_905@BUTTON_1"
msgstr "Зміни форму земель [structureprod/] на ту, що тобі до вподоби."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_905@BUTTON_2"
msgstr "Захищай [goodact/] слабших за себе."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_905@BUTTON_3"
msgstr "Куй [bindingessence/] могутні предмети, що матимуть силу формувати долю цих земель."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_905@BUTTON_4"
msgstr "Призви могутні бурі, так, як це робили еони тому твої предки. [mana/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_905@BUTTON_5"
msgstr "Заклич моря лави, так само як це зробили еони тому твої пращури. [mana/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_905@BUTTON_6"
msgstr "Укрий континенти снігом, так, як зробили це еони тому твої предки. [mana/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_905@BUTTON_7"
msgstr "Розпочни вічні ігри, як це зробили еони тому твої предки. [mana/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_905@TITLE"
msgstr "Олбримські амбіції"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_906@BODY_FOOTER"
msgstr ""
"<<EventRace{Твій/Твої}>> {EventRace} покладаються на тебе, щоб розкрити свій повний потенціал. Який шлях ти хочеш визначити для "
"своїх підданих?"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_906@BODY_HEADER"
msgstr "У твоєму розпорядженні є сила перетворювати землі. Прийшов час надати обрану форму своїм <<ins:{EventRace}>>."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_906@BODY_LORE"
msgstr ""
"Навіть [hyperlink,GLOBAL.GiantKingLoreConcept]Королі-велетні[/hyperlink] минулого не могли правити королівствами без допомоги "
"своїх послідовників. Злі язики стверджують, що вони були відомі тим, що експериментували над своїми нижчими підданими. У будь-"
"якому разі, ви покладаєтеся на своїх Хастфолків, щоб підтримувати контроль над своїми володіннями. Ваш обов'язок і "
"відповідальність — розвивати свій {EventRace}. Вони прагнуть вашої допомоги."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_906@BUTTON_0"
msgstr "Єдине, чого я прагну, — це вберегти вас від будь-якої шкоди."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_906@BUTTON_1"
msgstr "Своєю поставою й могуттю ви зрівняєтесь із велетами минулих часів."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_906@BUTTON_2"
msgstr "Віддам вам трохи своєї сили штормових велетнів."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_906@BUTTON_3"
msgstr "Віддам вам трохи своєї сили вогняних о́лбримів."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_906@BUTTON_4"
msgstr "Віддам вам трохи своєї сили крижаних о́лбримів."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_906@BUTTON_5"
msgstr "Віддам вам трохи своєї сили скелястих о́лбримів."

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_906@BUTTON_6"
msgstr "Ви вже змогли досягти досконалості. [happiness/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1167_906@TITLE"
msgstr "Формуючий розвиток"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1367@BODY_FOOTER"
msgstr ""
"До зали заходять літоринові вартові, а крізь усю будівлю проходять хвилі таємничих сил. Прислухаючись до шепоту енергії, що живить "
"істоту, {EventHero.FirstName} помічає їхній погляд, спрямований на себе."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1367@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr ""
"До зали заходять літоринові вартові, а крізь усю будівлю проходять хвилі таємничих сил. Прислухаючись до шуму енергії, що живить "
"істот, ти помічаєш їхні погляди, спрямовані на тебе."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1367@BODY_HEADER"
msgstr ""
"Величний {EventStructure} височіє перед {EventHero.TitleName}, ім'я зображеного {GLOBAL.GiantKingLoreConcept.Hyperlink} забуте в "
"часі."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1367@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Величний {EventStructure} височіє перед вами, ім'я зображеного {GLOBAL.GiantKingLoreConcept.Hyperlink} забуте в часі."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1367@BODY_LORE"
msgstr ""
"Під масивним троном {EventHero.FirstName} входить до великої зали, <<o:EventHero>> рух луною лунає будівлею. Тут немає життя. Ні "
"павутиння, ні паразитів, ні навіть пилу в коридорах. І все ж, доглядача немає... Доки {EventHero.FirstName} не відчуває знайомого "
"поколювання <<o:EventHero>> хребет — сплеск таємничої енергії."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1367@BODY_LORE@HERO_IS_PLAYERLE"
msgstr ""
"Під троном ти знаходиш вхід до зали такої великої, що твої кроки луною віддаються по всій будівлі. Жодного сліду життя. У залі не "
"видно ані павутини, ані шкідника, ані навіть пилинки. І все ж — ніде немає жодного доглядача. Аж до тієї миті, коли ти відчуваєш "
"знайомий холодок, що проходить уздовж хребта — хвиля таємничої енергії."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1367@BUTTON_0"
msgstr "Атакуйте тих бунтівних вартових!"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1367@BUTTON_1"
msgstr "Накласти захисне закляття [mana/] на свою армію."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1367@BUTTON_2"
msgstr "Використай своє таємне знання, щоб уповільнити потоки магії."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1367@BUTTON_3"
msgstr "Тікайте з {EventStructure}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1367@BUTTON_4"
msgstr "Призви́кай сили хаосу, щоб спровокувати й збити з пантелику вартових."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1367@BUTTON_5"
msgstr "Закликайте сили {EventStructure}, щоб зміцнити броню вашої армії."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1367@TITLE"
msgstr "Вартові троянд"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1368@BODY_FOOTER"
msgstr ""
"Окрім знань, що містяться всередині, {EventHero.FirstName} також натрапляє на приховані скарби, а ще — на залу з зачарованими "
"літориновими вартовими."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1368@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr ""
"Окрім знань, прихованих усередині, ти також натрапляєш на заховані скарби, а навіть на залу з одуреними літориновими вартовими."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1368@BODY_HEADER"
msgstr "Після знищення літорінських вартових {EventStructure}, {EventHero.Name} може вільно досліджувати незаймані зали."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1368@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Після знищення літорінських вартових з {EventStructure}, ви можете вільно досліджувати незаймані зали."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1368@BODY_LORE"
msgstr ""
"Завдяки тому, що вартові століттями одержимо очищали та захищали зали, все всередині було збережено. Чіткі руни, різьблення та "
"ряди книг вишикувалися вздовж стін, розповідаючи безліч історій про {GLOBAL.MyrridaLoreConcept.Hyperlink}. Є зображення Королів "
"Велетнів та їхніх заповітів з {GLOBAL.ArchonsLoreConcept.Hyperlink}, падіння Мірріди та "
"{GLOBAL.TraitorKingsLoreConcept.Hyperlink}, і навіть таємні легенди про {GLOBAL.EternalCouncilLoreConcept.Hyperlink}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1368@BUTTON_0"
msgstr "Візьми вкриту кристалами зброю. [item/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1368@BUTTON_1"
msgstr "Заберіть скарб [gold/], знайдений у {EventStructure}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1368@BUTTON_2"
msgstr "Перетягни кількох вартових на свій бік. [unit/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1368@BUTTON_3"
msgstr "Збери кристали літориту. [mana/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1368@TITLE"
msgstr "Вартові розмовляють: наслідки"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1370@BODY_FOOTER"
msgstr ""
"Їхній провідник вказує в бік, де стоїть {EventHero.FirstName}, і вигукує: О великі королі минулих часів! Даруйте нам свою відвагу, "
"щоб ми змогли винищити цих єретиків!"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1370@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr ""
"Їхній провідник вказує на тебе й вигукує: О, великі королі минулих часів! Даруйте нам свою хоробрість, щоб ми могли знищити цих "
"єретиків!"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1370@BODY_HEADER"
msgstr ""
"{EventHero.FirstName} входить у {EventStructure} і знаходить групу фігур, що поклоняються статуї стародавнього "
"{GLOBAL.GiantKingLoreConcept.Hyperlink}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1370@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr ""
"Ви входите в {EventStructure} і знаходите групу фігур, які поклоняються статуї стародавнього "
"{GLOBAL.GiantKingLoreConcept.Hyperlink}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1370@BODY_LORE"
msgstr ""
"Спочатку віряни, здається, взагалі не помічають {EventHero,FirstName}, натомість співаючи стародавньою мовою "
"{GLOBAL.MyrridaLoreConcept.Hyperlink}. Лише коли {EventHero.FirstName} підходить до статуї, їхній лідер піднімає <<o:EnemyUnit>> "
"погляд. «Ви не поклонники велетнів. Ви порушили священну землю! Ви смієте оскверняти величні сходи {EventStructure} своїми "
"солдатами?!»"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1370@BODY_LORE@HERO_IS_PLAYERLE"
msgstr ""
"Спочатку віряни, здається, взагалі вас не помічають, натомість співають стародавньою мовою {GLOBAL.MyrridaLoreConcept.Hyperlink}. "
"Лише коли ви наближаєтесь до статуї, їхній ватажок піднімає <<o:EnemyUnit>> погляд. «Ви не поклонники велетнів. Ви порушили "
"священну землю! Ви смієте оскверняти величні сходи {EventStructure} своїми солдатами?!»"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1370@BUTTON_0"
msgstr "До атаки!"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1370@BUTTON_1"
msgstr "Якщо ви так прагнете стати о́лбримами, то й ваше падіння буде не менш грандіозним! [influence/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1370@BUTTON_2"
msgstr "Ви можете отримати благословення достатку, але я можу й забрати його."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1370@BUTTON_3"
msgstr "Залиши культістів їхнім молитвам."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1370@BUTTON_4"
msgstr "Ви вшановуєте таких, як я! Схиліть голови переді мною, мої вірні!"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1370@TITLE"
msgstr "Первісна вправність"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1371@BODY_FOOTER"
msgstr "Скарб більше не охороняється культистами, тож можеш забрати його собі."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1371@BODY_HEADER"
msgstr "Після вбивства культистів {EventStructure} огортає тиша. {EventHero.FirstName} може без перешкод підійти до статуї."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1371@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr "Після вбивства культістів {EventStructure} огортає тиша. Ти можеш безперешкодно підійти до статуї."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1371@BODY_LORE"
msgstr ""
"Не грім гримить, не блискавка не вражає, не гнів божественний {EventHero.FirstName} або <<o:EventHero>> армія. Натомість "
"{EventStructure} лежить мовчки, величні зали луною відлунюють кожен крок, поки статуя височіє над армією. Біля велетенської основи "
"статуї культисти зібрали купу артефактів, щоб поклонятися та приносити в жертву своїй коханій "
"{GLOBAL.GiantKingLoreConcept.Hyperlink}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1371@BODY_LORE@HERO_IS_PLAYERLE"
msgstr ""
"Жодний грім не гримить, жодна блискавка, жодний божественний гнів не вразить вас чи вашу армію. Натомість {EventStructure} лежить "
"мовчки, величні зали луною відлунюють кожен крок, поки статуя височіє над армією. Біля велетенської основи статуї культисти "
"зібрали купу артефактів, щоб поклонятися та приносити в жертву своїй коханій {GLOBAL.GiantKingLoreConcept.Hyperlink}."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1371@BUTTON_0"
msgstr "Збери все, що має хоч якусь цінність, щоб потім це продати. [gold/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1371@BUTTON_1"
msgstr "Візьми свій ритуал ласки Колоса."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1371@BUTTON_2"
msgstr "Заявіть право власності на {EventItem}. [item/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1371@BUTTON_3"
msgstr "Забери книгу повного знання [knowledge/] про о́лбримів та їхню магію."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1371@BUTTON_4"
msgstr "Не забирай нічого. Рештки цієї цивілізації мають залишитися в спокої. [materiumboon/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1371@TITLE"
msgstr "Первісна здібність: наслідки"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1373@BODY_FOOTER"
msgstr "Велетень дивиться вгору на {EventHero.FirstName} як <<p:EventHero>> наближається. «Незвані гості! Це мій трон! Атакуйте їх!»"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1373@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Велетень дивиться на вас, коли ви наближаєтесь. «Незвані гості! Це мій трон! Атакуйте їх!»"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1373@BODY_HEADER"
msgstr ""
"Усередині навислого {EventStructure}, залишку на славу {GLOBAL.MyrridaLoreConcept.Hyperlink}, {EventHero.Name} знаходить "
"{GiantUnit} разом із групою напівгігантів."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1373@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr ""
"Усередині навислого {EventStructure}, залишку на славу {GLOBAL.MyrridaLoreConcept.Hyperlink}, ви знайдете {GiantUnit} разом із "
"групою напівгігантів."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1373@BODY_LORE"
msgstr ""
"«Віки тому [hyperlink,GLOBAL.GiantKingLoreConcept]Королі Велетнів[/hyperlink] правили всіма нижчими расами», – хвалиться Велетень "
"<<o:EnemyUnit>> Послідовники напіввелетнів. «Це справедливо, що я знову претендую на цей трон, згідно з природним порядком». "
"Запанувала збентежена тиша, і Велетень розчаровано крикнув: «Малі йдуть за великими, дурні!» Напіввелетні радіють, раді, що "
"розуміють, а Велетень зітхнув."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1373@BUTTON_0"
msgstr "Атакуйте тих повільних дурнів!"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1373@BUTTON_1"
msgstr "«Мої Драконячі рідці вже перемагали тебе раніше, Велетне! Я зроблю це знову!»"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1373@BUTTON_2"
msgstr "Збентежте напівгігантів риторикою [знанням/] про Гігантів та їхніх родичів."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1373@BUTTON_3"
msgstr "Залиште Велетня та <<o:EnemyUnit>> послідовників."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1373@BUTTON_4"
msgstr "Так само, як у легенді про юного пастуха, ми теж здатні перемагати велетнів!"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1373@BUTTON_5"
msgstr "Група вівчарів здатна подолати навіть найгрізнішу звірину!"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1373@TITLE"
msgstr "Розмір має значення"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1374@BODY_FOOTER"
msgstr "Самотній Демігігант не становить загрози для {EventHero.FirstName}. Чого ви хочете від <<P:EventUnit>>?"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1374@BODY_FOOTER@HERO_IS_PLAYERLE"
msgstr "Самотній Демігігант не становить для тебе загрози. Чого ти просиш від <<P:EventUnit>>?"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1374@BODY_HEADER"
msgstr ""
"{EventHero.FirstName} убив потенційного {GLOBAL.GiantKingLoreConcept.Hyperlink} та його послідовників. Тепер {EventStructure} ваш "
"і його можна вільно досліджувати."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1374@BODY_HEADER@HERO_IS_PLAYERLE"
msgstr ""
"Ви вбили потенційного {GLOBAL.GiantKingLoreConcept.Hyperlink} та його послідовників. Тепер {EventStructure} ваш і його можна "
"вільно досліджувати."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1374@BODY_LORE"
msgstr ""
"Поки {EventHero.FirstName} блукає коридорами, <<p:EventHero>> зустрічає самотнього {EventUnit}, який піднімає <<EventUnit{його/її}"
">> руки. «Ти розтоптав Велетня? Ти переміг. Велетень сказав мені охороняти скарб... Але мені стало нудно, тому я походжав». "
"Напіввелетень хихикає. «Ти розтоптав Велетня. Я вільний»."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1374@BODY_LORE@HERO_IS_PLAYERLE"
msgstr ""
"Блукаючи коридорами, ви зустрічаєте самотнього {EventUnit}, який піднімає <<EventUnit{його/її}>> руки. «Ти розтоптав Велетня? Ти "
"переміг. Він і так був злим. Назвав нас дурнями. Він сказав мені охороняти скарб... Але мені стало нудно, тож я походжав навколо». "
"Напіввелетень хихикає. «Тепер його розтоптали, а я вільний»."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1374@BUTTON_0"
msgstr "Звербуй <<EventUnit{полувелетня/полувелетеншу}>> до свого юніти. [unit/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1374@BUTTON_1"
msgstr "Вимагайте, щоб Демігігант провів вас до зібраних ними скарбів. [gold/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1374@BUTTON_2"
msgstr "Можеш іти вільно. [goodact/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1374@BUTTON_3"
msgstr "Убийте тих, хто здається {EventUnit}, як приклад для ваших військ. [evilact/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1374@TITLE"
msgstr "Розмір має значення: наслідки"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1476@BODY_FOOTER@NO_AI_LORDS"
msgstr ""
"{EventUnit} підвищує <<EventUnit{його/її}>> руки та стогне в екстазі. «Ви благословенні "
"[hyperlink,GLOBAL.TraitorKingsLoreConcept]Кьйорное[/hyperlink]! Ми будемо поклонятися вам, як ми поклонялися їм!»"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1476@BODY_LORE@NO_AI_LORDS"
msgstr ""
"\"Я є <<EventUnit{Son/Daughter}>> Кьорное, послідовник справжніх [hyperlink,GLOBAL.GiantKingLoreConcept]Королів-велетнів[/"
"hyperlink], яких так несправедливо оголосили «Зрадниками». Ми довго стежили за Артефактами, якими ви тепер володієте, чекаючи, "
"поки хтось втілить благословення Кьорное. Ви <<P:PlayerLeader>>! І таким чином, Сини Кйорное клянуться тобі у вірності!"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1490@BUTTON_5"
msgstr "Ведіть роздроблені душі до {ReplacedPlayerFallback}. [evilact/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1490@BUTTON_6"
msgstr "Зупини ритуал і скористайся артефактами, щоб самостійно правити культом Синів Кйрное."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1490@BUTTON_7"
msgstr ""
"Пожертвуйте своїм <<EventHero{hero/heroine}>> {EventHero.TitleName} щоб повернути Короля-Зрадника під ваше командування. [unit/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1498@BODY_FOOTER"
msgstr ""
"{PreviousPlayer.TitleName} було введено в {GLOBAL.AstralVoidLoreConcept.Hyperlink} користувачем {TriggeringPlayer}. Король-зрадник "
"{TraitorKingLord} тепер править у {ReplacedPlayerRace} в <<o:PreviousPlayer>> замість цього."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1498@BODY_HEADER"
msgstr "Твої плани зриваються через вибух темних таємничих хвиль, що розносяться краєм."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1498@BODY_LORE"
msgstr ""
"Дослідивши причину, ви виявляєте, що {TriggeringPlayer} використав {CauldronRelic}, {MirrorRelic} та {GrailRelic}, щоб пробудити "
"стародавній {GLOBAL.TraitorKingsLoreConcept.Hyperlink}. Процес викликання перетворив {PreviousPlayer} на "
"{GLOBAL.AstralVoidLoreConcept.Hyperlink} та замінив <<P:PreviousPlayer>> з {TraitorKingLord}. На жаль, ви нічого не можете зробити "
"проти цієї магії Короля-Зрадника."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1498@BUTTON_0"
msgstr "«Я навчатимуся [knowledge/] від темної магії цього Короля-Зрадника!» [evilact/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1498@BUTTON_2"
msgstr "Надішліть {ReplacedPlayerRace} трохи милостині [gold/] зі співчуття. [goact/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1498@BUTTON_3"
msgstr "Цей заборонений вчинок не може залишитися безкарним."

msgid "DLC@GIANTKINGS@STORY_EVENT@1194_1498@TITLE"
msgstr "Повернення Кірное: темне виклик"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6766@BODY_FOOTER"
msgstr "Стовпи вогню вибухають із небосхилу та стримують шалені бурі. Бар’єр, що охороняє серця, поступово розсіюється."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6766@BODY_HEADER"
msgstr ""
"Похваляючи себе з задоволенням, {EventUnit} забирає всі литоринові кристали, які тобі вдалося зібрати. Потім він підносить свої "
"трофеї:"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6766@BODY_HEADER@OGRE_DEFEATED"
msgstr "Побиті та загрожені вашою та вашими військами могутністю, {EventUnit} неохоче починає <<EventUnit{його/її}>> виклик:"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6766@BODY_LORE"
msgstr "\"Іскра, маленька руно![br/]Чуй полум'я[br/]Тріщини минули[br/]Вирізьблене ім'я:[br/]Зрив і вибух[br/]— бум!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6766@BUTTON_0"
msgstr "Приготуйся до будь-чого, що там може бути."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6766@TITLE"
msgstr "Поясний Кристалової Бурі: інвокація тріскокрони"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6768@BODY_FOOTER"
msgstr ""
"Велетні {GLOBAL.StormClanLoreConcept.Hyperlink} зв'язали {EventStackLeader} своєю волею. Вони готові обрушити його на будь-кого, "
"хто наважиться втрутитися."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6768@BODY_HEADER"
msgstr "Досягнувши центру плато, ваші війська побачать величезний {EventStackLeader}."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6768@BODY_LORE"
msgstr ""
"Відволікаючись на величезні розміри {EventStackLeader}, ваші війська за кілька хвилин помічають велетнів, зібраних навколо "
"великого менгіра, вирізьблені руни якого світяться магією. Серед велетнів панує певна метушня, ніби їх перервали під час ритуалу. "
"Побачивши знаки розрізнення {GLOBAL.StormClanLoreConcept.Hyperlink}, можна лише припустити, що розлючені "
"{GLOBAL.PROPERTIES.TSR_CRYSTAL_STORM_AUTO_SPELL.Hyperlink} — це їхня справа рук."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6768@BUTTON_0"
msgstr "Поки що відступімо."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6768@BUTTON_1"
msgstr "{GLOBAL.StormClanLoreConcept.Name} не буде для нас жодним викликом, до атаки!"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6768@TITLE"
msgstr "Поясний Кристалової Бурі: ритуал Клану Бурі"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6791@BODY_FOOTER"
msgstr ""
"Ти відчуваєш, що {EventRelic.Name} випромінює сильну магічну енергію, пов’язану з вірністю. Оточення нарешті заспокоюється, і ти "
"можеш оголосити свою перемогу."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6791@BODY_HEADER"
msgstr ""
"Ви перемогли {GLOBAL.StormClanLoreConcept.Hyperlink} та викликаного ним Літоріна. Їхній нинішній лідер, {EventUnit}, збирає "
"останні сили, щоб підняти <<EventUnit{його/її}>> голос."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6791@BODY_LORE"
msgstr ""
"\"Прокляті {GLOBAL.FireClanLoreConcept.Hyperlink} зрадники, прокляті всі мешканці Хастфолку!\"<p:EventUnit>> люто кричить. «Вони "
"нацькували тебе на нас, зняли наші чари...» Трохи-трохи {EventUnit} рухається <<EventUnit{його/її}>> величезний кулак. «Ми "
"наполягатимемо. Ми приборкали Літоріна. Влада Королів-Велетнів буде по праву нашою! Вибухне буря. Усі метушники... будуть... "
"тремтіти!» {EventUnit} видихає <<EventUnit{його/її}>> останній подих, руйнування поруч із {EventRelic.Name}."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6791@BUTTON_0"
msgstr "Збери залишки астральної енергії [mana/], перш ніж вона зникне."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6791@BUTTON_3"
msgstr "Оголосіть своє панування [influence/] над {GLOBAL.StormClanLoreConcept.Name} у всьому королівстві."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6791@BUTTON_4"
msgstr "Знайди пульсуючі відлуння бурі, щоб призвати істот [unit/] із чистої блискавки."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6791@BUTTON_5"
msgstr "Те, що можна дізнатися про магію {GLOBAL.StormClanLoreConcept.Name}, потрібно поділитися з Кришталевим Оселею. [allegiance/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6791@TITLE"
msgstr "Пояс Кришталевої Бурі: наслідки"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6922@BUTTON_6"
msgstr "«Поділіться тим, що ви дізналися про {EventBeastName}, з {GLOBAL.EternalSagesLoreConcept.Name}». [allegiance/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6989@BODY_FOOTER@ENIGMA_LOCKED"
msgstr "Ти мусиш повернутися до інших залів і розгадати їхні загадки. Тільки після цього Творець заговорить з тобою."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6989@BODY_HEADER@ENIGMA_LOCKED"
msgstr "У центральній кімнаті ваші війська знаходять {EventStackLeader}, який мовчки спостерігає за регіоном."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6989@BODY_LORE@ENIGMA_LOCKED"
msgstr ""
"Вони не наважуються наближатися до {EventStackLeader}, ніби непрохідна гора перегороджує їм шлях. Не можна вимовляти жодних слів, "
"щоб зрозуміти, що цей Творець, якому поклоняються {GLOBAL.StoneClanLoreConcept.Hyperlink}, тут не для того, щоб поговорити з вами, "
"а чекає на іншого {GLOBAL.GodirLoreConcept.Hyperlink}, зайнятого в Залі Загадок."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6989@BUTTON_0@ENIGMA_LOCKED"
msgstr "Піти."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_6989@TITLE@ENIGMA_LOCKED"
msgstr "Зала Таємниць: Створець-Спостерігач"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7003@BUTTON_6"
msgstr "Поділіться знаннями про Творця з {GLOBAL.EternalSagesLoreConcept.Name}. [allegiance/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7060@BUTTON_4"
msgstr "Заклич доброго господаря [unit/] Клану Морозу!"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7309@BODY_FOOTER"
msgstr ""
"{EventUnit} оглядає ваші війська. «Тільки тоді, коли прояви <<ge:malice^n,{EventHero.FirstName}>> були ослаблені, дух {EventHero} "
"<<r:EventHero>> може бути оскаржено та назавжди знищено.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7309@BODY_HEADER"
msgstr ""
"Твої юніти приголомшені видом покинутих руїн, що простягаються до самого горизонту. Раптом із ними встановлює контакт мерехтливий "
"у далечині дух."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7309@BODY_LORE"
msgstr ""
"«Обережно, хоробрі громадяни!» — кричить {EventUnit}, коли <<p:EventUnit>> наближається. «Бо ви входите в прокляту землю. У давні "
"часи це була власність жахливого [hyperlink,GLOBAL.TraitorKingsLoreConcept]Короля-Зрадника[/hyperlink]. Хоча {EventHero} зазнав "
"законного покарання [hyperlink,GLOBAL.ArchonsLoreConcept]мого народу[/hyperlink], <<o:EventHero>> Зламаний дух продовжує мучити "
"королівство, завдаючи ненаситного голоду звірам, черв'якам і навіть самій землі."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7309@BUTTON_0"
msgstr "Візьми до уваги те, що каже {EventUnit}, коли наказуєш своїм воїнам увійти на територію руїн."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7309@BUTTON_3"
msgstr "Попросіть {EventUnit} освятити ваші війська [statuseffectresistance/], перш ніж вони продовжать."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7309@BUTTON_4"
msgstr "Висмоктуй [mana/] [evilact/] з енергії, що випромінює {EventUnit}, щоб захистити [statuseffectresistance/] свої юніти."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7309@TITLE"
msgstr "Досліджуючи Поля Божевільні"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7315@BODY_FOOTER"
msgstr ""
"{EventStackLeader} різко хитнув головою, а потім зосередив погляд на твоїх юнітих. Яду чи жертви ви принесли, щоб покласти на мою "
"тарілку?"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7315@BODY_FOOTER@SPIRIT_WEAKENED"
msgstr "{EventHero} і ваша конфронтація мусить почекати, а тобі вдалося знайти і ослабити залишкові аспекти."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7315@BODY_HEADER"
msgstr ""
"Поглинаючи {EventStructure}, ваші війська переривають жахливий {EventStackLeader}. Як <<p:EventStackLeader>> повертається до них, "
"<<p:EventStackLeader>> говорить зловісним голосом {EventHero}."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7315@BODY_HEADER@SPIRIT_WEAKENED"
msgstr "Тобі вдалося ослабити аспект бога."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7315@BODY_LORE"
msgstr ""
"«Я приходжу до всіх, позачасове моє дихання», — каже {EventStackLeader}, оголюючи <<o:EventStackLeader>> величезні зуби. «За собою "
"я несу ненажерливу смерть. Кістки гризуть, дерева пожирають, кущі пожирають, <<m:{EventSmallAnimal}>> проковтнути, <<m:"
"{EventLargeAnimal}>> з'їдені по шматочках. Усі поглинуті в моїй ямі.\" {EventStackLeader} реве. \"Хіба я не їхній король, щоб вони "
"його годували? Щоб правити, моє первородне право; щоб насолоджуватися моєю первісною насолодою. Однак вони всі мене підвели...\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7315@BODY_LORE@SPIRIT_WEAKENED"
msgstr "Він перебуває в досить розкритому стані, тож більше не становить для тебе загрози."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7315@BUTTON_0@SPIRIT_WEAKENED"
msgstr "Залиште {EventStackLeader} замість <<r:EventStackLeader>>."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7315@BUTTON_1"
msgstr "\"Голова {EventStackLeader}, щойно подана!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7315@BUTTON_2"
msgstr "\"Достатньо {RandomFood} [їжі/] з нашого царства, щоб втамувати сам голод.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7315@BUTTON_3"
msgstr "Ми приносимо загибель усім обарцюхам. Книга Посту!"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7315@BUTTON_4"
msgstr "Скинутий хвіст ящірки, щоб втекти від пащі"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7315@TITLE"
msgstr "Поля Шлюбні: аспект шлюбу"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7320@BODY_FOOTER"
msgstr "{EventStackLeader} хапається за свій n. Хто з вас буде першим?"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7320@BODY_HEADER"
msgstr ""
"Коли твої воїни заходять до переповненої лавою кухні, {EventStackLeader} обертається і вітає їх, використовуючи низький голос "
"персонажа {EventHero}."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7320@BODY_HEADER@SPIRIT_WEAKENED"
msgstr "Тобі вдалося виявити аспект різанини."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7320@BODY_LORE"
msgstr ""
"\"А, відвідувачі!\" <<p:EventStackLeader>> вигукує, кладучи <<o:EventStackLeader>> великий ніж м’яса відкладається вбік. «Яку "
"страву ви бажаєте сьогодні, дорогі гості? Щойно приготовлену {EventRace1}, з печі? Тушковану {EventRace2}? Або ще краще, нарізану "
"{EventRace3} на паличці?» {EventStackLeader} нахиляється вперед, ніби <<p:EventStackLeader>> ділився секретом. «Ці вискочки з "
"{GLOBAL.ObbadothLoreConcept.Hyperlink} вважають свої храми різанини чимось дивовижним. Треба було їм побачити цю арену Бійні у "
"всій її пишноті! Ми служили королям і влаштовували лицарські бенкети, яким не було рівних...»"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7320@BODY_LORE@SPIRIT_WEAKENED"
msgstr "Залиті кров’ю та втомлені, {EventStackLeader} більше не становлять загрози для ваших військ."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7320@BUTTON_0"
msgstr "Тікайте з {EventStackLeader}."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7320@BUTTON_1"
msgstr "Ти! {EventHero}! Ця різанина сьогодні закінчиться!"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7320@BUTTON_2"
msgstr "Зваріть {EventStructure} [mana/], щоб приготувати {EventStackLeader} <<r:EventStackLeader>>."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7320@TITLE"
msgstr "Шлюбні Поля: аспект різанини"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7321@BODY_FOOTER"
msgstr ""
"Погляд {EventStackLeader} пронизує ваші війська, дивлячись прямо на вас — {EventPlayerType} — спостерігаючи здалеку, шукаючи шляху "
"всередину вашого розуму..."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7321@BODY_HEADER"
msgstr ""
"На схилах реальності, де фізичний світ ніби пожирає сам себе, {EventStackLeader} полює на {GLOBAL.SoulsLoreConcept.Hyperlink}, "
"втрачене в давно минулому віці."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7321@BODY_HEADER@SPIRIT_WEAKENED"
msgstr "Тобі вдалося ослабити аспект деліріуму."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7321@BODY_LORE"
msgstr ""
"«Беззубим я кусаюся. Безротим я ковтаю», — бурмоче {EventStackLeader}, поглинуте неземною тишею. «Жодна плоть не зможе "
"задовольнити мої потреби. Сама земля має зникнути в моїй пащі. Дюжина розумів — їжа для мене. Але найбільше я прагну смачних душ!»"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7321@BODY_LORE@SPIRIT_WEAKENED"
msgstr "Тихо плаваючи, {EventStackLeader} більше не становить загрози для ваших військ."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7321@BUTTON_0"
msgstr "Тікайте з {EventStackLeader}."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7321@BUTTON_1"
msgstr "Поваліть тих потвор, перш ніж вони сплутають ваші думки!"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7321@BUTTON_2"
msgstr "Нагодуй {EventStackLeader} душі [souls/], прокляті забуттям."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7321@TITLE"
msgstr "Поля Богові: аспект делірію"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7324@BUTTON_0@SPIRIT_WEAKENED"
msgstr "Залиште {EventStackLeader} замість <<r:EventStackLeader>>."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7328@BUTTON_0@SPIRIT_WEAKENED"
msgstr "Залиште {EventStackLeader} замість <<r:EventStackLeader>>."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7328@BUTTON_4"
msgstr "Заманіть {EventStackLeader} всередину, щоб розчавити його силою своєї волі [knowledge/]."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7461@BODY_FOOTER"
msgstr ""
"За допомогою мерзенної магії {EventHero} закликає <<o:EventHero>> міньйони для захисту <<o:EventHero>> жалюгідне нежиття. Тільки "
"могутня армія може кинути виклик [hyperlink,GLOBAL.TraitorKingsLoreConcept]Королю-Зраднику[/hyperlink]."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7461@BODY_HEADER"
msgstr ""
"Послабивши аспекти голоду, різанини та марення, {EventHero} змушений розкрити <<o:EventHero>> справжня форма, мстивий проклятий "
"дух."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7461@BODY_LORE"
msgstr ""
"\"Хто ти такий, щоб смів кидати мені виклик?\" <<p:EventHero>> кричить, сповнений люті. «Я перехитрив "
"{GLOBAL.EternalCouncilLoreConcept.Hyperlink}, уникнув гніву [hyperlink,GLOBAL.ArchonsLoreConcept]Архонта[/hyperlink]. "
"{GLOBAL.DragonsLoreConcept.Hyperlink} цураюся мого володіння, боячись моєї неминучої досяжності». "
"<<Cge:voice^n,EventHero.FirstName>> гримить громом, і навколишні руїни починають руйнуватися. «Я став первісною силою. Я — ГОЛОД. "
"Я — СМЕРТЬ!»"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7461@BUTTON_0"
msgstr "Приготуйся до бою, щоб покласти край витівкам {EventHero}."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7461@TITLE"
msgstr "Голодні поля: {EventHero} викрито"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7466@BODY_FOOTER"
msgstr ""
"{EventUnit} зникає в променистому спалаху, <<EventUnit{його/її}>> світло, що омолоджує ґрунт, якого воно торкається. Залишений "
"наодинці серед нового життя, що проростає, ти визначаєш долю Зголоднілих Полів."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7466@BODY_HEADER"
msgstr "У ту мить, коли {EventHero} зникає, в руїнах міст чути глибокі зітхання, а поодинокі дерева шелестять із полегшенням."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7466@BODY_LORE"
msgstr ""
"{EventUnit}, що попереджав вас про прокляття [hyperlink,GLOBAL.TraitorKingsLoreConcept]Короля-Зрадника[/hyperlink], повертається "
"до ваших військ. «{EventHero} нарешті переможено!» <<p:EventUnit>> вигукує, радіючи від сяйва. «Ви, {PlayerLeader.TitleName}, "
"звільнили Голодні Поля від їхнього прокляття та відновили мир на землі. Візьміть {EventRelic} з "
"<<ge:remains^p,EventHero.FirstName>> і дивитися <<p:EventRelic>> ну. Усередині живе зло, яке ніколи не зникає.\" {EventUnit} лягає "
"<<EventUnit{його/її}>> зброя, розміщення <<EventUnit{його/її}>> напівпрозора рука на землі для останньої молитви: «Моє чування тут "
"закінчується. Це мій прощальний подарунок...»"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7466@BUTTON_0"
msgstr "Нехай це буде спогад про перемогу добра [goodact/] над злом!"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7466@BUTTON_3"
msgstr "«Сила {GLOBAL.TraitorKingsLoreConcept.Name} була великою. І все ж я стою понад усіма!» [influence/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7466@BUTTON_4"
msgstr "Там, де колись панували голод і смерть, тепер буде вдосталь [food/] і достаток!"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7466@BUTTON_5"
msgstr "«Щоб вивчити місто та його долю, ми повинні запросити {GLOBAL.EternalSagesLoreConcept.Name}». [allegiance/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7466@BUTTON_6"
msgstr "«Ми повинні вивчити [knowledge/] все, що можемо, про <<ge:potent soulcurse magic^n,EventHero.FirstName>>...\" [evilact/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7466@TITLE"
msgstr "Голодні поля: Наслідки"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7496@BODY_FOOTER"
msgstr ""
"«Поверніть {EventUnit} Трон! Покарайте {GLOBAL.TraitorKingCultLoreConcept.Hyperlink}!» — наказує троль. «Культисти використовують "
"заклинання. Знищте культистів. Знищте заклинання!»"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7496@BODY_HEADER"
msgstr "Біля підніжжя могутньої гори шлях твоїх воїнів раптово перекриває величезний, величний троль."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7496@BODY_LORE"
msgstr ""
"«Вклоніться перед Горою Божественного Захисту», — гукає троль, вказуючи на мерехтливі споруди, що височіють на вершині гірського "
"плато, «престол {GLOBAL.BloodClanLoreConcept.Hyperlink} і трон наймогутнішого {EventUnit}!» <<EventUnit{Він/Вона}>> хизується "
"короною на <<EventUnit{його/її}>> голова. «Але {EventUnit} зрадив. {GLOBAL.TraitorKingCultLoreConcept.Hyperlink} прийшов. Отруєні "
"розуми {GLOBAL.BloodClanLoreConcept.Hyperlink} гордістю. Огри та тролі повстали... служать зрадникам!»"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7496@BUTTON_0"
msgstr "Запитайте {EventUnit}, де знайти {GLOBAL.TraitorKingCultLoreConcept.Name}."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7496@TITLE"
msgstr "Відкриття Божеської Гри Страги"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7514@BODY_FOOTER"
msgstr "Кричачи жахливо і намагаючись утекти від тебе, {EventUnit} виливає свою душу, намагаючись утекти."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7514@BODY_HEADER"
msgstr ""
"Побитий та поранений, один із {EventUnit} {GLOBAL.TraitorKingCultLoreConcept.Hyperlink} звертається до ваших військ, все ще "
"сповнений гордості."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7514@BODY_LORE"
msgstr ""
"«Думаєш, що можеш нас зупинити?» — вигукує {EventUnit}, <<EventUnit{його/її}>> щелепа рухалася лише темною магією. «Для наших "
"богів, [hyperlink,GLOBAL.TraitorKingsLoreConcept]Кьйорное[/hyperlink], смерть була лише дверима, простим шляхом до нових сил»."
"<Cp:EventUnit>> зриває бурульку з <<EventUnit{його/її}>> плече, стискаючи його <<EventUnit{його/її}>> кулаки. «Вони єдині "
"наважилися протистояти хибному порядку {GLOBAL.ArchonsLoreConcept.Hyperlink}. Як {GLOBAL.TraitorKingCultLoreConcept.Hyperlink}, ми "
"продовжуємо їхню спадщину та опановуємо їхню магію. Безсмертя близько...»"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7514@BUTTON_0"
msgstr "Нехай <<EventUnit{його/її}>> втеча душі до <<EventUnit{його/її}>> майстри."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7514@BUTTON_4"
msgstr "Вигнати [mana/] душу, щоб покінчити <<EventUnit{його/її}>> злість. [goodact/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7514@BUTTON_5"
msgstr "Зв’яжи [mana/] душу, щоб пізнати солодкі таємниці [knowledge/] магії Кйрное [evilact/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7514@TITLE"
msgstr "Гра Божественної Варти: {EventRace}"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7515@BODY_FOOTER"
msgstr ""
"{EventUnit} згортається. Якщо <<EventUnit{його/її}>> останні слова божевільного містили хоч крихту правди, "
"{GLOBAL.TraitorKingCultLoreConcept.Hyperlink} зловживає {GLOBAL.BloodClanLoreConcept.Hyperlink} як жертвоприношеннями у своїх "
"мерзенних ритуалах."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7515@BODY_HEADER"
msgstr ""
"На межі <<EventUnit{його/її}>> на останньому подиху, {EventUnit} з {GLOBAL.TraitorKingCultLoreConcept.Hyperlink} раптом вибухає "
"сміхом."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7515@BODY_LORE"
msgstr ""
"«Ви бачили огрів?» — запитує {EventUnit}, хихикаючи, <<EventUnit{його/її}>> здоровий глузд давно зник. «Вони бризкаються, як "
"великі жаби. Зелені кишки, блакитна рідина. Фарбує стіни. Роздуває їх магічною есенцією, вколює їх крижаним уламком і — плюх! Це "
"смішно, дурню!» <<EventUnit{Він/Вона}>> бризкає кров'ю, як <<p:EventUnit>> сміється. «Вони думають, що ми дамо їм силу. О, так, "
"силу зеленої бризкаючої жаби!»"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7515@BUTTON_0"
msgstr "Незабаром ми це з’ясуємо."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7515@TITLE"
msgstr "Гора Божественна Захист: {GLOBAL.BloodClanLoreConcept.Name} Жертвопринесення"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7516@BODY_FOOTER"
msgstr ""
"«Сильний лідер культу», — попереджає {EventUnit}. «У {EventUnit} є троє вірних слуг. Один приєднується до {PlayerLeader}, бореться "
"з {EventHero}. {PlayerLeader} вибирай»."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7516@BODY_HEADER"
msgstr ""
"Ваші війська знищили {GLOBAL.TraitorKingCultLoreConcept.Hyperlink}, що блукають схилами гори Божественний Захист. {EventUnit} "
"повертається до них, посміхаючись від злостивої радості."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7516@BODY_LORE"
msgstr ""
"«Культисти сміються та катують {GLOBAL.BloodClanLoreConcept.Hyperlink}», — ображено каже {EventUnit}. «Хто тепер сміється?» "
"<<Cp:EventUnit> гойдалки<o:EventUnit>> велика булава до вершини гори. «Щит заклинань культистів зламаний. Тепер, {EventHero} "
"бійтеся {EventUnit} помсти. Здригніться в тронній залі. <<Co:EventHero>> намисто з черепа для {EventUnit}.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7516@BUTTON_0"
msgstr "Виберіть виховний {BeastOgre} [unit/]."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7516@BUTTON_4"
msgstr "Оберіть вмілого {TrainerOgre} [unit/]."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7516@BUTTON_5"
msgstr "Оберіть хитрий {SeerOgre} [unit/]."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7516@TITLE"
msgstr "Гра Божої Варти: до трону!"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7522@BODY_FOOTER"
msgstr ""
"«Я не бачу ні дарів, ні рабів, гідних моєї пишноти», — підсумовує {CultHero}. «Тож ти помреш». З-за трону з'являються великі "
"{GLOBAL.BloodClanLoreConcept.Hyperlink} хрюкаючі, готові захищати свою новознайдену «<<CultHero{King/Queen}>>\"."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7522@BODY_FOOTER@ENTRY_BLOCKED"
msgstr ""
"Схоже, що {EventUnit} сказали правду, і в {EventStructure} можна увійти лише після того, як буде вбито достатньо "
"{GLOBAL.TraitorKingCultLoreConcept.Hyperlink}, щоб зірвати їхнє заклинання."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7522@BODY_HEADER"
msgstr ""
"Твої вояки заходять через головну браму величного комплексу споруд, оточеного мурами та різьбленням. Вони потрапляють до "
"бездоганно чистої, захопливої зали."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7522@BODY_HEADER@ENTRY_BLOCKED"
msgstr ""
"Твої вояки наближаються до величного комплексу споруд, оточеного мурами та статуями. Проте всі шляхи, що ведуть усередину, "
"перекриті."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7522@BODY_LORE"
msgstr ""
"«Ви прийшли, щоб висловити мені повагу?» — лунає крижаний голос, луною розносячись крізь велетенську кімнату. «Чи ви закінчите "
"своє життя в безглуздій непокорі? Бо коли я подивився в Дзеркало, я передбачив свою долю володіти силою богів. Я, {CultHero}, хто "
"носить таємний знак [hyperlink,GLOBAL.TraitorKingsLoreConcept]Кьорное[/hyperlink] і веде їхніх Синів до темного панування». "
"Вдалині корона Незерісів {CultHero} показує <<o:CultHero>> підшипники під стародавнім гігантським троном."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7522@BODY_LORE@ENTRY_BLOCKED"
msgstr ""
"Пітний чародій замикає всі брами й двері, навіть найменші щілини в прадавніх стінах, блокуючи їх непроникним бар’єром Нетерісу."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7522@BUTTON_0"
msgstr "Принесіть цю фальшиву <<CultHero{King/Queen}>> до <<o:CultHero>> коліна!"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7522@BUTTON_1"
msgstr "Розкритикувати [influence/] тролів і огрів за зраду їхнього короля."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7522@BUTTON_2"
msgstr "Тікати."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7522@TITLE"
msgstr "Гора Годкіп: Хибна <<CultHero{King/Queen}>>"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7522@TITLE@ENTRY_BLOCKED"
msgstr "Гра Божественної Варти: крижаний бар’єр"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7523@BODY_FOOTER"
msgstr ""
"{EventUnit} злітає <<EventUnit{його/її}>> корона. \"{PlayerLeader} гідний {PlayerLeader.Title}. {EventUnit} більше не має "
"{GLOBAL.BloodClanLoreConcept.Hyperlink}. Підпишуся на {PlayerLeader}!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7523@BODY_HEADER"
msgstr "З {CultHero} жертвою <<o:CultHero>> гординя, {EventUnit} повертається до тронної зали <<p:EventUnit>> колись правили."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7523@BODY_LORE"
msgstr ""
"\"{EventUnit} брати, всі мертві...\" <<p:EventUnit>> каже, дивлячись на тіла полеглих {GLOBAL.BloodClanLoreConcept.Hyperlink}, "
"розкидані по численних палатах {EventStructure}. {EventUnit} висить <<EventUnit{його/її}>> величезна голова, <<EventUnit{його/її}"
">> жахливі очі затуманюються. \"{EventUnit} провина. {EventRelic} приречений {EventUnit}. Явив славу. Приніс смерть. Тепер "
"{EventRelic} приречений {CultHero}.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7523@BUTTON_3"
msgstr "{EventUnit} [unit/] складає тобі присягу вірності, яку ти приймаєш."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7523@BUTTON_6"
msgstr ""
"Надішліть {EventUnit} до {GLOBAL.EternalSagesLoreConcept.Name} [allegiance/], поділившись знаннями про "
"{GLOBAL.BloodClanLoreConcept.Hyperlink} та {GLOBAL.TraitorKingCultLoreConcept.Hyperlink}."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7523@BUTTON_7"
msgstr "Пожертвуйте {EventUnit} [evilact/], щоб реанімувати {CultHero} [hero/] як свого темного слугу."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7523@BUTTON_8"
msgstr "Пожертвуйте {EventUnit} [evilact/], щоб реанімувати {CultHero} [hero/] як свого темного слугу."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7523@BUTTON_9"
msgstr "Ти візьмеш лише корону, яку носить {EventUnit}, як символ [influence/] своєї зростаючої слави."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7523@TITLE"
msgstr "Гра Божої Вартової: наслідки"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7754@BUTTON_3"
msgstr "Мудрі знають [knowledge/], що знайти можна лише те, що ми носимо в собі."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7754@BUTTON_4"
msgstr "Ці магічні енергії [mana/], що вириваються з кристалів на цьому острові, загострюють наш розум."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7774@BODY_FOOTER@TRIAL_FAILED"
msgstr ""
"Одностайний голос завершує свою промову: Ви залишитесь на цих островах — так само, як усі злодюжки й загарбники, що прибули сюди "
"раніше!"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7774@BODY_FOOTER@TRIAL_LOCKED"
msgstr "Вам слід повернутися до місць проведення випробувань і відповісти на {EventStackLeader} там."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7774@BODY_HEADER@TRIAL_LOCKED"
msgstr ""
"Ваші війська обережно наближаються до {EventStackLeader}, що пливе серед трьох островів, проте <<p:EventStackLeader>> ігнорує їх."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7774@BODY_LORE@TRIAL_FAILED"
msgstr ""
"«Ви відповіли на наші випробування», — каже {EventStackLeader}, — «а ми вважали ваші відповіді негідними!» У воді є кришталеві "
"відблиски, що засліплюють ваших військ, але вони знову зникають, коли {EventStackLeader} продовжує: "
"«[hyperlink,GLOBAL.GiantKingLoreConcept]Королі Велетнів[/hyperlink] правив {GLOBAL.MyrridaLoreConcept.Hyperlink} з великою "
"мудрістю. Між велетнями та меншими родичами була рівність, і навіть [hyperlink,GLOBAL.GiantKingLoreConcept]Королі Велетнів[/"
"hyperlink] самі дотримувалися закону та рішень {GLOBAL.EternalCouncilLoreConcept.Hyperlink}.\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7774@BODY_LORE@TRIAL_LOCKED"
msgstr ""
"«Ми прийшли судити іншого {GLOBAL.GodirLoreConcept.Hyperlink}», — вигукує {EventStackLeader}. «Повернися до нас, коли відповіси на "
"наші випробування»."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7774@BUTTON_0@TRIAL_LOCKED"
msgstr "Піти."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7774@BUTTON_1@TRIAL_FAILED"
msgstr "\"Ви недооцінюєте можливості {GLOBAL.GodirLoreConcept.Name}. Це утримання закінчується негайно!\""

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7774@BUTTON_5"
msgstr "Воїнське звитяжництво. [unitprod/] [chaosboon/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7774@BUTTON_6"
msgstr "Благодійність. [gold/] [orderboon/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7774@BUTTON_7"
msgstr "Заощадливість. [food/] [natureboon/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7774@TITLE@TRIAL_LOCKED"
msgstr "Острів Трійці: {EventStackLeader}"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7777@BODY_HEADER@TRIAL_FAILED"
msgstr "Ви знищили {EventUnit} та відвоювали острів Трініті у <<EventUnit{його/її}>> вічна хватка."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7800@BODY_FOOTER"
msgstr ""
"«Останній Легіон чекає наказів», — каже {EventUnit}. «Ми — захисники {GLOBAL.MyrridaLoreConcept.Hyperlink}. Скажіть слово, і ми "
"проженемо будь-яких загарбників»."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7800@BODY_HEADER"
msgstr ""
"Під час твого огляду артефактів рідкої скелі вони починають виблискувати й утворюють трикутну конструкцію. Далі з цього "
"трикутника, з глибин землі, виринає {EventUnit}."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7800@BODY_LORE"
msgstr ""
"\"Ви покликали нас собі на допомогу, господарю?\" <<p:EventUnit>> запитує, вимовляючи безгучним голосом. «Ми дрімали протягом "
"віків, зачаївшись під землею. Чи це той день, коли ми нарешті повстанемо, прогнавши всіх загарбників, що загрожують "
"{GLOBAL.MyrridaLoreConcept.Hyperlink}?» У вашій уяві виникають образи нескінченних рядів глиняних солдатів, що розплющують свої "
"очі без повік у вічних гробницях. Їхні фланги захищені левітуючою зброєю старих [hyperlink,GLOBAL.GiantKingLoreConcept]Королі "
"Велетнів[/hyperlink] зв'язаний невмирущою магією."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7800@BUTTON_0"
msgstr "Звільни Останній Легіон на цю країну!"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7800@BUTTON_1"
msgstr "Скажи, що ти призвеш Останній Легіон поодинці — як справжніх захисників."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7800@BUTTON_2"
msgstr ""
"Звільни Останній Легіон від вічної служби, поглинаючи магічну есенцію [mana/] [bindingessence/] [bindingfragments/], яка утримує "
"воїнів при житті."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7800@TITLE"
msgstr "Останній Легіон: ознайомлення"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7819@BODY_FOOTER"
msgstr ""
"Останній Легіон пробуджується зі своїх підземних печер, щоб здійснити напад на цю країну. Як ти бажаєш підготуватися до їхнього "
"наступу?"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7819@BODY_HEADER"
msgstr ""
"Королівство струшується страхом, оскільки поширюються приречені історії про міфічний Останній Легіон "
"{GLOBAL.MyrridaLoreConcept.Hyperlink}."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7819@BODY_LORE"
msgstr ""
"Справді, земля в сум'ятті. Ви можете відчути її брижі, почути її давнє шепіт. Селяни з усієї землі розповідають історії про "
"глиняні фігури, що рухаються в темряві своїх полів. Ковалі говорять про зброю, що спалахує живими іскрами та залишає кузні, щоб "
"приєднатися до лав Останнього Легіону. Правдивість цих історій ще належить з'ясувати, але ви відчуваєте безпосередню небезпеку."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7819@BUTTON_0"
msgstr "Скличте васалів! [influence/] Час настав — нехай виконають свої присяги."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7819@BUTTON_1"
msgstr "Нехай герольди [influence/] зберуть кожного чоловіка й жінку [unitprod/], хто готовий стати на захист наших міст!"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7819@BUTTON_2"
msgstr "Годір не злякається якоїсь купи глини чи іржавої зброї."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7819@TITLE"
msgstr "Останній Легіон: пробудження в надрах землі"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7821@BODY_FOOTER"
msgstr "Армії Останнього Легіону вирушають до твоїх міст. Відбий їхні атаки, інакше все піде прахом!"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7821@BODY_HEADER"
msgstr "Твої міста огортає тривожна тиша. Із землі піднімаються легіони глиняних вояків."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7821@BODY_LORE"
msgstr ""
"Вони не промовляють ні слова, як і зачарована зброя, що пливе з їхніх флангів. Але зрозуміло, що цей Останній Легіон Мірріди має "
"лише одну мету: стерти з лиця землі будь-кого, хто має хоч якусь нішу в їхньому загубленому стародавньому королівстві, — хіба що "
"на землях {EventPlayer}. У цей момент найбільшої небезпеки зрада {EventPlayer.Title} з {EventRace} стає очевидною. Це було "
"<<P:EventPlayer>> хто розв'язав Останній Легіон!"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7821@BUTTON_0"
msgstr "Колись нам уже вдавалося подолати бурі. {EventPlayer} заплатить за це!"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7821@TITLE"
msgstr "Останній Легіон: глобальний напад"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7848@BODY_FOOTER"
msgstr ""
"У цю мить скорботної перемоги {EventRace} повертаються до своїх {PlayerLeader.Title}. Ви заплющуюте очі та перетворюєте розкидану "
"глину та зброю на..."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7848@BODY_HEADER"
msgstr "Після того, як тобі вдається перемогти Останній Легіон, у твоїй країні знову запановує спокій."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7848@BODY_LORE"
msgstr ""
"Однак, підстав для радісної перемоги небагато. Бо коли вороги були лише безсердечною глиною та сталлю, трупи, знайдені на полях "
"битв, надто чітко ілюструють втрати вашого народу. Є слова, що говорять про інших Годірів, які все ще стоять проти Останнього "
"Легіону у своїх володіннях. Але це не повинно вас турбувати, бо {EventRace} у безпеці."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7848@BUTTON_0"
msgstr "пам’ятник на честь війни. [unitprod/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7848@BUTTON_2"
msgstr "пам’ятник на честь миру. [goodact/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7848@BUTTON_3"
msgstr "мавзолей полеглих. [influence/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7848@BUTTON_4"
msgstr "глиняних робітників, які відбудують твої міста. [structureprod/]"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7848@TITLE"
msgstr "Останній Легіон: уламки глини"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7857@BODY_FOOTER"
msgstr ""
"«Один батальйон перебуває під вашим безпосереднім командуванням, пане», — закінчується {EventUnit}. «Нехай ви ведете нас до "
"перемоги!»"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7857@BODY_HEADER"
msgstr "Останній Легіон прибуває у всій своїй величі. Одна за одною з землі виринають нові й нові хвилі глиняних воїнів."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7857@BODY_LORE"
msgstr ""
"«Година близька, господарю», — {EventUnit}, що проявився <<r:EventUnit>> у вашій тронній залі говорить. «Сьогодні ми піднімаємося "
"з наших глибоких покоїв, щоб захистити залишки {GLOBAL.MyrridaLoreConcept.Hyperlink}. Нарешті наша мета буде виконана!» Незліченні "
"армії Останнього Легіону розпочинають свій марш проти інших Годірів королівства. Усвідомивши вашу зраду, вони проклинають ваше "
"ім'я, але вже надто пізно."

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7857@BUTTON_0"
msgstr "«І це буде перемога!»"

msgid "DLC@GIANTKINGS@STORY_EVENT@991_7857@TITLE"
msgstr "Останній легіон: Слава Мірріди"

msgid "DLC@GIANTKINGS@TOME_CRYSTAL_DWELLING@SKILL_1@DESCRIPTION"
msgstr ""
"Базові [hyperlink,GLOBAL.MagicConcept]Магічні атаки[/hyperlink] зачарованих істот отримує:[bulletlist][bullet/]Базова ймовірність "
"{VOLATILE_CHARGE_RESISTANCE>ResolvedStrength}% викликати {GLOBAL.PROPERTIES.VOLATILE_CHARGE.Hyperlink}.[/bulletlist]"

msgid "DLC@GIANTKINGS@TOME_CRYSTAL_DWELLING@SKILL_1@NAME"
msgstr "Кришталевий фокус"

msgid "DLC@GIANTKINGS@TOME_CRYSTAL_DWELLING@SKILL_1@PROP_DESCRIPTION"
msgstr ""
"Базові [hyperlink,GLOBAL.MagicConcept]Магічні атаки[/hyperlink] юнітів мають:[bulletlist][bullet/]Базова ймовірність "
"{VOLATILE_CHARGE_RESISTANCE>ResolvedStrength}% застосувати {GLOBAL.PROPERTIES.VOLATILE_CHARGE.Hyperlink}.[/bulletlist]"

msgid "DLC@GIANTKINGS@TOME_CRYSTAL_DWELLING@SKILL_2@DESCRIPTION"
msgstr ""
"Ворожі юніти в радіусі {VOLATILE_CHARGE_TARGETER>AREA>Radius}-хрестовини:[bulletlist][bullet/]Витримка "
"{CRYSTAL_CRASH_UNIT_DAMAGE>DAMAGE>Physical} {GLOBAL.PhysicalDamageConcept.Hyperlink}.[bullet/]Витримка "
"{CRYSTAL_CRASH_UNIT_DAMAGE>DAMAGE>Shock} {GLOBAL.LightningDamageConcept.Hyperlink}.[bullet/]Мають базовий "
"{VOLATILE_CHARGE_RESISTANCE>ResolvedStrength}% викликати {GLOBAL.PROPERTIES.VOLATILE_CHARGE.Hyperlink} протягом "
"{VOLATILE_CHARGE_EFFECT_DESCRIPTION>NumTurns} [hyperlink,GLOBAL.TurnConcept]ходи[/hyperlink]."

msgid "DLC@GIANTKINGS@TOME_CRYSTAL_DWELLING@SKILL_2@NAME"
msgstr "Кришталевий крах"

msgid "DLC@GIANTKINGS@TOME_CRYSTAL_DWELLING@SKILL_3@DESCRIPTION"
msgstr "{GLOBAL.PROPERTIES.POLEARM_UNIT.Hyperlink}, яка знерухомлює ворогів. Може вербуватися в містах."

msgid "DLC@GIANTKINGS@TOME_CRYSTAL_DWELLING@SKILL_3@NAME"
msgstr "Літорін Шардлансер"

msgid "DLC@GIANTKINGS@TOME_CRYSTAL_DWELLING@SKILL_4@DESCRIPTION"
msgstr ""
"{GLOBAL.PROPERTIES.BATTLE_MAGE.Hyperlink}, що завдає {GLOBAL.PROPERTIES.VOLATILE_CHARGE.Hyperlink} на великій території. Можна "
"драфтувати в містах."

msgid "DLC@GIANTKINGS@TOME_CRYSTAL_DWELLING@SKILL_4@NAME"
msgstr "Літоріновий ліхтар"

msgid "DLC@GIANTKINGS@TOME_CRYSTAL_DWELLING@SKILL_5@DESCRIPTION"
msgstr ""
"Відродити цільовий не-літорінський (негеройський) юніт як літорінського юніту свого рівня.[br/][br/]У разі перемоги в бою "
"відроджених юнітів можна зберегти за ціною {GLOBAL.ManaConcept.Hyperlink}."

msgid "DLC@GIANTKINGS@TOME_CRYSTAL_DWELLING@SKILL_5@NAME"
msgstr "Кристалізуйте сутність"

msgid "DLC@GIANTKINGS@TOME_CRYSTAL_DWELLING@SKILL_6@DESCRIPTION"
msgstr ""
"[bulletlist][bullet/]{amount} {GLOBAL.ManaConcept.Hyperlink}[bullet/]{amount2} {GLOBAL.KnowledgeConcept.Hyperlink}[bullet/]"
"{amount3} {GLOBAL.ImperiumConcept.Hyperlink}[/bulletlist]"

msgid "DLC@GIANTKINGS@TOME_CRYSTAL_DWELLING@SKILL_6@NAME"
msgstr "Вічне посольство"

msgid "DLC@GIANTKINGS@TOME_CRYSTAL_DWELLING@SKILL_7@DESCRIPTION"
msgstr ""
"{GLOBAL.PROPERTIES.MYTHIC_UNIT.Hyperlink} із сильною атакою зарядом та здатністю створювати ланцюг блискавок, який може активувати "
"{GLOBAL.PROPERTIES.VOLATILE_CHARGE.Hyperlink}. Можна драфтувати в містах."

msgid "DLC@GIANTKINGS@TOME_CRYSTAL_DWELLING@SKILL_7@NAME"
msgstr "Літоріновий симулякр"

msgid "DLC@GIANTKINGS@TOME_CRYSTAL_DWELLING@SKILL_8@DESCRIPTION"
msgstr ""
"{GLOBAL.PROPERTIES.SUPPORT_UNIT.Hyperlink}, який може бути пов'язаний з бойовими одиницями та приймати їхню шкоду за них. Можна "
"драфтувати в містах."

msgid "DLC@GIANTKINGS@TOME_CRYSTAL_DWELLING@SKILL_8@NAME"
msgstr "Іржа літоринів^mn{1}x{2}"

msgid "DLC@GIANTKINGS@TOME_CRYSTAL_DWELLING@SKILL_9@DESCRIPTION"
msgstr ""
"{GLOBAL.PROPERTIES.RANGED_UNIT.Hyperlink} з дальньою атакою, що застосовує {GLOBAL.PROPERTIES.VOLATILE_CHARGE.Hyperlink}. Можна "
"драфтувати в містах."

msgid "DLC@GIANTKINGS@TOME_CRYSTAL_DWELLING@SKILL_9@NAME"
msgstr "Літорін Нідлер"

msgid "DLC@GIANTKINGS@TOME_CRYSTAL_DWELLING@TOME@DESCRIPTION"
msgstr ""
"Цей дар можна придбати у {GLOBAL.CrystalDwellingConcept.Hyperlink}, уклавши з ними Кришталевий або Вічний пакт. Вони нададуть вам "
"доступ до юнітів Літоріну та сили Вічних."

msgid "DLC@GIANTKINGS@TOME_CRYSTAL_DWELLING@TOME@NAME"
msgstr "Кришталевий пакт"

msgid "DLC@GIANTKINGS@TOME_DUNGEON_DEPTHS@SKILL1@DESCRIPTION"
msgstr ""
"[bulletlist][bullet/] {amount1} {GLOBAL.GoldConcept.Hyperlink}[bullet/]+{amount2} {GLOBAL.GoldConcept.Hyperlink} за сусідню "
"підземну [hyperlink,GLOBAL.ProvinceConcept]провінцію[/hyperlink].[bullet/] {amount3} {GLOBAL.BindingEssenceConcept.Hyperlink} за "
"сусідню підземну [hyperlink,GLOBAL.ProvinceConcept]провінцію[/hyperlink][bullet/]Рахується як {GLOBAL.MineConcept.Hyperlink}[/"
"bulletlist]"

msgid "DLC@GIANTKINGS@TOME_DUNGEON_DEPTHS@SKILL1@NAME"
msgstr "Підземне сховище"

msgid "DLC@GIANTKINGS@TOME_DUNGEON_DEPTHS@SKILL2@DESCRIPTION"
msgstr ""
"[bulletlist][bullet/]+{amount1} {GLOBAL.StructureProductionConcept.Hyperlink} за сусідню підземну "
"[hyperlink,GLOBAL.ProvinceConcept]провінцію[/hyperlink].[bullet/]+{amount2} {GLOBAL.UnitProductionConcept.Hyperlink} за сусідню "
"підземну [hyperlink,GLOBAL.ProvinceConcept]провінцію[/hyperlink].[bullet/]Дозволяє вербувати "
"{GLOBAL.UNITS.CLAY_ARBALEST.Hyperlink}, {GLOBAL.UNITS.CLAY_CHARGER.Hyperlink} та {GLOBAL.UNITS.CLAY_DEFENDER.Hyperlink}."
"[bullet/]Рахується як {GLOBAL.QuarryConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@GIANTKINGS@TOME_DUNGEON_DEPTHS@SKILL2@NAME"
msgstr "[кар'єр/] Глиняна кузня"

msgid "DLC@GIANTKINGS@TOME_DUNGEON_DEPTHS@SKILL3@DESCRIPTION"
msgstr ""
"[bulletlist][bullet/] {amount1} {GLOBAL.FortificationHealthConcept.Hyperlink} за кожну сусідню підземну "
"[hyperlink,GLOBAL.ProvinceConcept]провінцію[/hyperlink].[bullet/]+{amount2} {GLOBAL.CityStabilityConcept.Hyperlink} за кожну "
"сусідню підземну [hyperlink,GLOBAL.ProvinceConcept]провінції[/hyperlink].[bullet/]{GLOBAL.UNITS.CLAY_ARBALEST.Hyperlink}, "
"{GLOBAL.UNITS.CLAY_CHARGER.Hyperlink} або {GLOBAL.UNITS.CLAY_DEFENDER.Hyperlink} приєднується до бою на вашому боці, коли ви "
"б'єтеся на території цього міста (не працює у воді чи лаві).[bullet/]Рахується як {GLOBAL.QuarryConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@GIANTKINGS@TOME_DUNGEON_DEPTHS@SKILL3@EFFECT_DESCRIPTION"
msgstr ""
"Випадковим чином додає до цього бою {GLOBAL.UNITS.CLAY_ARBALEST.Hyperlink}, {GLOBAL.UNITS.CLAY_CHARGER.Hyperlink} або "
"{GLOBAL.UNITS.CLAY_DEFENDER.Hyperlink}."

msgid "DLC@GIANTKINGS@TOME_DUNGEON_DEPTHS@SKILL3@NAME"
msgstr "[кар'єр/] Мовчазні казарми"

msgid "DLC@GIANTKINGS@TOME_DUNGEON_DEPTHS@SKILL4@DESCRIPTION"
msgstr ""
"Вибрана ворожа армія:[bulletlist][bullet/]Отримує {amount} {GLOBAL.PhysicalDamageConcept.Hyperlink}, подвоюється, якщо накладено в "
"підземній [hyperlink,GLOBAL.ProvinceConcept]провінції[/hyperlink].[bullet/]Протягом {duration} {GLOBAL.WorldMapConcept.Hyperlink} "
"{GLOBAL.TurnConcept}, на початку бою одиниці в цій армії стають {GLOBAL.PROPERTIES.SLOWED.Hyperlink} на {duration2} "
"{GLOBAL.TurnConcept}.[/bulletlist]"

msgid "DLC@GIANTKINGS@TOME_DUNGEON_DEPTHS@SKILL4@NAME"
msgstr "Небезпека підземелля"

msgid "DLC@GIANTKINGS@TOME_DUNGEON_DEPTHS@SKILL4@PROP_DESCRIPTION"
msgstr ""
"На початку бою цей юніт стає {GLOBAL.PROPERTIES.SLOWED.Hyperlink} на {SLOWED_EFFECT_DESCRIPTION>NumTurns} [turn/]"
"[hyperlink,GLOBAL.TurnConcept]ходи[/hyperlink]."

msgid "DLC@GIANTKINGS@TOME_DUNGEON_DEPTHS@SKILL5@DESCRIPTION"
msgstr ""
"Зачаровані юніти отримують:[bulletlist][bullet/]{GLOBAL.PROPERTIES.CAVE_WALK.Hyperlink}[bullet/]У підземеллі:[bulletlist][bullet/]+"
"{amount1} {GLOBAL.DefenseConcept.Hyperlink}[bullet/]+{amount2} {GLOBAL.ResistanceConcept.Hyperlink}[/bulletlist][bullet/]На землі:"
"[bulletlist][bullet/]Завдають +{amount3}% шкоди[/bulletlist][/bulletlist]"

msgid "DLC@GIANTKINGS@TOME_DUNGEON_DEPTHS@SKILL5@NAME"
msgstr "Загарбники глибин"

msgid "DLC@GIANTKINGS@TOME_DUNGEON_DEPTHS@SKILL5@PROP_DESCRIPTION"
msgstr ""
"Цей юніт має:[bulletlist][bullet/]{GLOBAL.PROPERTIES.CAVE_WALK.Hyperlink}[bullet/]Під час перебування під землею:[bulletlist]"
"[bullet/]+{amount1} {GLOBAL.DefenseConcept.Hyperlink}[bullet/]+{amount2} {GLOBAL.ResistanceConcept.Hyperlink}[/bulletlist]"
"[bullet/]Під час перебування на землі:[bulletlist][bullet/]Завдає +{amount3}% шкоди[/bulletlist][/bulletlist]"

msgid "DLC@GIANTKINGS@TOME_DUNGEON_DEPTHS@SPI@DESCRIPTION"
msgstr ""
"[bulletlist][bullet/]+{amount} {GLOBAL.KnowledgeConcept.Hyperlink} [bullet/]Кожен {GLOBAL.TurnConcept.Hyperlink}, одна "
"{GLOBAL.ProvinceConcept.Hyperlink} у [hyperlink,GLOBALPROPERTIES.CityConcept]місті[/hyperlink]:[bulletlist][bullet/]Отримує "
"властивість {GLOBAL.DungeonConcept.Hyperlink}.[/bulletlist][bullet/]Отримує +{amount2} "
"{GLOBAL.StructureProductionConcept.Hyperlink} за кожну прилеглу підземну [hyperlink,GLOBAL.ProvinceConcept]провінцію[/hyperlink]."
"[bullet/]Вважаються як {GLOBAL.ResearchPostConcept.Hyperlink}.[/bulletlist]"

msgid "DLC@GIANTKINGS@TOME_DUNGEON_DEPTHS@SPI@NAME"
msgstr "[researchpost/] Конклав підземельників"

msgid "DLC@GIANTKINGS@TOME_DUNGEON_DEPTHS@TOME@DESCRIPTION"
msgstr ""
"Побудуйте грандіозне підземелля, заповніть його спорудами, які збагатять вас, та захистіть його вічними глиняними солдатами та "
"пастками."

msgid "DLC@GIANTKINGS@TOME_DUNGEON_DEPTHS@TOME@LORE_DESCRIPTION"
msgstr ""
"«Правителі, які будують міцні імперії, розуміють цінність Підземелля. Нехай інші сперечаються на поверхні, поки їхні імперії "
"руйнуються під суворим світлом сонця, поки ваше місто розкидається по безкінечних печерах і гротах. Збудуйте могутні Підземелля та "
"армії з глини, щоб перешкодити тим, хто наважиться піти під землю. Нехай час минає нагорі, бо ваша спадщина в глибинах вічна»."

msgid "DLC@GIANTKINGS@TOME_DUNGEON_DEPTHS@TOME@NAME"
msgstr "Книга підземних глибин"

msgid "DLC@GIANTKINGS@TOME_GEOMANCY@ABILITY_01@BLIGHT@NAME"
msgstr "Терра Болти: Занепад"

msgid "DLC@GIANTKINGS@TOME_GEOMANCY@ABILITY_01@DESCRIPTION"
msgstr "Завдати шкоди цільовому ворожому юніту."

msgid "DLC@GIANTKINGS@TOME_GEOMANCY@ABILITY_01@FIRE@NAME"
msgstr "Терра Болти: Вогонь"

msgid "DLC@GIANTKINGS@TOME_GEOMANCY@ABILITY_01@FROST@NAME"
msgstr "Терра Болти: Мороз"

msgid "DLC@GIANTKINGS@TOME_GEOMANCY@ABILITY_01@LIGHTNING@NAME"
msgstr "Терра Болтс: Блискавка"

msgid "DLC@GIANTKINGS@TOME_GEOMANCY@ABILITY_01@PHYSICAL@NAME"
msgstr "Терра Болтс"

msgid "DLC@GIANTKINGS@TOME_GEOMANCY@ABILITY_01@SPIRIT@NAME"
msgstr "Терра Болтс: Дух"

msgid "DLC@GIANTKINGS@TOME_GEOMANCY@ABILITY_02@BLIGHT@ENHANCED_NAME"
msgstr "Гео-сплеск чемпіона: Погибель"

msgid "DLC@GIANTKINGS@TOME_GEOMANCY@ABILITY_02@BLIGHT@MASTER_NAME"
msgstr "Майстер Гео Сплеск: Смерч"

msgid "DLC@GIANTKINGS@TOME_GEOMANCY@ABILITY_02@BLIGHT@NAME"
msgstr "Гео Сплеск: Смерч"

msgid "DLC@GIANTKINGS@TOME_GEOMANCY@ABILITY_02@DESCRIPTION"
msgstr "Завдає шкоди всім ворогам у радіусі {GEO_SURGE_TARGETER>AREA>Radius}-хексиконів."

msgid "DLC@GIANTKINGS@TOME_GEOMANCY@ABILITY_02@ENHANCED_DESCRIPTION"
msgstr "Геоприсилення:[bulletlist][bullet/]Завдає додатково {amount} одиниць шкоди.[/bulletlist]"

msgid "DLC@GIANTKINGS@TOME_GEOMANCY@ABILITY_02@FIRE@ENHANCED_NAME"
msgstr "Чемпіонський Гео Сплеск: Вогонь"

msgid "DLC@GIANTKINGS@TOME_GEOMANCY@ABILITY_02@FIRE@MASTER_NAME"
msgstr "Майстер Гео Сплеск: Вогонь"

msgid "DLC@GIANTKINGS@TOME_GEOMANCY@ABILITY_02@FIRE@NAME"
msgstr "Гео Сплеск: Вогонь"

msgid "DLC@GIANTKINGS@TOME_GEOMANCY@ABILITY_02@FROST@ENHANCED_NAME"
msgstr "Гео-сплеск чемпіона: Мороз"

msgid "DLC@GIANTKINGS@TOME_GEOMANCY@ABILITY_02@FROST@MASTER_NAME"
msgstr "Майстер Гео Сплеск: Мороз"

