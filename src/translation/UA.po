msgstr "Навіть твій внутрішній вогонь не може захистити твою армію від холоду."

msgid "TRIGGER@TOOLTIP@WELLSPRING_ICE01@AFFINITY_CHOICE_CHAOS@HEADER"
msgstr "Збережи тепло, каналізуючи внутрішній вогонь."

msgid "TRIGGER@TOOLTIP@WELLSPRING_ICE01@AFFINITY_CHOICE_CHAOS@SUCCESS"
msgstr "Холод відступає перед твоєю палкою пристрастю!"

msgid "TRIGGER@TOOLTIP@WELLSPRING_NYMPHS01@AFFINITY_CHOICE_ORDER@FAILURE"
msgstr "Твої накази зникають у порожнечі, і <<m:EnemyUnit>> сміється."

msgid "TRIGGER@TOOLTIP@WELLSPRING_NYMPHS01@AFFINITY_CHOICE_ORDER@HEADER"
msgstr "Заклич святу силу, щоб захистити юніти від спокуси."

msgid "TRIGGER@TOOLTIP@WELLSPRING_NYMPHS01@AFFINITY_CHOICE_ORDER@SUCCESS"
msgstr "Жодна спокуса не похитне твою непохитну віру."

msgid "TRIGGER@TOOLTIP@WIZARD_TOWER_DISPLACEMENT_01@TOME_UNLOCK@ASTRAL_CONVERGENCE"
msgstr "{PlayerLeader} відкриває книгу астрального злиття!"

msgid "TRIGGER@TOOLTIP@WIZARD_TOWER_DISPLACEMENT_01@TOME_UNLOCK@TELEPORTATION"
msgstr "{PlayerLeader} відкриває книгу телепортації!"

msgid "TRIGGER@TOOLTIP@WIZARD_TOWER_PUPPETEER_01@PROPERTY_UNLOCK@MIND_CONTROL_ABILITY"
msgstr "{EventHero} отримує здібність: {ability}."

msgid "TRIGGER@TOOLTIP@WIZARD_TOWER_PUPPETEER_01@PROPERTY_UNLOCK@MIND_IMMUNITY"
msgstr "Усі юніти у підрозділі <<EventHero>> набувають: {GLOBAL.PROPERTIES.CONTROL_LOSS_IMMUNITY.Hyperlink}."

msgid "TRIGGER@TOOLTIP@ZIGGURAT_DRAGONS_01@AFFINITY_CHOICE_MATERIUM@FAILURE"
msgstr "Дракони не ведуться на твою спробу провокації."

msgid "TRIGGER@TOOLTIP@ZIGGURAT_DRAGONS_01@AFFINITY_CHOICE_MATERIUM@HEADER"
msgstr "Спробуй викликати заздрість у обох драконів."

msgid "TRIGGER@TOOLTIP@ZIGGURAT_DRAGONS_01@AFFINITY_CHOICE_MATERIUM@SUCCESS"
msgstr "Дракони починають битися між собою!"

msgid "TRIGGER@TOOLTIP@ZIGGURAT_MATERIA@AFFINITY_CHOICE_ASTRAL@FAILURE"
msgstr "Внутрішнє полум’я големів виявляється надто потужним, щоби його стримати."

msgid "TRIGGER@TOOLTIP@ZIGGURAT_MATERIA@AFFINITY_CHOICE_ASTRAL@HEADER"
msgstr "Охолодити внутрішній механізм големів."

msgid "TRIGGER@TOOLTIP@ZIGGURAT_MATERIA@AFFINITY_CHOICE_ASTRAL@SUCCESS"
msgstr "Після самовоскресіння големи не вибухнуть у вогні."

msgid "TRIGGER@TOOLTIP@ZIGGURAT_MATERIA@AFFINITY_CHOICE_CHAOS@FAILURE"
msgstr "Чари {CombatPropertyHyperlink} не поширюються серед ваших солдатів."

msgid "TRIGGER@TOOLTIP@ZIGGURAT_MATERIA@AFFINITY_CHOICE_CHAOS@HEADER"
msgstr "Зачаруйте своїх воїнів нижчого рангу за допомогою {CombatPropertyHyperlink}, як големів."

msgid "TRIGGER@TOOLTIP@ZIGGURAT_MATERIA@AFFINITY_CHOICE_CHAOS@SUCCESS"
msgstr "Ваші воїни приймають {CombatPropertyHyperlink}. Навіть смерть не може їх зупинити."

msgid "TRIGGER@TOOLTIP@ZIGGURAT_MATERIA@AFFINITY_CHOICE_MATERIUM@FAILURE"
msgstr "Големи, захоплені [hyperlink,GLOBAL.ChaosConcept]енергією Хаосу[/hyperlink], чинять опір вашій спробі."

msgid "TRIGGER@TOOLTIP@ZIGGURAT_MATERIA@AFFINITY_CHOICE_MATERIUM@HEADER"
msgstr "Час від часу намагайся оживити голема за допомогою магії перетворення."

msgid "TRIGGER@TOOLTIP@ZIGGURAT_MATERIA@AFFINITY_CHOICE_MATERIUM@SUCCESS"
msgstr "Один за одним усі големи стали золотими."

msgid "TRIGGER@TOOLTIP@ZIGGURAT_PORTAL_01@AFFINITY_CHOICE_ASTRAL@FAILURE"
msgstr "Твоя спроба скористатися древніми силами зазнає невдачі."

msgid "TRIGGER@TOOLTIP@ZIGGURAT_PORTAL_01@AFFINITY_CHOICE_ASTRAL@HEADER"
msgstr "{EventStructure} — отримай силу з цього джерела."

msgid "TRIGGER@TOOLTIP@ZIGGURAT_PORTAL_01@AFFINITY_CHOICE_ASTRAL@SUCCESS"
msgstr "Сила, що струменить через браму, збільшує твою магічну могутність!"

msgid "TRIGGER@TOOLTIP@ZIGGURAT_PORTAL_01@AFFINITY_CHOICE_ORDER@FAILURE"
msgstr "Твої накази не пробуджують віри."

msgid "TRIGGER@TOOLTIP@ZIGGURAT_PORTAL_01@AFFINITY_CHOICE_ORDER@HEADER"
msgstr "Захисти свої юніти від небезпеки, використовуючи небесний порядок."

msgid "TRIGGER@TOOLTIP@ZIGGURAT_PORTAL_01@AFFINITY_CHOICE_ORDER@SUCCESS"
msgstr "Твої юніти відчувають себе сильнішими під твоїм керівництвом."

msgid "TUTORIAL@AFFINITY@DESCRIPTION"
msgstr "Навчальний посібник щодо рівнів зв'язків"

msgid "TUTORIAL@AFFINITY@PAGE1@DESCRIPTION"
msgstr ""
"Вибір <<gen:c:{GLOBAL.TomeConcept.Hyperlink}>> змінить <<acc:c:{GLOBAL.AffinityConcept.Hyperlink}>>, яка відображає налаштування "
"на певні космічні сили. Вплив на неї також мають обрані вміння твого [hyperlink,GLOBAL.LeaderConcept]Володаря[/hyperlink]. Тобі "
"знадобиться високий рівень зв'язку, щоб розблокувати книги вищого рівня."

msgid "TUTORIAL@AFFINITY@TITLE"
msgstr "Рівні зв'язків"

msgid "TUTORIAL@ALIGNMENT@DESCRIPTION"
msgstr "Навчальний посібник щодо вирівнювання"

msgid "TUTORIAL@ALIGNMENT@PAGE01@DESCRIPTION"
msgstr ""
"{GLOBAL.AlignmentConcept.Hyperlink} відображає, як тебе сприймають інші, і цей образ можна змінити твоїми діями. "
"{GLOBAL.AlignmentConcept.Hyperlink} також визначає базову цінність стосунків між тобою та іншими правителями і "
"[hyperlink,GLOBAL.IndependentCityConcept]вільним містом[/hyperlink]."

msgid "TUTORIAL@ALIGNMENT@PAGE01@INSTRUCTIONS"
msgstr ""
"Світогляд варіюється від чистого добра до чистого зла. Ти можеш побачити свій поточний світогляд правому нижньому кутку під "
"лічильником ходів. Багато змін у світогляді є лише тимчасовими та з часом зникають."

msgid "TUTORIAL@ALIGNMENT@PAGE01@TITLE"
msgstr "Світогляд"

msgid "TUTORIAL@ALIGNMENT@TITLE"
msgstr "Світогляд"

msgid "TUTORIAL@AMBITIONGOVERNANCE@DESCRIPTION"
msgstr "Навчальний посібник зі зміни положення камери на мапі світу."

msgid "TUTORIAL@AMBITIONGOVERNANCE@INSTRUCTION"
msgstr ""
"Чим вищий рівень юніти, тим вона небезпечніша. [rightmousebutton/] Клацни правою кнопкою миші на портрет юніти, щоб детально її "
"оглянути і відповідно підготуватися — або переглянь своє рішення щодо вступу в бій."

msgid "TUTORIAL@AMBITIONGOVERNANCE@TITLE"
msgstr "Панель нагород"

msgid "TUTORIAL@ANCIENTWONDERS@DESCRIPTION"
msgstr "Навчальний посібник щодо древніх чудес у світі"

msgid "TUTORIAL@ANCIENTWONDERS@PAGE01@DESCRIPTION"
msgstr ""
"Ця локація відома як древнє чудо. Така споруда ховає в собі величезні багатства та приносить процвітання будь-якому місту, яке її "
"приєднає. Однак, древні чудеса часто населені потужними чудовиськами."

msgid "TUTORIAL@ANCIENTWONDERS@PAGE01@INSTRUCTION"
msgstr "Лише одна армія під проводом героя чи героїні може досліджувати древнє чудо."

msgid "TUTORIAL@ANCIENTWONDERS@PAGE01@TITLE"
msgstr "Древні чудеса"

msgid "TUTORIAL@ANCIENTWONDERS@TITLE"
msgstr "Древні чудеса"

msgid "TUTORIAL@ARCANE_INSPIRATION@DESCRIPTION"
msgstr "Магічне натхнення — навчальний посібник"

msgid "TUTORIAL@ARCANE_INSPIRATION@TITLE"
msgstr "Школа потенціалу: магічне натхнення"

msgid "TUTORIAL@ARCANE_INSPIRATION_PAGE01@DESCRIPTION"
msgstr ""
"Один із твоїх заклинань отримає перше натхнення, виявляючи прихований потенціал![br/] Потенціали — це потужні економічні ефекти, "
"які можна використати, коли закляття досягне повного рівня натхнення."

msgid "TUTORIAL@ARCANE_INSPIRATION_PAGE01@INSTRUCTIONS"
msgstr ""
"[hyperlink,GLOBAL.CombatSpellConcept]Бойові закляття[/hyperlink] отримують натхнення після кожної битви, в якій вони були "
"використані.[br/]<<m:{GLOBAL.WorldSpellConcept.Hyperlink}>> отримують натхнення щоразу, коли їх застосовують.[br/] Перевір книгу "
"заклинань, щоб знайти інформацію про рівень натхнення закляття та переваги його потенціалу."

msgid "TUTORIAL@ARCANE_INSPIRATION_PART_2@DESCRIPTION"
msgstr "Навчальний посібник щодо використання потенціалів"

msgid "TUTORIAL@ARCANE_INSPIRATION_PART_2@TITLE"
msgstr "Школа потенціалу: використання потенціалів"

msgid "TUTORIAL@ARCANE_INSPIRATION_PART_2_PAGE01@DESCRIPTION"
msgstr ""
"Одне із заклинань отримало достатній рівень натхнення, щоб можна було його використати. Якщо ти це зробиш, отримаєш переваги його "
"потенціалу, проте під час використання доступ до нього буде обмежений."

msgid "TUTORIAL@ARCANE_INSPIRATION_PART_2_PAGE01@INSTRUCTIONS"
msgstr ""
"Ти можеш використати закляття з повним натхненням через книгу заклинань — клацни на індикатор натхнення у верхньому правому кутку "
"іконки закляття."

msgid "TUTORIAL@ARMIES@DESCRIPTION"
msgstr "Навчальний посібник щодо армій на мапі світу"

msgid "TUTORIAL@ARMIES@PAGE00@INSTRUCTION"
msgstr "Щоб дізнатися більше про армію, вибери її на мапі."

msgid "TUTORIAL@ARMIES@PAGE00@OBJECTIVE"
msgstr "Вибери армію"

msgid "TUTORIAL@ARMIES@PAGE01@DESCRIPTION"
msgstr ""
"Армія вибрана. Армії є основною військовою силою. Їх можна використовувати для дослідження світу, атаки ворогів та захисту власних "
"територій."

msgid "TUTORIAL@ARMIES@PAGE01@INSTRUCTION"
msgstr "Прапори над кожною армією вказують на її приналежність. Панель внизу екрана містить додаткову інформацію про армію."

msgid "TUTORIAL@ARMIES@PAGE01@TITLE"
msgstr "Армії"

msgid "TUTORIAL@ARMIES@PAGE02@DESCRIPTION"
msgstr "Армія складається з окремих одиниць. Панель армії містить інформацію про рівень, роль і очки руху юніти."

msgid "TUTORIAL@ARMIES@PAGE02@INSTRUCTION"
msgstr ""
"Щоб дізнатися більше про здібності юніти, клацни [rightmousebutton/] правою кнопкою миші на її портреті в панелі армії, яка "
"розташована внизу екрана."

msgid "TUTORIAL@ARMIES@PAGE02@INSTRUCTION_CONTROLLER"
msgstr ""
"Щоб дізнатися більше про здібності юніти, натисни [ci_dpaddown/], щоб перейти до панелі армії, а потім натисни [ci_buttony/] на "
"будь-якій юніти."

msgid "TUTORIAL@ARMIES@PAGE02@OBJECTIVE"
msgstr "Досліджуй юніта"

msgid "TUTORIAL@ARMIES@PAGE02@TITLE"
msgstr "Панель групи армії"

msgid "TUTORIAL@ARMIES@TITLE"
msgstr "Одиниці та армії"

msgid "TUTORIAL@ARMYMOVEMENT@DESCRIPTION"
msgstr "Навчальний посібник з переміщення армій на мапі світу."

msgid "TUTORIAL@ARMYMOVEMENT@FINISHER@DESCRIPTION"
msgstr ""
"Ти здобув велику перемогу! Ти перемагаєш [hyperlink,GLOBAL.ArmyConcept]Армію[/hyperlink] у [hyperlink,GLOBAL.CombatConcept]битві[/"
"hyperlink], отримуючи славу, а твої юніти, що вижили, отримують <<c:{GLOBAL.ExperienceConcept.Hyperlink}>>. Варто пам'ятати, що "
"армії стають сильнішими з отриманим досвідом."

msgid "TUTORIAL@ARMYMOVEMENT@FINISHER@OBJECTIVE"
msgstr ""
"Переможи <<PlayerLeader{його/її}>> [hyperlink,GLOBAL.ArmyConcept]Армію[/hyperlink] у [hyperlink,GLOBAL.CombatConcept]битві[/"
"hyperlink]. Отримай трохи слави, а твої юніти та герої отримають <<acc:c:{GLOBAL.ExperienceConcept.Hyperlink}>>. Одиниці, що "
"вижили в бою, стають сильнішими та отримують нові здібності. Чим вищий <<c:{GLOBAL.UnitTierConcept.Hyperlink}>>, тим більше "
"[happiness/] [hyperlink,GLOBAL.CityStabilityConcept]стабільності міста[/hyperlink] вони отримують, тому варто регулярно "
"покращувати свої юніти."

msgid "TUTORIAL@ARMYMOVEMENT@PAGE01@DESCRIPTION"
msgstr "Твої армії можуть кожен хід долати певну відстань, на яку також впливає пересічена місцевість."

msgid "TUTORIAL@ARMYMOVEMENT@PAGE01@INSTRUCTION"
msgstr ""
"Щоб перемістити армію на мапі світу, клацни правою кнопкою миші [rightmousebutton/] на полі на мапі світу.[br/][br/]Ти можеш "
"вибрати юніти армії, які мають бути переміщені, клацаючи їхній портрет [leftmousebutton/] лівою кнопкою миші."

msgid "TUTORIAL@ARMYMOVEMENT@PAGE01@INSTRUCTION_CONTROLLER"
msgstr "Після вибору армії ти можеш її перемістити. Для цього натисни [ci_buttona/] на полі на мапі світу.[br/][br/]"

msgid "TUTORIAL@ARMYMOVEMENT@PAGE01@OBJECTIVE"
msgstr "Перемісти одну зі своїх армій"

msgid "TUTORIAL@ARMYMOVEMENT@PAGE01@TITLE"
msgstr "Переміщення армії"

msgid "TUTORIAL@ARMYMOVEMENT@PAGE02@INSTRUCTION"
msgstr ""
"Коли <<c:{GLOBAL.ArmyConcept}>> зайде на поле, зайняте ворожою армією, почнеться [hyperlink,GLOBAL.CombatConcept]бій[/hyperlink]. "
"Армії обох сторін, які знаходяться поруч, можуть [hyperlink,GLOBAL.ReinforcementRuleConcept]підсилити[/hyperlink] сили в бою."

msgid "TUTORIAL@ARMYMOVEMENT@PAGE02@OBJECTIVE"
msgstr "Атакуй ворожу армію"

msgid "TUTORIAL@ARMYMOVEMENT@TITLE"
msgstr "Переміщення армії"

msgid "TUTORIAL@ARMYMOVEMENT_FINISHER@TITLE"
msgstr "Заслужена перемога"

msgid "TUTORIAL@ARMYUPKEEP@DESCRIPTION"
msgstr "Навчальний посібник щодо утримання армії."

msgid "TUTORIAL@ARMYUPKEEP@PAGE01@DESCRIPTION"
msgstr ""
"Не забувай! Твої юніти не воюють безкоштовно. Вони потребують певної кількості [gold/] [hyperlink,GLOBAL.MovePointConcept]золота[/"
"hyperlink] і <<gen:c:{GLOBAL.ManaConcept}>> кожен <<acc:c:{GLOBAL.TurnConcept.Hyperlink}>>. Якщо бракуватиме цих ресурсів, твої "
"юніти втратять <<acc:c:{GLOBAL.UnitMoraleConcept.Hyperlink}>> і, зрештою, дезертируватимуть."

msgid "TUTORIAL@ARMYUPKEEP@TITLE"
msgstr "Утримання армії"

msgid "TUTORIAL@ASTRAL_ECHO@DESCRIPTION"
msgstr "Астральні відлуння (налаштування) — навчальний посібник"

msgid "TUTORIAL@ASTRAL_ECHO@TITLE"
msgstr "Школа налаштування: астральні відлуння"

msgid "TUTORIAL@ASTRAL_ECHO_PAGE01@DESCRIPTION"
msgstr ""
"Ти отримуєш свої перші <<acc:c:{GLOBAL.AstralEchoesConcept.Hyperlink}>>. Цей унікальний ресурс використовується школою "
"налаштування (містицизм) і дозволяє [hyperlink,GLOBAL.EchoCastingConcept]здійснювати відлуння заклинань[/hyperlink]."

msgid "TUTORIAL@ASTRAL_ECHO_PAGE01@INSTRUCTIONS"
msgstr ""
"<<m:{GLOBAL.AstralEchoesConcept.Hyperlink}>> отримуються через знаходження астральних відлунь і під час дослідження нових "
"здібностей."

msgid "TUTORIAL@ASTRAL_ECHO_PAGE02@DESCRIPTION"
msgstr ""
"[hyperlink,GLOBAL.EchoCastingConcept]Здійснення відлуння заклинань[/hyperlink] дозволяє накладати <<c:m:"
"{GLOBAL.SpellConcept.Hyperlink}>>, навіть якщо в тебе недостатньо очок магії."

msgid "TUTORIAL@ASTRAL_ECHO_PAGE02@INSTRUCTIONS"
msgstr ""
"Коли для накладення закляття потрібні <<c:m:{GLOBAL.AstralEchoesConcept.Hyperlink}>>, <<c:m:{GLOBAL.CombatSpellConcept.Hyperlink}"
">> вказують це в зоні витрат. Вони автоматично відображаються після вичерпання <<gen:c:m:"
"{GLOBAL.CombatCastingPointConcept.Hyperlink}>>.[br/]<<m:{GLOBAL.WorldSpellConcept.Hyperlink}>> можна прискорити вручну, натиснувши "
"кнопку в лівому верхньому куті підготовленого закляття."

msgid "TUTORIAL@ASTRAL_ECHO_PAGE02@TITLE"
msgstr "Школа налаштування: здійснення відлуння заклинань"

msgid "TUTORIAL@ASTRAL_ECHO_SUMMONING@DESCRIPTION"
msgstr "Астральні відлуння (виклик) — навчальний посібник"

msgid "TUTORIAL@ASTRAL_ECHO_SUMMONING@TITLE"
msgstr "Школа виклику: здійснення відлуння заклинань"

msgid "TUTORIAL@ASTRAL_ECHO_SUMMONING_PAGE01@DESCRIPTION"
msgstr ""
"Ти отримуєш свої перші <<acc:c:{GLOBAL.AstralEchoesConcept.Hyperlink}>>. Цей унікальний ресурс використовується школою виклику "
"(містицизм) і дозволяє [hyperlink,GLOBAL.EchoInfusionConcept]вливати відлуння[/hyperlink]."

msgid "TUTORIAL@ASTRAL_ECHO_SUMMONING_PAGE01@INSTRUCTIONS"
msgstr ""
"<<m:{GLOBAL.AstralEchoesConcept.Hyperlink}>> отримуються через знаходження астральних відлунь і після розблокування навичок "
"дослідження."

msgid "TUTORIAL@ASTRAL_ECHO_SUMMONING_PAGE02@DESCRIPTION"
msgstr ""
"[hyperlink,GLOBAL.EchoInfusionConcept]Вливання відлуння[/hyperlink] дозволяє використовувати <<gen:c:m:"
"{GLOBAL.AstralEchoesConcept.Hyperlink}>>, щоб посилити юніти <<gen:c:{GLOBAL.PROPERTIES.MAGIC_ORIGIN.Hyperlink}>> і надати їм "
"додаткові ранги."

msgid "TUTORIAL@ASTRAL_ECHO_SUMMONING_PAGE02@INSTRUCTIONS"
msgstr ""
"Вартість вливання залежить від кількості [happiness/] [hyperlink,GLOBAL.CityStabilityConcept]стабільності міста[/hyperlink], "
"необхідного для досягнення наступного рангу одиницею."

msgid "TUTORIAL@ASTRAL_ECHO_SUMMONING_PAGE02@TITLE"
msgstr "Школа виклику: вливання відлуння"

msgid "TUTORIAL@BOOSTING@DESCRIPTION"
msgstr ""
"Будівництво деяких міські споруди можна [hyperlink,GLOBAL.BoostConcept]бустанути[/hyperlink], щоб зробити це дешевше та швидше. "
"Перегляньте підказку до споруди, щоб побачити умови бусту."

msgid "TUTORIAL@BOOSTING@INSTRUCTION"
msgstr ""
"Більшість будівель отримують буст за наявності певних [hyperlink,GLOBAL.SpecialImprovementConcept]покращеннь провінцій[/hyperlink] "
"у володіннях міста, тоді як інші — за наявності певної кількості {GLOBAL.PopulationConcept.Hyperlink}.[br/][br/]Якщо ви отримуєте "
"буст до чогось, що вже будується, вам буде повернуто золото, яке ви б заощадили."

msgid "TUTORIAL@BOOSTING@SUMMARY"
msgstr "Посібник по бусту будівництва"

msgid "TUTORIAL@BOOSTING@TITLE"
msgstr "Буст будівництва"

msgid "TUTORIAL@BOUNTYOVERVIEW@DESCRIPTION"
msgstr "Навчальний посібник з огляду управління нагородами"

msgid "TUTORIAL@BOUNTYOVERVIEW@PAGE_01@DESCRIPTION"
msgstr ""
"Це панель управління нагородами. Тут ти можеш створити <<acc:c:{GLOBAL.CallToArmsConcept.Hyperlink}>> для інших "
"[hyperlink,GLOBAL.LeaderConcept.Hyperlink]правителів[/hyperlink]."

msgid "TUTORIAL@BOUNTYOVERVIEW@PAGE_01@INSTRUCTION"
msgstr ""
"Нагороди — це завдання, що пропонуються іншим володарям в обмін на винагороду. Нагороди можуть стосуватися "
"[hyperlink,GLOBAL.CityConcept]міста[/hyperlink] та важливих будівель, що належать ворогам."

msgid "TUTORIAL@BOUNTYOVERVIEW@TITLE"
msgstr "Панель нагород"

msgid "TUTORIAL@CAMERA@DESCRIPTION"
msgstr "Навчальний посібник зі зміни положення камери на мапі світу."

msgid "TUTORIAL@CAMERA@PAGE01@DESCRIPTION"
msgstr "Приділи час, щоб озирнутися та ознайомитися з оточенням."

msgid "TUTORIAL@CAMERA@PAGE01@INSTRUCTION"
msgstr "Камеру можна пересувати клавішами W, S, A, D або утримуючи [leftmousebutton/] і перетягуючи мишу."

msgid "TUTORIAL@CAMERA@PAGE01@INSTRUCTION_CONTROLLER"
msgstr "Щоб перемістити курсор і камеру, використовуй [ci_leftstick/]"

msgid "TUTORIAL@CAMERA@PAGE01@OBJECTIVE"
msgstr "Переміщення камери"

msgid "TUTORIAL@CAMERA@PAGE01@TITLE"
msgstr "Керування камерою"

msgid "TUTORIAL@CAMERA@PAGE02@INSTRUCTION"
msgstr ""
"Щоб обернути камеру, утримуй середню кнопку миші [middlemousebutton/] і перетягни мишу.[br/][br/]Натисни клавішу R, щоб скинути "
"поворот."

msgid "TUTORIAL@CAMERA@PAGE02@INSTRUCTION_CONTROLLER"
msgstr "Щоб обернути камеру, використовуй [ci_rightstick/].[br/][br/]Натисни [ci_rightstickpress/], щоб скинути поворот."

msgid "TUTORIAL@CAMERA@PAGE02@OBJECTIVE"
msgstr "Скидання налаштувань камери"

msgid "TUTORIAL@CAMERA@PAGE03@DESCRIPTION"
msgstr ""
"Ти можеш детальніше оглянути певну ділянку, наблизивши камеру. Також можна подивитися на оточення з більшої відстані, віддаливши "
"камеру. Якщо віддалитися достатньо, відобразиться оглядова мапа."

msgid "TUTORIAL@CAMERA@PAGE03@INSTRUCTION"
msgstr "Наближай або віддаляй камеру, прокручуючи середню кнопку миші [middlemousebutton/]."

msgid "TUTORIAL@CAMERA@PAGE03@INSTRUCTION_CONTROLLER"
msgstr "Наближай або віддаляй камеру, використовуючи [ci_rightstickupdown/]."

msgid "TUTORIAL@CAMERA@PAGE03@OBJECTIVE"
msgstr "Перейди до оглядової мапи"

msgid "TUTORIAL@CAMERA@TITLE"
msgstr "Керування камерою"

msgid "TUTORIAL@CITIES@DESCRIPTION"
msgstr "Навчальний посібник з управління містами."

msgid "TUTORIAL@CITIES@PAGE00@INSTRUCTION"
msgstr "Щоб дізнатися більше про управління містом, обери своє місто {VarThroneCity.Name} на мапі."

msgid "TUTORIAL@CITIES@PAGE01@DESCRIPTION"
msgstr "Ти обрав одне зі своїх міст. Міста є основою економіки та дозволяють будувати більше юнітів для армії."

msgid "TUTORIAL@CITIES@PAGE01@INSTRUCTION"
msgstr ""
"{GLOBAL.FoodConcept.Hyperlink}, <<c:{GLOBAL.UnitProductionConcept.Hyperlink}>> і <<c:{GLOBAL.StructureProductionConcept.Hyperlink}"
">> — це ресурси, що використовуються для розвитку міст.[br/][br/]{GLOBAL.GoldConcept.Hyperlink}, <<c:{GLOBAL.ManaConcept.Hyperlink}"
">>, <<c:{GLOBAL.ImperiumConcept.Hyperlink}>> і <<c:{GLOBAL.KnowledgeConcept.Hyperlink}>> — це ресурси, які можна використовувати "
"для міста, юнітів або заклять."

msgid "TUTORIAL@CITIES@PAGE01@OBJECTIVE"
msgstr "Вибери своє місто"

msgid "TUTORIAL@CITIES@PAGE01@TITLE"
msgstr "Управління містами"

msgid "TUTORIAL@CITIES@PAGE02@DESCRIPTION"
msgstr ""
"<<m:{GLOBAL.LocationConcept.Hyperlink}>> і <<c:m:{GLOBAL.ProvinceImprovementConcept.Hyperlink}>> у володіннях міста дозволяють "
"отримувати доходи. Натомість [hyperlink,GLOBAL.CityStructureConcept]будівлі[/hyperlink], після їх зведення, надають поліпшення для "
"міста."

msgid "TUTORIAL@CITIES@PAGE02@INSTRUCTION"
msgstr ""
"Обери кнопку з молотком праворуч на панелі міста та виріши, яку будівлю хочеш звести.[br/](Порада) Зведи [food/] склад або "
"[structureprod/] майстерню."

msgid "TUTORIAL@CITIES@PAGE02@OBJECTIVE"
msgstr "Почніть будувати конструкції"

msgid "TUTORIAL@CITIES@PAGE03@DESCRIPTION"
msgstr ""
"Міста також дозволяють вербувати юніти, але за їх [hyperlink,GLOBAL.UnitUpkeepConcept.Hyperlink]утримання[/hyperlink] кожен хід "
"стягується плата. Переконайся, що твої доходи достатні для утримання юнітів."

msgid "TUTORIAL@CITIES@PAGE03@INSTRUCTION"
msgstr "Обери [unit/] кнопку армії під чергою виробництва, а потім юніт для вербування."

msgid "TUTORIAL@CITIES@PAGE03@OBJECTIVE"
msgstr "Почніть набирати юніт"

msgid "TUTORIAL@CITIES@TITLE"
msgstr "Управління містом"

msgid "TUTORIAL@CITYCAP@DESCRIPTION"
msgstr "Підручник з обмеження міст"

msgid "TUTORIAL@CITYCAP@PAGE01@DESCRIPTION"
msgstr "Ти наближаєшся до ліміту кількості міст — його перевищення призведе до значних економічних санкцій."

msgid "TUTORIAL@CITYCAP@PAGE01@INSTRUCTION"
msgstr ""
"Ти можеш збільшити <<c:{GLOBAL.CityCapConcept.Hyperlink}>> у дереві розвитку імперії або продовжувати розширювати імперію, "
"перетворюючи новозахоплені міста на <<m:gen:c:{GLOBAL.PvEVassalConcept.Hyperlink}>>."

msgid "TUTORIAL@CITYCAP@PAGE01@TITLE"
msgstr "Межа міста"

msgid "TUTORIAL@CITYCAP@TITLE"
msgstr "Межа міста"

msgid "TUTORIAL@CITYEXPANSION@DESCRIPTION"
msgstr "Підручник про те, як з’єднати нові провінції з містами"

msgid "TUTORIAL@CITYEXPANSION@PAGE00@INSTRUCTION"
msgstr "Виберіть місто, в якому збільшилася кількість населення."

msgid "TUTORIAL@CITYEXPANSION@PAGE01@DESCRIPTION"
msgstr ""
"Це місто виросло і збільшило <<acc:c:{GLOBAL.PopulationConcept.Hyperlink}>>. Зростання населення дозволяє розширювати володіння "
"міста через розміщення <<gen:c:{GLOBAL.ProvinceImprovementConcept.Hyperlink}>>."

msgid "TUTORIAL@CITYEXPANSION@PAGE01@TITLE"
msgstr "Розширення міст"

msgid "TUTORIAL@CITYEXPANSION@PAGE02@DESCRIPTION"
msgstr ""
"Кожна <<c:{GLOBAL.ProvinceConcept.Hyperlink}>> має різні характеристики, які визначають покращення, що можуть бути побудовані в "
"ній."

msgid "TUTORIAL@CITYEXPANSION@PAGE02@INSTRUCTION"
msgstr "Натисніть [leftmousebutton/] кнопку з міткою [province/], щоб додати провінцію до маєтку міста."

msgid "TUTORIAL@CITYEXPANSION@PAGE02@INSTRUCTION_CONTROLLER"
msgstr "Натисніть кнопку з міткою [province/] на панелі міста, щоб вибрати провінцію для покращення."

msgid "TUTORIAL@CITYEXPANSION@PAGE02@OBJECTIVE"
msgstr "Побудувати покращення провінції"

msgid "TUTORIAL@CITYEXPANSION@TITLE"
msgstr "Розширення міст"

msgid "TUTORIAL@CITYPRODUCTION@DESCRIPTION"
msgstr "Дізнайтесь про виробництво у містах."

msgid "TUTORIAL@CITYPRODUCTION@TITLE"
msgstr "Виробництво"

msgid "TUTORIAL@COMBATEENGAGEMENT@DESCRIPTION"
msgstr "Дізнайтеся, як вступати у бій із ворожими арміями."

msgid "TUTORIAL@COMBATEENGAGEMENT@PAGE01@DESCRIPTION"
msgstr ""
"Ви збираєтеся вступити в бій. Оцініть учасників битви та загальну силу армій, щоб вирішити, чи варто битися вручну чи бій можна "
"виграти в автоматичний режим."

msgid "TUTORIAL@COMBATEENGAGEMENT@PAGE01@INSTRUCTION"
msgstr ""
"У режимі автобитви битви відбуваються у вигляді симуляції. Якщо результат бою вам не сподобається, ви зможете переграти його "
"самостійно."

msgid "TUTORIAL@COMBATEENGAGEMENT@PAGE01@TITLE"
msgstr "Перегляд битви"

msgid "TUTORIAL@COMBATEENGAGEMENT@TITLE"
msgstr "Початок битви"

msgid "TUTORIAL@DEFENDINGYOURCITY@DESCRIPTION"
msgstr ""
"Брак [hyperlink,GLOBAL.CityWallStructureConcept]мурів[/hyperlink] і гарнізонів наражає твоє <<c:m:{GLOBAL.CityConcept.Hyperlink}>> "
"на небезпеку. Подбай про захисні споруди та підтримуй [hyperlink,GLOBAL.ArmyConcept]Армію[/hyperlink] у готовності для охорони "
"мурів, щоб ворог не захопив твої улюблені міста!"

msgid "TUTORIAL@DEFENDINGYOURCITY@INSTRUCTIONS"
msgstr "Місто без оборонних споруд може бути захоплене без бою."

msgid "TUTORIAL@DEFENDINGYOURCITY@SUMMARY"
msgstr "Посібник по обороні міста"

msgid "TUTORIAL@DEFENDINGYOURCITY@TITLE"
msgstr "Оборона міста"

msgid "TUTORIAL@DIPLOMACY@DESCRIPTION"
msgstr "Посібник: дипломатичні взаємодії з іншими володарями"

msgid "TUTORIAL@DIPLOMACY@PAGE00@OBJECTIVE"
msgstr "Відкрий екран дипломатії з іншим гравцем."

msgid "TUTORIAL@DIPLOMACY@PAGE01@DESCRIPTION"
msgstr ""
"На твоєму шляху з’явився інший <<c:{GLOBAL.LeaderConcept}>>. Інші володарі є найбільшою перешкодою на шляху до перемоги, але вони "
"також можуть стати потужними союзниками."

msgid "TUTORIAL@DIPLOMACY@PAGE01@TITLE"
msgstr "Дипломатія"

msgid "TUTORIAL@DIPLOMACY@PAGE02@DESCRIPTION"
msgstr ""
"Цей огляд містить детальну інформацію про іншого володаря про його особистість, <<loc:c:m:{GLOBAL.TreatyConcept.Hyperlink}>> і "
"поточну [hyperlink,GLOBAL.EmpireRelationConcept]стосунки[/hyperlink] з тобою."

msgid "TUTORIAL@DIPLOMACY@PAGE02@INSTRUCTION"
msgstr ""
"Переглянь іншого володаря та виріши, чи хочеш укласти з ним союз, чи, можливо, його здолати... або у тебе інші плани щодо нього."

msgid "TUTORIAL@DIPLOMACY@TITLE"
msgstr "Дипломатія"

msgid "TUTORIAL@EMBALMING@DESCRIPTION"
msgstr "Посібник по в'язницям та склепам, а також бальзамованим жертвоприношенням"

msgid "TUTORIAL@EMBALMING@PAGE01@TITLE"
msgstr "В'язниця, склеп та бальзамоване жертвоприношення"

msgid "TUTORIAL@EMBALMING@TITLE"
msgstr "Культ Смерті: В'язниця, склеп та бальзамоване жертвоприношення"

msgid "TUTORIAL@EMBALMING_PAGE01@DESCRIPTION"
msgstr ""
"Переможеного героя помістили до вашої в'язниці або склепу. Ви можете або передати його законним власникам за винагороду, або, якщо "
"він знаходиться у вашому склепі, забальзамувати його, щоб отримати [hyperlink,GLOBAL.EmbalmedSacrificeConcept]"
"[embalmedsacrifice/]бальзамовані жертви[/hyperlink]. Ви можете стратити героїв у вашій в'язниці, щоб перемістити їх до склепу."

msgid "TUTORIAL@EMBALMING_PAGE01@INSTRUCTIONS"
msgstr ""
"Граючи за Культ Смерті, ви можете використовувати [hyperlink,GLOBAL.EmbalmedSacrificeConcept][embalmedsacrifice/]бальзамовані "
"жертви[/hyperlink] для будівництва потужних Міських Споруд або використання {GLOBAL.SPECIAL_OPERATIONS.MORBID_SACRIFICE.Hyperlink}."
"[br/]Покращення вашої {GLOBAL.WizardTowerConcept.Hyperlink} у {GLOBAL.ThroneCityConcept.Hyperlink} розблокує будівлі, що надають "
"додаткові переваги в'язниці та склепу."

msgid "TUTORIAL@EMPIREDEVELOPMENT@DESCRIPTION"
msgstr "Посібник по розвитку імперії"

msgid "TUTORIAL@EMPIREDEVELOPMENT@PAGE01@DESCRIPTION"
msgstr ""
"Це дерево розвитку імперії. Тут ти можеш обрати спеціалізацію свого імперського розвитку, відповідно до свого стилю гри. Збільшуй "
"<<acc:c:{GLOBAL.AffinityConcept.Hyperlink}>> імперії, щоб відкрити більше можливостей."

msgid "TUTORIAL@EMPIREDEVELOPMENT@PAGE01@INSTRUCTION"
msgstr "Наведи курсор на вміння імперії, щоб дізнатися більше інформації."

msgid "TUTORIAL@EMPIREDEVELOPMENT@PAGE01@TITLE"
msgstr "Розвиток імперії"

msgid "TUTORIAL@EMPIREDEVELOPMENT@PAGE02@DESCRIPTION"
msgstr ""
"З кожним ходом твої досягнення наближають тебе до розблокування нової навички імперії, залежно від значення "
"[hyperlink,GLOBAL.AffinityConcept]сили зв’язку[/hyperlink]. Після розблокування навички ти можеш витратити [imperium/] "
"[hyperlink,GLOBAL.ImperiumConcept]імперіуму[/hyperlink] очки для її активації. На відміну від <<gen:c:m:"
"{GLOBAL.ResearchConcept.Hyperlink}>>, навички імперії надають більше пасивних бонусів і активуються негайно після вибору."

msgid "TUTORIAL@EMPIREDEVELOPMENT@PAGE02@INSTRUCTION"
msgstr "(Опційно) Обери навичку імперії."

msgid "TUTORIAL@EMPIREDEVELOPMENT@TITLE"
msgstr "Навички імперії"

msgid "TUTORIAL@ENCHANTMENTS@DESCRIPTION"
msgstr "Посібник: закляття для посилення військ."

msgid "TUTORIAL@ENCHANTMENTS@PAGE01@DESCRIPTION"
msgstr ""
"<<m:{GLOBAL.UnitEnchantmentConcept.Hyperlink}>> — це закляття, що дозволяють посилювати армії. Вони впливають на всі юніти з "
"певною роллю і мають вартість утримання для кожної юніту, на який діє закляття. Ці закляття часто взаємодіють з юнітами або іншими "
"закляттями з тієї ж книги магії."

msgid "TUTORIAL@ENCHANTMENTS@PAGE01@INSTRUCTION"
msgstr "Щоб скористатися чарами, вам потрібно їх накласти. Ви можете зробити це з Книги Заклинань."

msgid "TUTORIAL@ENCHANTMENTS@PAGE01@INSTRUCTION_CONTROLLER"
msgstr ""
"Щоб скористатися чарами, їх потрібно накласти. Натисніть [ci_buttony/], щоб відкрити радіальне меню, і виберіть кнопку "
"«Заклинання» [spellbutton/]."

msgid "TUTORIAL@ENCHANTMENTS@PAGE01@OBJECTIVE"
msgstr "Відкрийте Книгу Заклинань."

msgid "TUTORIAL@ENCHANTMENTS@PAGE01@TITLE"
msgstr "Заклинання для юнітів"

msgid "TUTORIAL@ENCHANTMENTS@PAGE02@DESCRIPTION"
msgstr ""
"Трансформації рас коштуватимуть значних ресурсів. Вони створюють серйозні та потужні зміни, які неможливо скасувати. Вся раса "
"перетвориться на щось... більше."

msgid "TUTORIAL@ENCHANTMENTS@PAGE02@TITLE"
msgstr "Трансформації"

msgid "TUTORIAL@ENCHANTMENTS@TITLE"
msgstr "Заклинання"

msgid "TUTORIAL@FEUDAL_HOUSES@DESCRIPTION"
msgstr "Навчальний посібник щодо феодальних родів (аристократії)"

msgid "TUTORIAL@FEUDAL_HOUSES@TITLE"
msgstr "Феодальна аристократія: феодальні роди"

msgid "TUTORIAL@FEUDAL_HOUSES_PAGE01@DESCRIPTION"
msgstr "Ви щойно заснували {GLOBAL.FeudalHouseConcept.Hyperlink} – унікальну сутність Феодальної аристократії."

msgid "TUTORIAL@FEUDAL_HOUSES_PAGE01@INSTRUCTIONS"
msgstr ""
"Призначений губернатор тепер є {GLOBAL.PROPERTIES.LIEGE_LORD.Hyperlink} цього роду, будь-які юніти, створені в цьому місті або "
"викликані до армій цього роду, також стануть частиною їхнього роду та отримають переваги від боротьби разом зі своїм сюзереном!"

msgid "TUTORIAL@FEUDAL_HOUSES_PAGE02@DESCRIPTION"
msgstr ""
"Коли {GLOBAL.PROPERTIES.LIEGE_LORD.Hyperlink} роду отримує {GLOBAL.RenownConcept.Hyperlink}, юніти цього роду отримують "
"{GLOBAL.ExperienceConcept.Hyperlink}, а ефект {G LOBAL.PROPERTIES.LIEGE_LORD.Hyperlink} збільшується."

msgid "TUTORIAL@FEUDAL_HOUSES_PAGE02@INSTRUCTIONS"
msgstr ""
"Розташуйте юнітів кожного роду поруч із їхніми {GLOBAL.PROPERTIES.LIEGE_LORD.Hyperlink}, щоб значно зменшити витрати на утримання "
"та підвищити їхню ефективність!"

msgid "TUTORIAL@FREECITIES@DESCRIPTION"
msgstr "Посібник: взаємодію з вільними містами"

msgid "TUTORIAL@FREECITIES@PAGE01@DESCRIPTION"
msgstr "Натрапляєш на вільне місто — це незалежне місто, яке можна васалізувати, включити до імперії або захопити."

msgid "TUTORIAL@FREECITIES@PAGE01@INSTRUCTION"
msgstr ""
"Ознайомся з вільним містом та надай йому <<acc:c:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>>, щоб встановити відносини між вами."

msgid "TUTORIAL@FREECITIES@PAGE01@TITLE"
msgstr "Вільні міста"

msgid "TUTORIAL@FREECITIES@TITLE"
msgstr "Вільні міста"

msgid "TUTORIAL@FRONT_END@FACTION_CREATION@DESCRIPTION_PRIMARY"
msgstr "Посібник: сповіщення та завершення ходу"

msgid "TUTORIAL@FRONT_END@FACTION_CREATION@DESCRIPTION_SECONDARY"
msgstr ""
"Юніт має обмежену кількість [hyperlink,GLOBAL.RetaliationConcept]атаку у відповідь[/hyperlink] за кожен хід, що позначено "
"червоними мітками під її прапором."

msgid "TUTORIAL@FRONT_END@FACTION_CREATION@NAME"
msgstr "Твоя подорож починається..."

msgid "TUTORIAL@FRONT_END@FACTION_CREATION@RECOMMENDED"
msgstr "Рекомендовано"

msgid "TUTORIAL@FRONT_END@FACTION_CREATION_ADVANCED_SETTINGS@DESCRIPTION_PRIMARY"
msgstr "Додаткові налаштування, яким гра буде слідувати якщо ця {GLOBAL.EmpireConcept.Hyperlink} буде під контролем ШІ."

msgid "TUTORIAL@FRONT_END@FACTION_CREATION_ADVANCED_SETTINGS@DESCRIPTION_SECONDARY"
msgstr ""
"Різні здібності коштують різну кількість [actionpoint/] очок дії, деякі можна використовувати один раз за кожен доступний очко "
"дії. Вибір здібності майже завжди означає завершення ходу юніти![br/][br/]Коли плануєте рух, ви можете побачити кількість "
"[fullaction/] очок дії, які залишаться у кінцевій точці."

msgid "TUTORIAL@FRONT_END@FACTION_CREATION_ADVANCED_SETTINGS@NAME"
msgstr ""
"Створіть список власних назв для {GLOBAL.CityConcept.Hyperlink}, які будуть використовуватися для міст вашої раси.[br/]Цей список "
"буде використовуватися зверху вниз, коли ви: [bulletlist][bullet/]Знайдете нове місто вашої раси[bullet/]Перенесете місто до вашої "
"раси[/bulletlist]"

msgid "TUTORIAL@FRONT_END@FACTION_CREATION_CULTURE@DESCRIPTION_PRIMARY"
msgstr "Посібник: сповіщення та завершення ходу"

msgid "TUTORIAL@FRONT_END@FACTION_CREATION_CULTURE@DESCRIPTION_SECONDARY"
msgstr ""
"Різні здібності коштують різну кількість [actionpoint/] очок дії, деякі можна використовувати один раз за кожен доступний очко "
"дії. Вибір здібності майже завжди означає завершення ходу юніти![br/][br/]Коли плануєте рух, ви можете побачити кількість "
"[fullaction/] очок дії, які залишаться у кінцевій точці."

msgid "TUTORIAL@FRONT_END@FACTION_CREATION_CULTURE@NAME"
msgstr "З якої культури ти походиш?"

msgid "TUTORIAL@FRONT_END@FACTION_CREATION_CULTURE@RECOMMENDED"
msgstr "З якої культури ти походиш?"

msgid "TUTORIAL@FRONT_END@FACTION_CREATION_FINALIZE@DESCRIPTION_PRIMARY"
msgstr ""
"Один із твоїх заклинань отримає перше натхнення, виявляючи прихований потенціал![br/] Потенціали — це потужні економічні ефекти, "
"які можна використати, коли закляття досягне повного рівня натхнення."

msgid "TUTORIAL@FRONT_END@FACTION_CREATION_FINALIZE@DESCRIPTION_SECONDARY"
msgstr ""
"Різні здібності коштують різну кількість [actionpoint/] очок дії, деякі можна використовувати один раз за кожен доступний очко "
"дії. Вибір здібності майже завжди означає завершення ходу юніти![br/][br/]Коли плануєте рух, ви можете побачити кількість "
"[fullaction/] очок дії, які залишаться у кінцевій точці."

msgid "TUTORIAL@FRONT_END@FACTION_CREATION_FINALIZE@NAME"
msgstr "Твоя подорож починається..."

msgid "TUTORIAL@FRONT_END@FACTION_CREATION_FORM@DESCRIPTION_PRIMARY"
msgstr "Посібник: сповіщення та завершення ходу"

msgid "TUTORIAL@FRONT_END@FACTION_CREATION_FORM@DESCRIPTION_SECONDARY"
msgstr ""
"Юніт має обмежену кількість [hyperlink,GLOBAL.RetaliationConcept]атаку у відповідь[/hyperlink] за кожен хід, що позначено "
"червоними мітками під її прапором."

msgid "TUTORIAL@FRONT_END@FACTION_CREATION_FORM@NAME"
msgstr "Яку форму приймають твої люди?"

msgid "TUTORIAL@FRONT_END@FACTION_CREATION_FORM@RECOMMENDED"
msgstr "[recommended/] Люди — це раса, зручна для гри: вони швидко розвиваються та стійкі до ушкоджень."

msgid "TUTORIAL@FRONT_END@FACTION_CREATION_RULER_AMBITION@DESCRIPTION_PRIMARY"
msgstr "Посібник: переговори між правителями."

msgid "TUTORIAL@FRONT_END@FACTION_CREATION_RULER_AMBITION@DESCRIPTION_SECONDARY"
msgstr ""
"Юніт має обмежену кількість [hyperlink,GLOBAL.RetaliationConcept]атаку у відповідь[/hyperlink] за кожен хід, що позначено "
"червоними мітками під її прапором."

msgid "TUTORIAL@FRONT_END@FACTION_CREATION_RULER_AMBITION@NAME"
msgstr "Творець фракції: амбіція володаря"

msgid "TUTORIAL@FRONT_END@FACTION_CREATION_RULER_AMBITION@RECOMMENDED"
msgstr "[recommended/] Наставник — це проста амбіція, яку ти втілюєш, супроводжуючи свої загони в битві."

msgid "TUTORIAL@FRONT_END@FACTION_CREATION_RULER_APPEARANCE@DESCRIPTION_PRIMARY"
msgstr ""
"Один із твоїх заклинань отримає перше натхнення, виявляючи прихований потенціал![br/] Потенціали — це потужні економічні ефекти, "
"які можна використати, коли закляття досягне повного рівня натхнення."

msgid "TUTORIAL@FRONT_END@FACTION_CREATION_RULER_APPEARANCE@DESCRIPTION_SECONDARY"
msgstr ""
"Вихід із зони контролю може спровокувати <<acc:c:{GLOBAL.OpportunityAttackConcept}>>.[br/][br/]У зоні контролю ворога багато "
"дистанційних і магічних здібностей будуть недоступні."

msgid "TUTORIAL@FRONT_END@FACTION_CREATION_RULER_APPEARANCE@NAME"
msgstr "Творець фракції: вигляд володаря"

msgid "TUTORIAL@FRONT_END@FACTION_CREATION_RULER_APPEARANCE@RECOMMENDED"
msgstr "[recommended/] Воїн — це потужний клас, що зосереджується на ближньому бою та виживанні."

msgid "TUTORIAL@FRONT_END@FACTION_CREATION_RULER_ORIGIN@DESCRIPTION_PRIMARY"
msgstr "Навчальний посібник щодо використання потенціалів"

msgid "TUTORIAL@FRONT_END@FACTION_CREATION_RULER_ORIGIN@DESCRIPTION_SECONDARY"
msgstr ""
"Вихід із зони контролю може спровокувати <<acc:c:{GLOBAL.OpportunityAttackConcept}>>.[br/][br/]У зоні контролю ворога багато "
"дистанційних і магічних здібностей будуть недоступні."

msgid "TUTORIAL@FRONT_END@FACTION_CREATION_RULER_ORIGIN@NAME"
msgstr "Визначте походження правителя"

msgid "TUTORIAL@FRONT_END@FACTION_CREATION_RULER_ORIGIN@RECOMMENDED"
msgstr "[recommended/] Чемпіон — гарний вибір для сильної початкової армії та великого тронного міста."

msgid "TUTORIAL@FRONT_END@FACTION_CREATION_SOCIETY_TRAITS@DESCRIPTION_PRIMARY"
msgstr "Додаткові налаштування, яким гра буде слідувати якщо ця {GLOBAL.EmpireConcept.Hyperlink} буде під контролем ШІ."

msgid "TUTORIAL@FRONT_END@FACTION_CREATION_SOCIETY_TRAITS@DESCRIPTION_SECONDARY"
msgstr ""
"Різні здібності коштують різну кількість [actionpoint/] очок дії, деякі можна використовувати один раз за кожен доступний очко "
"дії. Вибір здібності майже завжди означає завершення ходу юніти![br/][br/]Коли плануєте рух, ви можете побачити кількість "
"[fullaction/] очок дії, які залишаться у кінцевій точці."

msgid "TUTORIAL@FRONT_END@FACTION_CREATION_SOCIETY_TRAITS@NAME"
msgstr "Що визначає їхнє суспільство?"

msgid "TUTORIAL@FRONT_END@FACTION_CREATION_SOCIETY_TRAITS@RECOMMENDED"
msgstr ""
"[recommended/] Обдаровані заклиначі полегшують накладання чарів.[br/][recommended/] Легендарні мисливці збільшують винагороди, "
"отримувані в битвах.[br/][recommended/] Буйні хмари зміцнюють загони на ранніх етапах гри."

msgid "TUTORIAL@FRONT_END@FACTION_CREATION_TOME@DESCRIPTION_PRIMARY"
msgstr "Посібник: сповіщення та завершення ходу"

msgid "TUTORIAL@FRONT_END@FACTION_CREATION_TOME@DESCRIPTION_SECONDARY"
msgstr ""
"Різні здібності коштують різну кількість [actionpoint/] очок дії, деякі можна використовувати один раз за кожен доступний очко "
"дії. Вибір здібності майже завжди означає завершення ходу юніти![br/][br/]Коли плануєте рух, ви можете побачити кількість "
"[fullaction/] очок дії, які залишаться у кінцевій точці."

msgid "TUTORIAL@FRONT_END@FACTION_CREATION_TOME@NAME"
msgstr "Твоя подорож починається..."

msgid "TUTORIAL@FRONT_END@FACTION_CREATION_TOME@RECOMMENDED"
msgstr ""
"[recommended/] У книзі магії вогню ти знайдеш широкий вибір потужних вогняних заклять, а також 2 [unitBattleMage/] <<acc:c:m:"
"{GLOBAL.PROPERTIES.BATTLE_MAGE.Hyperlink}>>, які зміцнять твоє військо."

msgid "TUTORIAL@FRONT_END@REALM_SELECTION@DESCRIPTION_PRIMARY"
msgstr "Підручник з вибору книг та отримання таємних знань"

msgid "TUTORIAL@FRONT_END@REALM_SELECTION@DESCRIPTION_SECONDARY"
msgstr ""
"Юніт має обмежену кількість [hyperlink,GLOBAL.RetaliationConcept]атаку у відповідь[/hyperlink] за кожен хід, що позначено "
"червоними мітками під її прапором."

msgid "TUTORIAL@FRONT_END@REALM_SELECTION@NAME"
msgstr "Вибір книги"

msgid "TUTORIAL@FRONT_END@REALM_SELECTION@RECOMMENDED"
msgstr "Підручник з вибору книг та отримання таємних знань"

msgid "TUTORIAL@FRONT_END@REALM_SETUP@DESCRIPTION_PRIMARY"
msgstr "Навчальний посібник щодо феодальних родів (аристократії)"

msgid "TUTORIAL@FRONT_END@REALM_SETUP@DESCRIPTION_SECONDARY"
msgstr ""
"Якщо бойовий дух юніта впаде занадто низько, він стане [hyperlink,GLOBAL.Routing]розгромленим[/hyperlink] і почне втікати з поля "
"бою."

msgid "TUTORIAL@FRONT_END@REALM_SETUP@NAME"
msgstr "Феодальна аристократія: феодальні роди"

msgid "TUTORIAL@FRONT_END@REALM_SETUP@RECOMMENDED"
msgstr "[recommended/] Якщо це твоя перша пригода в грі, не рекомендується додавати жодних рис до краю."

msgid "TUTORIAL@GOVERNORS@DESCRIPTION"
msgstr "Посібник: губернаторів міст."

msgid "TUTORIAL@GOVERNORS@PAGE01@DESCRIPTION"
msgstr ""
"Відкриваєш меню призначення губернатора. Тут можна переглянути всіх доступних [hyperlink,GLOBAL.HeroConcept]героїв[/hyperlink], "
"які можуть виконувати роль губернаторів цього міста, а також інформацію про бонуси, які вони надають."

msgid "TUTORIAL@GOVERNORS@PAGE01@TITLE"
msgstr "Губернатори"

msgid "TUTORIAL@GOVERNORS@TITLE"
msgstr "Губернатори"

msgid "TUTORIAL@GRIEVANCES@DESCRIPTION"
msgstr "Посібник: оголошення війн та скарги, необхідні для виправдання дій."

msgid "TUTORIAL@GRIEVANCES@PAGE01@DESCRIPTION"
msgstr ""
"Отримано або створено <<acc:c:{GLOBAL.CasusBelliConcept.Hyperlink}>> проти іншого правителя. Скарги використовуються для "
"виправдання війни, або ти можеш пробачити правителю, що позитивно вплине на ваші "
"[hyperlink,GLOBAL.EmpireRelationConcept]відносини[/hyperlink]."

msgid "TUTORIAL@GRIEVANCES@PAGE01@INSTRUCTION"
msgstr ""
"Війни повинні бути виправдані, інакше їх буде визнано [evilact/] злом. {GLOBAL.WarJustificationConcept.Hyperlink} залежить від <<c:"
"{GLOBAL.CasusBelliConcept}>> і може бути перевірено через активування іконки [casusBelli/] на екрані дипломатії."

msgid "TUTORIAL@GRIEVANCES@PAGE01@TITLE"
msgstr "Оголошення війни і скарги"

msgid "TUTORIAL@GRIEVANCES@TITLE"
msgstr "Оголошення війни і скарги"

msgid "TUTORIAL@HEROES@DESCRIPTION"
msgstr "Посібник: можливості героїв та способи відкриття більшої кількості можливостей."

msgid "TUTORIAL@HEROES@PAGE00@INSTRUCTION"
msgstr ""
"Вибери армію з героєм і [rightmousebutton/] клацни правою кнопкою миші на його портрет, щоб перевірити його. Срібний прапор армії "
"означає, що армією керує герой. Золотий прапор армії означає, що армією керує спеціальний герой — твій правитель."

msgid "TUTORIAL@HEROES@PAGE00@INSTRUCTION_CONTROLLER"
msgstr ""
"Вибери армію з героєм, натисни [ci_dpaddown/], щоб перейти до панелі армії, а потім натисни [ci_buttony/], щоб перевірити цього "
"героя. Срібний прапор армії означає, що армією керує герой. Золотий прапор армії означає, що армією керує спеціальний герой — твій "
"правитель."

msgid "TUTORIAL@HEROES@PAGE01@DESCRIPTION"
msgstr ""
"Обрано героя. Герої керують арміями у світі і лише вони можуть досліджувати [hyperlink,GLOBAL.AncientWonderConcept]стародавні "
"чудеса[/hyperlink], будувати [hyperlink,GLOBAL.OutpostConcept]форпости[/hyperlink] та починати "
"[hyperlink,GLOBAL.SiegeConcept]облоги[/hyperlink]."

msgid "TUTORIAL@HEROES@PAGE01@INSTRUCTION"
msgstr ""
"Підвищуй рівень героїв, використовуючи їх у [hyperlink,GLOBAL.CombatConcept]битвах[/hyperlink]. Також можна оснащувати їх "
"знайденими у скарбах предметами."

msgid "TUTORIAL@HEROES@PAGE01@OBJECTIVE"
msgstr "Відкрий панель героя."

msgid "TUTORIAL@HEROES@PAGE01@TITLE"
msgstr "Правителі та герої"

msgid "TUTORIAL@HEROES@TITLE"
msgstr "Правителі та герої"

msgid "TUTORIAL@HEROLEVELING@DESCRIPTION"
msgstr "Посібник: вибір навичок після підвищення рівня героя."

msgid "TUTORIAL@HEROLEVELING@PAGE01@DESCRIPTION"
msgstr ""
"{GLOBAL.HeroConcept.Hyperlink} може вибрати нову навичку щоразу після досягнення нового рівня. Можна вибрати спеціалізації героїв."

msgid "TUTORIAL@HEROLEVELING@PAGE01@INSTRUCTION"
msgstr ""
"Вибери навичку героя з категорій: військове мистецтво, бойова магія або підтримка. Це дозволить розблокувати кращі навички героя у "
"відповідній категорії."

msgid "TUTORIAL@HEROLEVELING@PAGE01@TITLE"
msgstr "Підвищення рівня героя"

msgid "TUTORIAL@HEROLEVELING@TITLE"
msgstr "Підвищення рівня героя"

msgid "TUTORIAL@HEROLEVELINGSCREEN@DESCRIPTION"
msgstr "Посібник: як відкрити дерево вмінь героя"

msgid "TUTORIAL@HEROLEVELINGSCREEN@PAGE01@DESCRIPTION"
msgstr ""
"{GLOBAL.HeroConcept.Hyperlink} отримує опції здібностей з 3 роду:[bulletlist][bullet/]<<gen:{GLOBAL.HeroClass.Hyperlink}"
">>[bullet/]<<gen:{GLOBAL.HeroOrigin.Hyperlink}>>[bullet/]<<gen:{GLOBAL.HeroDedication.Hyperlink}>>[/bulletlist]"

msgid "TUTORIAL@HEROLEVELINGSCREEN@PAGE01@INSTRUCTION"
msgstr ""
"Очки вмінь можна використовувати для розблокування здібностей з будь-якого дерева, отримуючи нові навички та властивості, а також "
"доступ до майбутніх здібностей героя."

msgid "TUTORIAL@HEROLEVELINGSCREEN@PAGE01@TITLE"
msgstr "Дерева вмінь героя"

msgid "TUTORIAL@HEROLEVELINGSCREEN@TITLE"
msgstr "Дерева вмінь героя"

msgid "TUTORIAL@HERORECRUITMENT@DESCRIPTION"
msgstr ""
"Тут ти можеш завербувати нового <<gen:c:{GLOBAL.HeroConcept.Hyperlink}>>, якщо є вільне місце у списку героїв. Також можна "
"витратити очки <<c:{GLOBAL.ImperiumConcept.Hyperlink}>>, щоб негайно збільшити цей ліміт.\n"
"\n"
"Місцеві герої походять з твоєї країни. Після укладання пакту з [hyperlink,GLOBAL.IndependentCityConcept]вільним містом[/"
"hyperlink], ти також отримаєш доступ до досвідчених героїв цього міста."

msgid "TUTORIAL@HERORECRUITMENT@INSTRUCTION"
msgstr ""
"[hyperlink,GLOBAL.HeroConcept]Герої[/hyperlink] з іншого <<gen:c:{GLOBAL.IndependentCityConcept.Hyperlink}>> мають свою власну "
"культуру та здібності.\n"
"\n"
"Вартість імперії, необхідна для негайного збільшення ліміту героїв, залежить від кількості [hyperlink,GLOBAL.TurnConcept][turn/][/"
"hyperlink], що залишилися до моменту, коли ліміт збільшиться природним шляхом."

msgid "TUTORIAL@HERORECRUITMENT@SUMMARY"
msgstr "Посібник по вербуванню героїв"

msgid "TUTORIAL@HERORECRUITMENT@TITLE"
msgstr "Вербування героя"

msgid "TUTORIAL@HOSTAGE_DIPLOMACY@DESCRIPTION"
msgstr "Підручник з дипломатії заручників (Культ Тиранії)"

msgid "TUTORIAL@HOSTAGE_DIPLOMACY@TITLE"
msgstr "Дипломатія заручників (Культ Тиранії)"

msgid "TUTORIAL@HOSTAGE_DIPLOMACY_PAGE01@DESCRIPTION"
msgstr ""
"Темна субкультура «Культ Тиранії» використовує героїв у їхній в'язниці, щоб взяти під контроль Вільні міста та експлуатувати "
"васалів."

msgid "TUTORIAL@HOSTAGE_DIPLOMACY_PAGE01@INSTRUCTIONS"
msgstr ""
"[bulletlist][bullet/]Переможені герої, що належать до вільних міст, стають Заручниками у вашій в'язниці.[bullet/]Заручники надають "
"{GLOBAL.HouseInfluenceConcept.Hyperlink} щоходу та рахуються як призначений {GLOBAL.DiplomaticTokenConcept.Hyperlink}."
"[bullet/]Завойовані міста, звільнені як васали, також негайно надають вам Заручника.[bullet/]Під час васалізації міста, яке "
"належало іншій імперії, усі герої цієї імперії у вашій в'язниці стають заручниками цього нового васала.[/bulletlist]"

msgid "TUTORIAL@HOSTILECITY@DESCRIPTION"
msgstr "Ворожі вільні міста — самовчитель."

msgid "TUTORIAL@HOSTILECITY@PAGE1@DESCRIPTION"
msgstr ""
"Ти зіткнувся з ворожим <<c:{GLOBAL.IndependentCityConcept.Hyperlink}>> — це незалежне місто, яке ти можеш підкорити, включити або "
"захопити."

msgid "TUTORIAL@HOSTILECITY@PAGE1@INSTRUCTION"
msgstr ""
"Це місто веде з тобою [war/] [hyperlink,GLOBAL.IndependentCityWarConcept]війну[/hyperlink]. Ти можеш його завоювати, підкоривши, "
"або домовитися про мир, після чого місто отримає від тебе <<acc:c:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>>, що дозволить "
"встановити з ним відносини."

msgid "TUTORIAL@HOSTILECITY@TITLE"
msgstr "Вороже вільне місто"

msgid "TUTORIAL@IMPERIUM@DESCRIPTION"
msgstr "Посібник по імперіуму."

msgid "TUTORIAL@IMPERIUM@INSTRUCTIONS"
msgstr ""
"Дохід імперіуму здобувається головним чином через будівництво етапів вежі чарівника в [GLOBAL.ThroneCityConcept]столиці[/"
"hyperlink] або приєднання [hyperlink,GLOBAL.AncientWonderConcept]стародавніх див[/hyperlink]."

msgid "TUTORIAL@IMPERIUM@PAGE01@DESCRIPTION"
msgstr ""
"Ти накопичив велику кількість очок [hyperlink,GLOBAL.ImperiumConcept]імперіуму[/hyperlink], що відображають твій вплив на світ. Ти "
"можеш їх використати для отримання нових міст, розблокування нових [hyperlink,GLOBAL.EmpireSkillConcept]навичок імперії[hyperlink] "
"або прискорення розвитку міст."

msgid "TUTORIAL@IMPERIUM@PAGE01@INSTRUCTION"
msgstr ""
"Статус імперії здобувається головним чином через будівництво етапів [hyperlink,GLOBAL.WizardTowerConcept]вежі чарівника[/"
"hyperlink] у [GLOBAL.ThroneCityConcept]столиці[/hyperlink] або приєднання <<m:acc:c:{GLOBAL.AncientWonderConcept.Hyperlink}>>."

msgid "TUTORIAL@IMPERIUM@PAGE01@OBJECTIVE"
msgstr "Відкрийте древо навичок імперії"

msgid "TUTORIAL@IMPERIUM@PAGE01@TITLE"
msgstr "Імперіум"

msgid "TUTORIAL@IMPERIUM@TITLE"
msgstr "Імперіум"

msgid "TUTORIAL@INFESTATIONS@DESCRIPTION"
msgstr "Посібник по нашестям"

msgid "TUTORIAL@INFESTATIONS@PAGE01@DESCRIPTION"
msgstr ""
"Насувається нашестя. Ворожі армії будуть виповзати з лігва на твої землі, якщо це лігво довго буде залишатися неперевіреним. "
"Знищення навали може виявитися тяжким випробуванням."

msgid "TUTORIAL@INFESTATIONS@PAGE01@TITLE"
msgstr "Нашестя"

msgid "TUTORIAL@INFESTATIONS@TITLE"
msgstr "Нашестя"

msgid "TUTORIAL@ITEMFORGE@DESCRIPTION"
msgstr "Посібник по кузні предметів"

msgid "TUTORIAL@ITEMFORGE@PAGE01@DESCRIPTION"
msgstr ""
"Це кузня предметів. Тут можна кувати нові предмети для своїх героїв. Ти можеш обрати тип предмета та його функції. Єдине обмеження "
"— це кількість доступної <<gen:c:{GLOBAL.BindingEssenceConcept.Hyperlink}>> і зібраних "
"[hyperlink,GLOBAL.MagicMaterialConcept]магічних матералів[/hyperlink]."

msgid "TUTORIAL@ITEMFORGE@PAGE01@INSTRUCTION"
msgstr ""
"Ти можеш отримати есенцію зв’язування, розчаровуючи предмети героїв у своєму арсеналі.[br/][br/]Кожен магічний матеріал має свої "
"унікальні вдосконалення, які можна використовувати в кузні предметів. Збирання більшої кількості одного і того ж матеріалу "
"відкриває потужніші зачарування."

msgid "TUTORIAL@ITEMFORGE@PAGE01@TITLE"
msgstr "Кузня предметів"

msgid "TUTORIAL@ITEMFORGE@PAGE02@INSTRUCTION"
msgstr ""
"Кожна зачарування потребує певної кількості очок. Загальна кількість використаних очок визначає рівень предмета та його вартість. "
"Кожна додаткова зачарування збільшує вартість. Потужніші, складніші предмети потребують більше ресурсів. У кузні можна одночасно "
"створювати лише один предмет. Процес можна скасувати в будь-який момент до завершення, повернувши всі використані ресурси."

msgid "TUTORIAL@ITEMFORGE@TITLE"
msgstr "Кузня предметів"

msgid "TUTORIAL@LAVA@DESCRIPTION"
msgstr "Посібник щодо провінції лави на карті світу."

msgid "TUTORIAL@LAVA@TITLE"
msgstr "Лавова провінція"

msgid "TUTORIAL@LAVA@TUTORIAL_DESCRIPTION"
msgstr ""
"Ви відкрили лавову провінцію. Ви можете анексувати лавові провінції, щоб розширити свою імперію, але це негативно вплине на вашу "
"{GLOBAL.CityStabilityConcept.Hyperlink}. Тільки юніти з певними властивостями зможуть долати лавові перешкоди."

msgid "TUTORIAL@LAVA@TUTORIAL_INSTRUCTION"
msgstr ""
"Штрафу {GLOBAL.CityStabilityConcept.Hyperlink} можна уникнути, маючи або Підземну адаптацію або адаптацію Пустки.[br/][br/]Ви "
"можете побудувати {GLOBAL.MineConcept.Hyperlink} та {GLOBAL.ConduitConcept.Hyperlink} у цьому секторі.[br/][br/]Юніти "
"{GLOBAL.PROPERTIES.FLYING_MOVEMENT.Hyperlink} та {GLOBAL.PROPERTIES.FLOATING_MOVEMENT.Hyperlink} можуть перетинати цей сектор без "
"жодних проблем, але наземним юнітам знадобиться {GLOBAL.PROPERTIES.LAVA_WALK.Hyperlink}."

msgid "TUTORIAL@LOCATIONS@DESCRIPTION"
msgstr "Посібник: локації, доступні на мапі світу"

msgid "TUTORIAL@LOCATIONS@PAGE01@DESCRIPTION"
msgstr ""
"Ти знаходиш <<acc:c:{GLOBAL.NodeConcept.Hyperlink}>>, що надає додаткові переваги для [hyperlink,GLOBAL.ProvinceConcept]провінцій[/"
"hyperlink], в якій воно знаходиться."

msgid "TUTORIAL@LOCATIONS@PAGE01@INSTRUCTION"
msgstr ""
"Не всі нейтральні армії однакові. Армія зі штандартом вежі представляє вільне місто. Чорний штандарт із черепом позначає юніт "
"мародера, червоний штандарт із черепом вказує на армію, що належить до навали."

msgid "TUTORIAL@LOCATIONS@PAGE01@TITLE"
msgstr "Локації на мапі світу"

msgid "TUTORIAL@LOCATIONS@PAGE02@DESCRIPTION"
msgstr ""
"Джерела часто зайняті <<gen:c:m:{GLOBAL.MarauderConcept.Hyperlink}>>. Щоб отримати ресурс і користуватися його перевагами, тобі "
"потрібно спочатку позбутися його охоронців."

msgid "TUTORIAL@LOCATIONS@PAGE02@INSTRUCTION"
msgstr ""
"Не всі нейтральні армії однакові. Армія зі штандартом вежі представляє вільне місто. Чорний штандарт із черепом позначає юніт "
"мародера, червоний штандарт із черепом вказує на армію, що належить до навали."

msgid "TUTORIAL@LOCATIONS@PAGE02@TITLE"
msgstr "Мародерська гвардія"

msgid "TUTORIAL@LOCATIONS@TITLE"
msgstr "Розташування"

msgid "TUTORIAL@LOW_FOOD@DESCRIPTION"
msgstr "Посібник щодо провінції лави на карті світу."

msgid "TUTORIAL@LOW_FOOD@NAME"
msgstr "Розташування"

msgid "TUTORIAL@LOW_FOOD@PAGE01@DESCRIPTION"
msgstr ""
"Ти знаходиш <<acc:c:{GLOBAL.NodeConcept.Hyperlink}>>, що надає додаткові переваги для [hyperlink,GLOBAL.ProvinceConcept]провінцій[/"
"hyperlink], в якій воно знаходиться."

msgid "TUTORIAL@LOW_FOOD@PAGE01@INSTRUCTIONS"
msgstr ""
"Дозволь мені допомогти! Протягом гри з'являтимуться такі повідомлення, як це, з інформацією про те, як досягти перемоги у світі. "
"Деякі з них активуватимуть цілі, поставлені перед розвиваючоюся імперією.[br/][br/]Натисни на кнопку [questionmark/] у правому "
"нижньому куті, щоб отримати додаткові поради. Якщо захочеш переглянути якусь із порад знову, відкрий історію порад у тому ж меню, "
"натиснувши кнопку [checkmark/]. Ти можеш очистити або скинути ці повідомлення в меню Налаштувань."

msgid "TUTORIAL@LOW_GOLD@DESCRIPTION"
msgstr "Підручник з використання гіперпосилань та підказок"

msgid "TUTORIAL@LOW_GOLD@PAGE01@DESCRIPTION"
msgstr "Завжди можна знайти більше інформації на будь-яку тему, якщо вам це потрібно для прийняття рішення."

msgid "TUTORIAL@LOW_GOLD@PAGE01@INSTRUCTION"
msgstr ""
"У тексті часто зустрічаються <<m:c:{GLOBAL.HyperlinkConcept.Hyperlink}>>. Їх активація дозволяє переглядати важливу інформацію про "
"концепцію або систему. Активуйте підкреслене слово гіперпосилання вище, щоб відкрити підказку."

msgid "TUTORIAL@LOW_GOLD@TITLE"
msgstr "Гіперпосилання та підказки"

msgid "TUTORIAL@LOW_MANA@DESCRIPTION"
msgstr "Посібник щодо провінції лави на карті світу."

msgid "TUTORIAL@LOW_MANA@PAGE01@DESCRIPTION"
msgstr ""
"Ти знаходиш <<acc:c:{GLOBAL.NodeConcept.Hyperlink}>>, що надає додаткові переваги для [hyperlink,GLOBAL.ProvinceConcept]провінцій[/"
"hyperlink], в якій воно знаходиться."

msgid "TUTORIAL@LOW_MANA@PAGE01@INSTRUCTION"
msgstr ""
"Дозволь мені допомогти! Протягом гри з'являтимуться такі повідомлення, як це, з інформацією про те, як досягти перемоги у світі. "
"Деякі з них активуватимуть цілі, поставлені перед розвиваючоюся імперією.[br/][br/]Натисни на кнопку [questionmark/] у правому "
"нижньому куті, щоб отримати додаткові поради. Якщо захочеш переглянути якусь із порад знову, відкрий історію порад у тому ж меню, "
"натиснувши кнопку [checkmark/]. Ти можеш очистити або скинути ці повідомлення в меню Налаштувань."

msgid "TUTORIAL@LOW_MANA@TITLE"
msgstr "Лавова провінція"

msgid "TUTORIAL@LOW_STABILITY@DESCRIPTION"
msgstr ""
"Стабільність визначає рівень задоволеності жителів ваших міст. За винятком темних культур, які не піддаються штрафам за низьку "
"стабільність, рекомендується підтримувати високу стабільність."

msgid "TUTORIAL@LOW_STABILITY@NAME"
msgstr "Стабільність міста"

msgid "TUTORIAL@LOW_STABILITY@PAGE01@DESCRIPTION"
msgstr ""
"Ти зіткнувся з ворожим <<c:{GLOBAL.IndependentCityConcept.Hyperlink}>> — це незалежне місто, яке ти можеш підкорити, включити або "
"захопити."

msgid "TUTORIAL@LOW_STABILITY@PAGE01@INSTRUCTION"
msgstr ""
"Це місто веде з тобою [war/] [hyperlink,GLOBAL.IndependentCityWarConcept]війну[/hyperlink]. Ти можеш його завоювати, підкоривши, "
"або домовитися про мир, після чого місто отримає від тебе <<acc:c:{GLOBAL.DiplomaticTokenConcept.Hyperlink}>>, що дозволить "
"встановити з ним відносини."

msgid "TUTORIAL@MAGICMATERIALS@DESCRIPTION"
msgstr "Підручник з магічних матеріалів"

msgid "TUTORIAL@MAGICMATERIALS@PAGE01@DESCRIPTION"
msgstr ""
"Вибрано магічні матеріали. Вони мають різні ефекти, якщо їх отримати через приєднання або торгівлю. Зібравши всі матеріали певної "
"категорії, все імперія отримає потужний бонус."

msgid "TUTORIAL@MAGICMATERIALS@PAGE01@TITLE"
msgstr "Магічні матеріали"

msgid "TUTORIAL@MAGICMATERIALS@TITLE"
msgstr "Магічні матеріали"

msgid "TUTORIAL@MARAUDERS@DESCRIPTION"
msgstr "Навчальний посібник щодо армій на мапі світу"

msgid "TUTORIAL@MARAUDERS@TITLE"
msgstr "Одиниці та армії"

msgid "TUTORIAL@NEGOTIATION@DESCRIPTION"
msgstr "Посібник: переговори між правителями."

msgid "TUTORIAL@NEGOTIATION@PAGE01@DESCRIPTION"
msgstr ""
"Переговори дозволяють укладати з іншими <<ins:m:{GLOBAL.LeaderConcept.Hyperlink}>> угоди, вигідні для обох сторін. Ти можеш "
"запропонувати <<acc:c:m:{GLOBAL.TreatyConcept.Hyperlink}>>, що зміцнює зв'язок між імперіями, або торгівлю "
"[hyperlink,GLOBAL.TradeConcept], щоб отримати прибуток, або надіслати подарунок для покращення "
"[hyperlink,GLOBAL.EmpireRelationConcept] відносин."

msgid "TUTORIAL@NEGOTIATION@PAGE01@TITLE"
msgstr "Переговори"

msgid "TUTORIAL@NEGOTIATION@TITLE"
msgstr "Переговори"

msgid "TUTORIAL@NOTIFICATIONS@DESCRIPTION"
msgstr "Посібник: сповіщення та завершення ходу"

msgid "TUTORIAL@NOTIFICATIONS@PAGE01@DESCRIPTION"
msgstr "Переглядай сповіщення, щоб не пропустити важливі завдання. Після цього ти можеш безпечно завершити хід."

msgid "TUTORIAL@NOTIFICATIONS@PAGE01@INSTRUCTION"
msgstr ""
"[leftmousebutton/] Натисни на сповіщення праворуч, щоб переглянути їх або пропустити за допомогою [rightmousebutton/]. Пам'ятай, "
"що ти зможеш повернутися до них пізніше."

msgid "TUTORIAL@NOTIFICATIONS@PAGE01@INSTRUCTION_CONTROLLER"
msgstr ""
"[ci_righttrigger/] дозволяє переглядати сповіщення в Порядку їх отримання. [ci_dpadright/] відкриває список, а [ci_buttonx/] "
"дозволяє пропустити сповіщення."

msgid "TUTORIAL@NOTIFICATIONS@PAGE01@TITLE"
msgstr "Сповіщення та завершення ходу"

msgid "TUTORIAL@NOTIFICATIONS@TITLE"
msgstr "Сповіщення та завершення ходу"

msgid "TUTORIAL@OUTPOST@DESCRIPTION"
msgstr "Посібник: заснування нових форпостів"

msgid "TUTORIAL@OUTPOST@TITLE"
msgstr "Форпости"

msgid "TUTORIAL@OUTPOSTS@DESCRIPTION"
msgstr "Посібник: значення форпостів"

msgid "TUTORIAL@OUTPOSTS@PAGE01@DESCRIPTION"
msgstr ""
"Форпости зміцнюють контроль над регіоном. Ти можеш використовувати їх як безпечне місце для відновлення сил, для захоплення "
"прилеглих територій, а також для перетворення їх у міста."

msgid "TUTORIAL@OUTPOSTS@PAGE01@INSTRUCTION"
msgstr ""
"Форпости можуть бути засновані лише героями, що перебувають у центральній частині провінції.[br/][br/]У форпостах можна збирати "
"ресурси <<gen:m:{GLOBAL.LocationConcept.Hyperlink}>> у межах <<gen:c:{GLOBAL.DomainConcept.Hyperlink}>>, подібно до міст. Оборонні "
"можливості форпостів можна збільшити, що дозволить краще захищати захоплені землі."

msgid "TUTORIAL@OUTPOSTS@PAGE01@TITLE"
msgstr "Форпости"

msgid "TUTORIAL@OUTPOSTS@TITLE"
msgstr "Форпости"

msgid "TUTORIAL@OVERVIEWMAP@DESCRIPTION"
msgstr "Посібник: оглядову мапу"

msgid "TUTORIAL@OVERVIEWMAP@PAGE01@DESCRIPTION"
msgstr ""
"Ти потрапляєш на оглядову мапу. Під час дослідження світу ти зустрінеш багато загроз і можливостей — ці дані можуть допомогти "
"розробити відповідну стратегію."

msgid "TUTORIAL@OVERVIEWMAP@PAGE01@INSTRUCTION"
msgstr "Віддалення камери дозволить повернутися до нормального виду."

msgid "TUTORIAL@OVERVIEWMAP@PAGE01@TITLE"
msgstr "Оглядова мапа"

msgid "TUTORIAL@OVERVIEWMAP@TITLE"
msgstr "Оглядова мапа"

msgid "TUTORIAL@PILLAGING@DESCRIPTION"
msgstr "Посібник: грабування провінцій та руїн"

msgid "TUTORIAL@PILLAGING@PAGE01@DESCRIPTION"
msgstr ""
"Перебуваючи на територіях, що належать твоєму ворогу, ти зможеш грабувати його <<acc:c:"
"{GLOBAL.ProvinceImprovementConcept.Hyperlink}>> для отримання ресурсів."

msgid "TUTORIAL@PILLAGING@PAGE01@INSTRUCTION"
msgstr ""
"Перемісти армію на <<acc:c:{GLOBAL.ProvinceImprovementConcept.Hyperlink}>> та вибери кнопку 'Пограбувати покращення провінції'."

msgid "TUTORIAL@PILLAGING@PAGE01@TITLE"
msgstr "Грабування провінцій"

msgid "TUTORIAL@PILLAGING@TITLE"
msgstr "Грабування та руїни"

msgid "TUTORIAL@PRISONCRYPT@DESCRIPTION"
msgstr "Посібник: в'язницю та крипту у тронному місті"

msgid "TUTORIAL@PRISONCRYPT@PAGE01@DESCRIPTION"
msgstr ""
"Переможений герой потрапляє до твоєї в'язниці або крипти. Ти можеш передати його законним власникам, отримавши за це його "
"спорядження, або залишити його в ув'язненні на певний час."

msgid "TUTORIAL@PRISONCRYPT@PAGE01@INSTRUCTION"
msgstr "Поліпшення башти чарівника в тронному місті дозволить відкрити додаткові переваги в'язниці та крипти."

msgid "TUTORIAL@PRISONCRYPT@PAGE01@TITLE"
msgstr "В'язниця та крипта"

msgid "TUTORIAL@PRISONCRYPT@TITLE"
msgstr "В'язниця та крипта"

msgid "TUTORIAL@QUESTOVERVIEW@DESCRIPTION"
msgstr "Самовчитель щодо панелі завдань"

msgid "TUTORIAL@QUESTOVERVIEW@PAGE_01@DESCRIPTION"
msgstr ""
"Це панель завдань. Тут ти можеш перевірити свій прогрес щодо умов перемоги, завдань і <<ins:c:m:"
"{GLOBAL.CallToArmsConcept.Hyperlink}>>."

msgid "TUTORIAL@QUESTOVERVIEW@PAGE_01@INSTRUCTION"
msgstr ""
"Щоб створити наказ для інших [hyperlink,GLOBAL.LeaderConcept.Hyperlink]правителів[/hyperlink], вибери кнопку Створити наказ. Ти "
"можеш створювати накази лише для правителів та <<acc:c:m:{GLOBAL.IndependentCityConcept.Hyperlink}>>, з якими воюєш."

msgid "TUTORIAL@QUESTOVERVIEW@TITLE"
msgstr "Панель завдань"

msgid "TUTORIAL@RALLYOFLIEGES@DESCRIPTION"
msgstr "Самовчитель щодо збору васалів"

msgid "TUTORIAL@RALLYOFLIEGES@PAGE00@DESCRIPTION"
msgstr ""
"У тебе є щось доступне в <<loc:c:{GLOBAL.RequestMilitaryAidConcept.Hyperlink}>>. Відкрий екран збору васалів, натиснувши кнопку із "
"символом труби на верхній панелі."

msgid "TUTORIAL@RALLYOFLIEGES@PAGE00@OBJECTIVE"
msgstr "Відкрий екран збору васалів"

msgid "TUTORIAL@RALLYOFLIEGES@PAGE01@DESCRIPTION"
msgstr ""
"Відкрито огляд збору васалів. Звідси ти можеш відправляти армії <<gen:c:m:{GLOBAL.PvEVassalConcept.Hyperlink}>> і підкорених "
"<<gen:c:m:{GLOBAL.AncientWonderConcept.Hyperlink}>> на збір. Кількість військ залежить від кількості твоїх васалів і стародавніх "
"чудес."

msgid "TUTORIAL@RALLYOFLIEGES@PAGE01@INSTRUCTION"
msgstr ""
"Збори васалів відбуваються регулярно. Їх частоту можна прискорити, використовуючи [gold/] "
"[hyperlink,GLOBAL.MovePointConcept]золота[/hyperlink].[br/][br/]Ти можеш повернутися до збору васалів у будь-який момент перед "
"наступним збором, щоб завербувати більше військ."

msgid "TUTORIAL@RALLYOFLIEGES@PAGE01@TITLE"
msgstr "Збір васалів"

msgid "TUTORIAL@RALLYOFLIEGES@TITLE"
msgstr "Збір васалів"

msgid "TUTORIAL@RESEARCH@DESCRIPTION"
msgstr "Самовчитель щодо вибору книг і дослідження навичок"

msgid "TUTORIAL@RESEARCH@PAGE00@INSTRUCTION"
msgstr "Відкрий екран досліджень магічних знань за допомогою кнопки у верхньому лівому куті екрану."

msgid "TUTORIAL@RESEARCH@PAGE00@INSTRUCTION_CONTROLLER"
msgstr "Відкрий екран досліджень магічних знань, відкривши радіальне меню за допомогою кнопки [ci_buttony/] і вибравши іконку книги."

msgid "TUTORIAL@RESEARCH@PAGE00@OBJECTIVE"
msgstr "Відкрий дослідження магічних знань"

msgid "TUTORIAL@RESEARCH@PAGE01@DESCRIPTION"
msgstr ""
"Дослідження магічних знань дозволяє вивчати нові [hyperlink,GLOBAL.SpellConcept]закляття[/hyperlink] та отримувати нові юніти. "
"Початкові навички, які можна розблокувати в рамках дослідження магічних знань, залежать від вибраної культури фракції та <<gen:c:"
"{GLOBAL.TomeConcept.Hyperlink}>>."

msgid "TUTORIAL@RESEARCH@PAGE01@INSTRUCTION"
msgstr "Вибери навичку, яка здається тобі найбільш корисною."

msgid "TUTORIAL@RESEARCH@PAGE01@OBJECTIVE"
msgstr "Вибери навичку"

msgid "TUTORIAL@RESEARCH@PAGE01@TITLE"
msgstr "Дослідження магічних знань"

msgid "TUTORIAL@RESEARCH@PAGE02@DESCRIPTION"
msgstr ""
"З часом твоє імперія буде досліджувати навички, використовуючи доходи від {GLOBAL.KnowledgeConcept.Hyperlink}. Після завершення "
"дослідження доведеться обирати між трьома новими навичками."

msgid "TUTORIAL@RESEARCH@PAGE02@INSTRUCTION"
msgstr "Відкрий екран досліджень магічних знань за допомогою кнопки у верхньому лівому куті екрану."

msgid "TUTORIAL@RESEARCH@TITLE"
msgstr "Дослідження"

msgid "TUTORIAL@RULER_LOST@DESCRIPTION"
msgstr "Посібник: можливості героїв та способи відкриття більшої кількості можливостей."

msgid "TUTORIAL@RULER_LOST@PAGE01@DESCRIPTION"
msgstr ""
"Обрано героя. Герої керують арміями у світі і лише вони можуть досліджувати [hyperlink,GLOBAL.AncientWonderConcept]стародавні "
"чудеса[/hyperlink], будувати [hyperlink,GLOBAL.OutpostConcept]форпости[/hyperlink] та починати "
"[hyperlink,GLOBAL.SiegeConcept]облоги[/hyperlink]."

msgid "TUTORIAL@RULER_LOST@PAGE01@INSTRUCTIONS"
msgstr ""
"Підвищуй рівень героїв, використовуючи їх у [hyperlink,GLOBAL.CombatConcept]битвах[/hyperlink]. Також можна оснащувати їх "
"знайденими у скарбах предметами."

msgid "TUTORIAL@RULER_LOST@TITLE"
msgstr "Правителі та герої"

msgid "TUTORIAL@SEALS@DESCRIPTION"
msgstr "Печатки — самовчитель"

msgid "TUTORIAL@SEALS@PAGE01@DESCRIPTION"
msgstr ""
"Ти натрапляєш на печатки. Це споруди, які можна захопити, щоб досягти <<gen:c:{GLOBAL.SealsVictoryConcept.Hyperlink}>>. Вони "
"охороняються могутніми захисниками, які атакуватимуть усіх, хто спробує зайняти їх печатки."

msgid "TUTORIAL@SEALS@PAGE01@INSTRUCTION"
msgstr ""
"У світі існує багато печаток, і кожна, яку ти захопиш, надає по {amount1} очок за кожен хід. Перша "
"[hyperlink,GLOBAL.EmpireConcept]імперії[/hyperlink], яка здобуде визначену кількість очок, переможе. Що {amount2} [turn/], будуть "
"з'являтися захисники печаток, намагаючись повернути їх. Чим ближче ти до перемоги, тим сильнішими вони будуть, тому готуйся до "
"боротьби."

msgid "TUTORIAL@SEALS@PAGE01@TITLE"
msgstr "Перемога через печатки"

msgid "TUTORIAL@SEALS@TITLE"
msgstr "Печатки"

msgid "TUTORIAL@SIEGING@DESCRIPTION"
msgstr "Самовчитель щодо початку облоги міст"

msgid "TUTORIAL@SIEGING@PAGE01@DESCRIPTION"
msgstr ""
"Ви починаєте <<c:{GLOBAL.SiegeConcept}>> цього міста. Кількість ходів, необхідних для прориву через стіни, залежатиме від <<gen:c:"
"{GLOBAL.FortificationHealthConcept}>>.[br/]Атака може призвести до великих втрат, але захоплене місто є важливим ресурсом."

msgid "TUTORIAL@SIEGING@PAGE01@INSTRUCTION"
msgstr ""
"Щоб вплинути на тривалість облоги, ви можете вибрати <<c:m:{GLOBAL.SiegeProjectConcept.Hyperlink}>>, які знаходяться в лівому "
"нижньому куті екрану облоги. Вони дозволяють прискорити облогу або знищити захист ворога, щоб полегшити майбутню битву."

msgid "TUTORIAL@SIEGING@PAGE01@TITLE"
msgstr "Початок облоги"

msgid "TUTORIAL@SIEGING@TITLE"
msgstr "Облоги"

msgid "TUTORIAL@SPECIALIMPROVEMENTS@DESCRIPTION"
msgstr "Підручник про спеціальні покращення"

msgid "TUTORIAL@SPECIALIMPROVEMENTS@PAGE00@INSTRUCTION"
msgstr "У містах, після вибору списку виробництва, можна будувати спеціальні покращення."

msgid "TUTORIAL@SPECIALIMPROVEMENTS@PAGE01@DESCRIPTION"
msgstr ""
"Ви збираєтесь збудувати спеціальне покращення провінції, яке вимагає вже наявного покращення. Таке покращення дає кращі економічні "
"бонуси та часто впливає на сусідні провінції."

msgid "TUTORIAL@SPECIALIMPROVEMENTS@PAGE01@INSTRUCTION"
msgstr "Оберіть провінцію, в якій ви хочете збудувати спеціальне покращення."

msgid "TUTORIAL@SPECIALIMPROVEMENTS@PAGE01@TITLE"
msgstr "Спеціальні покращення"

msgid "TUTORIAL@SPECIALIMPROVEMENTS@TITLE"
msgstr "Спеціальні покращення"

msgid "TUTORIAL@SPELLCASTING@DESCRIPTION"
msgstr "Підручник про підготовку та застосування заклять"

msgid "TUTORIAL@SPELLCASTING@PAGE00@INSTRUCTION"
msgstr "Закляття доступні після вибору синьої кнопки поруч з лідером у правому нижньому куті."

msgid "TUTORIAL@SPELLCASTING@PAGE00@INSTRUCTION_CONTROLLER"
msgstr "Закляття доступні після відкриття радіального меню кнопкою [ci_buttony/] і вибору іконки зірки."

msgid "TUTORIAL@SPELLCASTING@PAGE00@OBJECTIVE"
msgstr "Відкрийте список заклять"

msgid "TUTORIAL@SPELLCASTING@PAGE01@DESCRIPTION"
msgstr ""
"Це список ваших заклять. Тут ви можете застосовувати різні закляття, які матимуть позитивний вплив на ваші юніти та міста або "
"негативний вплив на ворогів."

msgid "TUTORIAL@SPELLCASTING@PAGE01@INSTRUCTION"
msgstr ""
"Існують два типи заклять. Стратегічні закляття можна застосовувати тільки на [hyperlink,GLOBAL.WorldMapConcept]мапі світу[/"
"hyperlink], а тактичні закляття – під час [hyperlink,GLOBAL.CombatConcept]бою[/hyperlink]. Деякі закляття, такі як виклики або "
"чари, підтримуються, що пов'язано з витратами <<gen:c:{GLOBAL.SpellUpkeepConcept.Hyperlink}>>.[br/][br/]Щоб скасувати активне "
"закляття, перейдіть на вкладку Активні, де ви знайдете інформацію про всі застосовані закляття."

msgid "TUTORIAL@SPELLCASTING@PAGE01@TITLE"
msgstr "Закляття"

msgid "TUTORIAL@SPELLCASTING@TITLE"
msgstr "Використання заклять"

msgid "TUTORIAL@STABILITY@DESCRIPTION"
msgstr ""
"Стабільність визначає рівень задоволеності жителів ваших міст. За винятком темних культур, які не піддаються штрафам за низьку "
"стабільність, рекомендується підтримувати високу стабільність."

msgid "TUTORIAL@STABILITY@INSTRUCTIONS"
msgstr ""
"Інформацію про стабільність міста можна знайти, навівши курсор на символ [happiness/] маски біля назви міста в інтерфейсі міста."

msgid "TUTORIAL@STABILITY@TITLE"
msgstr "Стабільність міста"

msgid "TUTORIAL@THRALLS@DESCRIPTION"
msgstr "Раби — підручник"

msgid "TUTORIAL@THRALLS@TITLE"
msgstr "[thralls/] Раби"

msgid "TUTORIAL@THRALLS_PAGE01@DESCRIPTION"
msgstr ""
"Раби — це ресурс, який пасивно отримується після перемог у битвах. Їх можна використовувати пізніше для виконання <<gen:c:m:"
"{GLOBAL.SpellConcept.Hyperlink}>> ритуальних заклять."

msgid "TUTORIAL@THRALLS_PAGE01@INSTRUCTIONS"
msgstr "Ймовірність захоплення рабів і їх кількість зростає разом із силою та чисельністю ворогів."

msgid "TUTORIAL@THRONECITY@DESCRIPTION"
msgstr "Тронне місто — підручник."

msgid "TUTORIAL@THRONECITY@PAGE01@DESCRIPTION"
msgstr ""
"Обрано <<c:{GLOBAL.ThroneCityConcept.Hyperlink}>>, тобто найважливіше місто [hyperlink,GLOBAL.EmpireConcept]імперії[/hyperlink]."

msgid "TUTORIAL@THRONECITY@PAGE01@INSTRUCTIONS"
msgstr ""
"{VarThroneCity} — це ваше поточне тронне місто. Саме тут ви можете побудувати <<acc:c:{GLOBAL.WizardTowerConcept.Hyperlink}>>, а "
"також після [hyperlink,GLOBAL.RulerVoidConcept]смерті[/hyperlink] правителя ваш лідер з'явиться тут знову. Втрата тронного міста "
"та [hyperlink,GLOBAL.LeaderConcept]Володаря[/hyperlink] означає поразку. Ви можете перенести тронне місто до будь-якого іншого "
"міста на екрані Інформації про місто."

msgid "TUTORIAL@THRONECITY@TITLE"
msgstr "Тронне місто"

msgid "TUTORIAL@TOMEOFWONDERS@DESCRIPTION"
msgstr "Інформацію про різні юніти, механіки чи закляття можна знайти в енциклопедії."

msgid "TUTORIAL@TOMEOFWONDERS@INSTRUCTIONS"
msgstr "Кнопка, позначена символом [tow/], знаходиться у верхньому правому куті екрана."

msgid "TUTORIAL@TOMEOFWONDERS@INSTRUCTIONS_CONTROLLER"
msgstr "Щоб відкрити екран енциклопедії, натисніть [ci_buttony/], що відкриє кругове меню, а потім виберіть кнопку [tow/]."

msgid "TUTORIAL@TOMEOFWONDERS@TITLE"
msgstr "Енциклопедія"

msgid "TUTORIAL@TOMESELECTION@DESCRIPTION"
msgstr "Підручник з вибору книг та отримання таємних знань"

msgid "TUTORIAL@TOMESELECTION@PAGE01@DESCRIPTION"
msgstr ""
"Вам вдалося отримати достатню кількість таємних умінь, щоб обрати нову книгу та додати її до бібліотеки досліджень. Додаткові "
"книги збільшують кількість доступних таємних умінь."

msgid "TUTORIAL@TOMESELECTION@PAGE01@INSTRUCTION"
msgstr ""
"Щоразу, коли ви розблоковуєте книгу, ви збільшуєте вартість {GLOBAL.KnowledgeConcept.Hyperlink} усіх умінь у майбутніх книгах."

msgid "TUTORIAL@TOMESELECTION@PAGE01@TITLE"
msgstr "Вибір книги"

msgid "TUTORIAL@TOMESELECTION@PAGE02@DESCRIPTION"
msgstr ""
"Вибір двох <<gen:c:{GLOBAL.TomeConcept.Hyperlink}>> будь-якого рівня відкриє нові, потужніші книги. Для розблокування книг вищого "
"рівня також потрібна велика кількість певної <<gen:c:{GLOBAL.AffinityConcept.Hyperlink}>>."

msgid "TUTORIAL@TOMESELECTION@PAGE02@INSTRUCTION"
msgstr ""
"Кожна книга містить закляття, юніти та інші покращення, які можна дослідити. Ознайомтеся з резюме і виберіть книгу, яка відповідає "
"вашому стилю гри."

msgid "TUTORIAL@TOMESELECTION@PAGE02@OBJECTIVE"
msgstr "Виберіть нову книгу"

msgid "TUTORIAL@TOMESELECTION@PAGE02@SUMMARY"
msgstr ""
"Вибір двох <<gen:c:{GLOBAL.TomeConcept.Hyperlink}>> будь-якого рівня відкриє нові, потужніші книги. Для розблокування книг вищого "
"рівня також потрібна велика кількість певної <<gen:c:{GLOBAL.AffinityConcept.Hyperlink}>>."

msgid "TUTORIAL@TOMESELECTION@PAGE02@TITLE"
msgstr "Вибір книги"

msgid "TUTORIAL@TOMESELECTION@TITLE"
msgstr "Вибір книги"

msgid "TUTORIAL@TOOLTIPS@DESCRIPTION"
msgstr "Підручник з використання гіперпосилань та підказок"

msgid "TUTORIAL@TOOLTIPS@PAGE01@DESCRIPTION"
msgstr "Завжди можна знайти більше інформації на будь-яку тему, якщо вам це потрібно для прийняття рішення."

msgid "TUTORIAL@TOOLTIPS@PAGE01@INSTRUCTION"
msgstr ""
"У тексті часто зустрічаються <<m:c:{GLOBAL.HyperlinkConcept.Hyperlink}>>. Їх активація дозволяє переглядати важливу інформацію про "
"концепцію або систему. Активуйте підкреслене слово гіперпосилання вище, щоб відкрити підказку."

msgid "TUTORIAL@TOOLTIPS@PAGE01@INSTRUCTION_CONTROLLER"
msgstr ""
"У тексті часто зустрічаються <<m:c:{GLOBAL.HyperlinkConcept.Hyperlink}>>. Їх активація дозволяє переглядати важливу інформацію про "
"концепцію або систему. Наведіть курсор на підкреслене слово гіперпосилання вище і натисніть [ci_options/], щоб переглянути "
"підказку."

msgid "TUTORIAL@TOOLTIPS@PAGE01@TITLE"
msgstr "Гіперпосилання та підказки"

msgid "TUTORIAL@TOOLTIPS@TITLE"
msgstr "Гіперпосилання та підказки"

msgid "TUTORIAL@TRANSFORMATION@DESCRIPTION"
msgstr "Трансформації раси — підручник."

msgid "TUTORIAL@TRANSFORMATION@TITLE"
msgstr "Трансформації"

msgid "TUTORIAL@TRANSFORMATIONS@PAGE01@DESCRIPTION"
msgstr ""
"Трансформації рас — це дорогі, але потужні закляття. Вони змінюють расу <<gen:c:{GLOBAL.KeeperConcept.Hyperlink}>> та надають їм "
"потужні постійні бонуси."

msgid "TUTORIAL@TRANSFORMATIONS@PAGE01@INSTRUCTIONS"
msgstr ""
"Кожна раса може мати лише одну значну трансформацію, що виключає інші. Незначні трансформації є слабшими, але не мають таких "
"обмежень."

msgid "TUTORIAL@TRANSFORMATIONS@PAGE01@INSTRUCTIONS_CONTROLLER"
msgstr ""
"Кожна раса може мати лише одну значну трансформацію, що виключає інші. Незначні трансформації є слабшими, але не мають таких "
"обмежень."

msgid "TUTORIAL@UNDERGROUND@DESCRIPTION"
msgstr "Підручник щодо підземель"

msgid "TUTORIAL@UNDERGROUND@PAGE01@DESCRIPTION"
msgstr ""
"Це <<c:{GLOBAL.UndergroundConcept.Hyperlink}>>. Всередині знаходяться корисні копалини та <<c:"
"{GLOBAL.AncientWonderConcept.Hyperlink}>>. Поки у вас є доступ до переходу, ви можете вільно переміщуватися між поверхнею та "
"шахтами."

msgid "TUTORIAL@UNDERGROUND@PAGE01@INSTRUCTION"
msgstr ""
"{GLOBAL.EmpireSkillConcept.Hyperlink} <<c:{GLOBAL.ExcavationConcept.Hyperlink}>> стає у пригоді під час переміщення під землею, "
"оскільки дозволяє видаляти ґрунт для розкопок. Це допоможе знайти скарби або армії мародерів, що готуються до атаки або грабування "
"ваших міст. Раси з рисою пристосування до підземель краще почуваються під землею. [br/] Щоб покинути підземелля, "
"[leftmousebutton/] натисніть кнопку зміни шару у правому верхньому куті."

msgid "TUTORIAL@UNDERGROUND@PAGE01@INSTRUCTION_CONTROLLER"
msgstr ""
"{GLOBAL.EmpireSkillConcept.Hyperlink} <<c:{GLOBAL.ExcavationConcept.Hyperlink}>> стає у пригоді під час переміщення під землею, "
"оскільки дозволяє видаляти ґрунт для розкопок. Це допоможе знайти скарби або армії мародерів, що готуються до атаки або грабування "
"ваших міст. Раси з рисою пристосування до підземель краще почуваються під землею. [br/] Щоб покинути підземелля, натисніть "
"[ci_lefttrigger/]."

msgid "TUTORIAL@UNDERGROUND@PAGE01@TITLE"
msgstr "Підземелля"

msgid "TUTORIAL@UNDERGROUND@PAGE02@DESCRIPTION"
msgstr ""
"Коли <<c:{GLOBAL.ProvinceConcept.Hyperlink}>>, що містить підземний перехід, буде "
"[hyperlink,GLOBAL.ProvinceAnnexationConcept]приєднано[/hyperlink], місто зможе використовувати перехід для розширення своєї "
"території на інший шар."

msgid "TUTORIAL@UNDERGROUND@PAGE02@INSTRUCTION"
msgstr "Деякі <<c:m:{GLOBAL.MagicMaterialConcept.Hyperlink}>> частіше зустрічаються під землею, а інші — на поверхні."

msgid "TUTORIAL@UNDERGROUND@PAGE02@TITLE"
msgstr "Експансія через переходи"

msgid "TUTORIAL@UNDERGROUND@TITLE"
msgstr "Підземелля"

msgid "TUTORIAL@UNITPANEL@DESCRIPTION"
msgstr "Підручник щодо панелі юніти, яка містить інформацію про кожну юніта."

msgid "TUTORIAL@UNITPANEL@PAGE01@DESCRIPTION"
msgstr ""
"Після вибору юніти відкривається її панель. Тут міститься інформація про неї, її здібності, а також вразливості, які можна "
"використати."

msgid "TUTORIAL@UNITPANEL@PAGE01@INSTRUCTION"
msgstr "Щоб дізнатися більше про активні та пасивні здібності військ і їхні типи, активуйте іконки."

msgid "TUTORIAL@UNITPANEL@PAGE01@TITLE"
msgstr "Панель одиниць"

msgid "TUTORIAL@UNITPANEL@TITLE"
msgstr "Інформація про юніта"

msgid "TUTORIAL@UNITTIER@DESCRIPTION"
msgstr ""
"Будь обережний! Ти вступаєш у бій з одиницею вищого рівня. [hyperlink,GLOBAL.UnitTierConcept]Рівні одиниць[/hyperlink] "
"відображаються в лівому нижньому куті портретів військ на панелі армії."

msgid "TUTORIAL@UNITTIER@INSTRUCTION"
msgstr ""
"Чим вищий рівень юніти, тим вона небезпечніша. [rightmousebutton/] Клацни правою кнопкою миші на портрет юніти, щоб детально її "
"оглянути і відповідно підготуватися — або переглянь своє рішення щодо вступу в бій."

msgid "TUTORIAL@UNITTIER@INSTRUCTION_CONTROLLER"
msgstr ""
"Чим вищий рівень юніти, тим небезпечнішою вона є. Натисни [ci_rightbumper/], щоб перейти до панелі армії, а потім натисни "
"[ci_buttony/] на будь-якій юніти, щоб детально її оглянути і підготуватися — або переглянь своє рішення щодо вступу в бій."

msgid "TUTORIAL@UNITTIER@SUMMARY"
msgstr "Посібник по бусту будівництва"

msgid "TUTORIAL@UNITTIER@TITLE"
msgstr "Рівні одиниць"

msgid "TUTORIAL@VICOTRY@PAGE01@INSTRUCTION"
msgstr ""
"Перемогу можна здобути кількома способами — через експансію, магію, результат або військові дії.[br/][br/]Можеш клацнути на будь-"
"який тип перемоги, щоб перевірити умови та досягнутий прогрес."

msgid "TUTORIAL@VICTORY@DESCRIPTION"
msgstr "Підручник щодо типів умов перемоги"

msgid "TUTORIAL@VICTORY@PAGE01@DESCRIPTION"
msgstr "Існує багато шляхів досягнення панування у світі. Один із них — це війна, але також можна обрати більш мирні підходи."

msgid "TUTORIAL@VICTORY@PAGE01@TITLE"
msgstr "Умови перемоги"

msgid "TUTORIAL@VICTORY@TITLE"
msgstr "Умови перемоги"

msgid "TUTORIAL@WARBOUNTIES@DESCRIPTION"
msgstr "Підручник щодо військових наказів"

msgid "TUTORIAL@WARBOUNTIES@PAGE01@DESCRIPTION"
msgstr ""
"Тепер ти можеш створити <<acc:c:m:{GLOBAL.CallToArmsConcept.Hyperlink}>> із проханням про допомогу у війні! Накази — це завдання, "
"створені [hyperlink,GLOBAL.LeaderConcept.Hyperlink]правителів[/hyperlink], які пропонуються іншим правителям в обмін на винагороду."

msgid "TUTORIAL@WARBOUNTIES@PAGE01@INSTRUCTION"
msgstr ""
"Перейди до [scorevictory/] панелі завдань у верхньому лівому куті, щоб створити наказ. Там ти також знайдеш свої накази та накази "
"інших правителів, а також ті, які ти прийняв.[br/][br/]Накази можуть бути спрямовані на "
"[hyperlink,GLOBALPROPERTIES.CityConcept]міста[/hyperlink] та важливі будівлі, що належать ворогам."

msgid "TUTORIAL@WARBOUNTIES@PAGE01@TITLE"
msgstr "Військові накази"

msgid "TUTORIAL@WELCOME@DESCRIPTION"
msgstr "Вітальне повідомлення"

msgid "TUTORIAL@WELCOME@PAGE01@DESCRIPTION"
msgstr "Наближається нова Епоха Чудес."

msgid "TUTORIAL@WELCOME@PAGE01@INSTRUCTION"
msgstr ""
"Дозволь мені допомогти! Протягом гри з'являтимуться такі повідомлення, як це, з інформацією про те, як досягти перемоги у світі. "
"Деякі з них активуватимуть цілі, поставлені перед розвиваючоюся імперією.[br/][br/]Натисни на кнопку [questionmark/] у правому "
"нижньому куті, щоб отримати додаткові поради. Якщо захочеш переглянути якусь із порад знову, відкрий історію порад у тому ж меню, "
"натиснувши кнопку [checkmark/]. Ти можеш очистити або скинути ці повідомлення в меню Налаштувань."

msgid "TUTORIAL@WELCOME@PAGE01@INSTRUCTION_CONTROLLER"
msgstr ""
"Дозволь мені допомогти! Протягом гри з'являтимуться такі повідомлення, як це, з інформацією про те, як досягти перемоги у світі. "
"Деякі з них активуватимуть цілі, поставлені перед розвиваючоюся імперією.[br/][br/]Переглянь список Порад, відкривши радіальне "
"меню за допомогою кнопки [ci_buttony/], а потім вибери опцію з порадами ?. Якщо захочеш переглянути якусь із порад знову, відкрий "
"історію порад у тому ж меню, натиснувши кнопку [ci_rightbumper/]."

msgid "TUTORIAL@WELCOME@PAGE01@TITLE"
msgstr "Ласкаво просимо в Age of Wonders!"

msgid "TUTORIAL@WELCOME@TITLE"
msgstr "Ласкаво просимо до Age of Wonders"

msgid "TUTORIAL@WORLD_MAP_TUTORIAL@DESCRIPTION"
msgstr "Регенерація на мапі світу"

msgid "TUTORIAL@WORLD_MAP_TUTORIAL@PAGE01@DESCRIPTION"
msgstr ""
"Вибрано магічні матеріали. Вони мають різні ефекти, якщо їх отримати через приєднання або торгівлю. Зібравши всі матеріали певної "
"категорії, все імперія отримає потужний бонус."

msgid "TUTORIAL@WORLD_MAP_TUTORIAL@PAGE01@INSTRUCTION"
msgstr ""
"Статус імперії здобувається головним чином через будівництво етапів [hyperlink,GLOBAL.WizardTowerConcept]вежі чарівника[/"
"hyperlink] у [GLOBAL.ThroneCityConcept]столиці[/hyperlink] або приєднання <<m:acc:c:{GLOBAL.AncientWonderConcept.Hyperlink}>>."

msgid "TUTORIAL@WORLD_MAP_TUTORIAL@TITLE"
msgstr "Регенерація на мапі світу"

msgid "UNITPROPERTIES@ACCURACY@DESCRIPTION"
msgstr ""
"+{ACCURACY_INCREASE_BOOST>ResolvedAccuracyModifier}% [hyperlink,GLOBAL.AccuracyConcept]влучності[/hyperlink] атак на "
"[hyperlink,GLOBAL.RangedConcept]дистанції[/hyperlink] і [hyperlink,GLOBAL.MagicConcept]магічних[/hyperlink]."

msgid "UNITPROPERTIES@ACCURACY@MODIFIER@NAME"
msgstr "Підвищена точність"

msgid "UNITPROPERTIES@ACCURACY@NAME"
msgstr "+{ACCURACY_INCREASE_BOOST>ResolvedAccuracyModifier}% до точності"

msgid "UNITPROPERTIES@ANIMAL_SLAYER@DESCRIPTION"
msgstr ""
"Основні атаки завдають +{ANIMAL_SLAYER_DAMAGE>ResolvedMultiplier}% шкоди [hyperlink,GLOBAL.Properties.Animal]тваринам[/hyperlink]."

msgid "UNITPROPERTIES@ANIMAL_SLAYER@NAME"
msgstr "Мисливець на тварин"

msgid "UNITPROPERTIES@ANTI_CAVALRY@DESCRIPTION"
msgstr "Юніт завдає +{damage}% шкоди ворожій кавалерії."

msgid "UNITPROPERTIES@ANTI_CAVALRY@NAME"
msgstr "Протидія кавалерії"

msgid "UNITPROPERTIES@ARMY_MOUNTAIN_WALK@DESCRIPTION"
msgstr "Усі юніти в армії отримують стан: <<c:{GLOBAL.PROPERTIES.MOUNTAIN_WALK.Hyperlink}>>."

msgid "UNITPROPERTIES@ARMY_MOUNTAIN_WALK@NAME"
msgstr "Скелелазіння армії"

msgid "UNITPROPERTIES@ARMY_RECUPERATION@DESCRIPTION"
msgstr ""
"Усі юніти в армії лікуються на {ARMY_RECUPERATION_STAT_BONUS>BONUS>Regen} [hyperlink,GLOBAL.HitPointConcept][hp/] здоров'я[/"
"hyperlink] на кожному [turn/] [hyperlink,GLOBAL.TurnConcept]ході[/hyperlink] на [hyperlink,GLOBAL.WorldMapConcept]світовій мапі[/"
"hyperlink].[br/][br/]Не накопичується."

msgid "UNITPROPERTIES@ARMY_RECUPERATION@NAME"
msgstr "Відновлення армії"

msgid "UNITPROPERTIES@ARMY_SIEGE_BREAKERS@DESCRIPTION"
msgstr "Надає <<acc:c{GLOBAL.PROPERTIES.SIEGE_BREAKER.Hyperlink}>> усім юнітам в армії."

msgid "UNITPROPERTIES@ARMY_SIEGE_BREAKERS@NAME"
msgstr "Майстер облоги"

msgid "UNITPROPERTIES@ARMY_TRAINER@DESCRIPTION"
msgstr ""
"Усі юніти в армії отримують: +{ARMY_EXPERIENCE_XP_BONUS>ResolvedProportion}% очок [happiness/] "
"[hyperlink,GLOBAL.ExperienceConcept]досвіду[/hyperlink]."

msgid "UNITPROPERTIES@ARMY_TRAINER@NAME"
msgstr "Тренер армії"

msgid "UNITPROPERTIES@ARMY_UPKEEP@DESCRIPTION"
msgstr ""
"Вартість утримання {GLOBAL.UnitUpkeepConcept.Hyperlink} усіх юнітів в армії зменшена на "
"{ARMY_UPKEEP_MODIFIER>ResolvedUpkeepModifier}%."

msgid "UNITPROPERTIES@ARMY_UPKEEP@NAME"
msgstr "Утримання армії"

msgid "UNITPROPERTIES@ASPIRANT_KNIGHT@DESCRIPTION"
msgstr ""
"Коли цей юніт отримує Легендарний ранг, він натомість отримує підвищення до {GLOBAL.UNITS.KNIGHT.Hyperlink}[br/][br/]Потрібно "
"побудувати феодальну Ратушу 4-го рівня в Імперії."

msgid "UNITPROPERTIES@ASPIRANT_KNIGHT@NAME"
msgstr "Претендент: Лицар"

msgid "UNITPROPERTIES@ASPIRANT_LIEGE_GUARD@DESCRIPTION"
msgstr ""
"Коли цей юніт отримує Легендарний ранг, він натомість отримує підвищення до {GLOBAL.UNITS.LIEGE_GUARD.Hyperlink}[br/][br/]Потрібно "
"побудувати феодальну Ратушу 3-го рівня в Імперії."

msgid "UNITPROPERTIES@ASPIRANT_LIEGE_GUARD@NAME"
msgstr "Претендент: Страж васала"

msgid "UNITPROPERTIES@ASPIRANT_LONGBOW@DESCRIPTION"
msgstr ""
"Коли цей юніт отримує Легендарний ранг, він натомість отримує підвищення до {GLOBAL.UNITS.LONGBOW.Hyperlink}[br/][br/]Потрібно "
"побудувати феодальну Ратушу 3-го рівня в Імперії."

msgid "UNITPROPERTIES@ASPIRANT_LONGBOW@NAME"
msgstr "Претендент: Довгий лук"

msgid "UNITPROPERTIES@ATTUNEMENT_FORTUNE@DESCRIPTION"
msgstr ""
"Кожного разу, коли союзник використовує закляття, цей юніт отримує:[bulletlist][bullet/]{stacks} стеків <<acc:c:"
"{GLOBAL.PROPERTIES.FORTUNE.Hyperlink}>>[/bulletlist]"

msgid "UNITPROPERTIES@ATTUNEMENT_FORTUNE@NAME"
msgstr "Налаштування: удача"

msgid "UNITPROPERTIES@AURA_OF_DISEASE@DESCRIPTION"
msgstr ""
"Наприкінці ходу цього юніта, сусідні ворожі юніти мають базову ймовірність {DISEASE_RESISTANCE>ResolvedStrength}% отримати стан "
"<<acc:c:{GLOBAL.PROPERTIES.DISEASED.Hyperlink}>>."

msgid "UNITPROPERTIES@AURA_OF_DISEASE@NAME"
msgstr "Аура хвороби^f"

msgid "UNITPROPERTIES@BLAZING_AURA@DESCRIPTION"
msgstr ""
"Na kocu tury przylegajce wrogie jednostki:[bulletlist][bullet/]Otrzymuj {BLAZING_AURA_DAMAGE>DAMAGE>Fire} pkt. <<gen:c:m:"
"{GLOBAL.FireDamageConcept.Hyperlink}>>.[bullet/]Maj podstawowe {BURNING_RESISTANCE>ResolvedStrength}% szans na otrzymanie stanu "
"<<c:{GLOBAL.PROPERTIES.BURNING.Hyperlink}>> na {BURNING_EFFECT_DESCRIPTION>NumTurns} [turn/].[/bulletlist]"

msgid "UNITPROPERTIES@BLAZING_AURA@NAME"
msgstr "Palca aura^fa{1}fn{2}"

msgid "UNITPROPERTIES@BOLSTERING_DEFENSE@DESCRIPTION"
msgstr ""
"Цей юніт отримує раз на хід <<acc:{GLOBAL.PROPERTIES.BOLSTERED_DEFENSE.Hyperlink}>>, коли зазнає удару від <<c:"
"{GLOBAL.MeleeConcept.Hyperlink}>> атаки або [hyperlink,GLOBAL.RangedConcept]фізичної дистанційної[/hyperlink] атаки."

msgid "UNITPROPERTIES@BOLSTERING_DEFENSE@DESCRPTION"
msgstr ""
"Цей юніт отримує раз на хід <<acc:{GLOBAL.PROPERTIES.BOLSTERED_DEFENSE.Hyperlink}>>, коли його атакують <<c:"
"{GLOBAL.MeleeConcept.Hyperlink}>> або [hyperlink,GLOBAL.RangedConcept]фізичною дистанційною атакою[/hyperlink]."

msgid "UNITPROPERTIES@BOLSTERING_DEFENSE@NAME"
msgstr "Підтримуючий захист"

msgid "UNITPROPERTIES@BOLSTERING_EVASION@DESCRIPTION"
msgstr ""
"Цей юніт отримує один раз за хід <<acc:c:{GLOBAL.PROPERTIES.EVASION.Hyperlink}>>, коли її вражає атака "
"[hyperlink,GLOBAL.MagicConcept]магічна[/hyperlink] або [hyperlink,GLOBAL.RangedConcept]фізична дистанційна[/hyperlink]."

msgid "UNITPROPERTIES@BOLSTERING_EVASION@NAME"
msgstr "Підтримуюче ухилення"

msgid "UNITPROPERTIES@BOLSTERING_REGENERATION@DESCRIPTION"
msgstr "Цей юніт отримує раз на хід <<acc:{GLOBAL.PROPERTIES.REGENERATION.Hyperlink}>>, коли його атакують."

msgid "UNITPROPERTIES@BOLSTERING_REGENERATION@DESCRPTION"
msgstr "Цей юніт отримує раз на хід [hyperlink,GLOBAL.PROPERTIES.REGENERATION]регенерації[/hyperlink], коли його атакують."

msgid "UNITPROPERTIES@BOLSTERING_REGENERATION@NAME"
msgstr "Підтримуюча регенерація"

msgid "UNITPROPERTIES@BOLSTERING_RESISTANCE@DESCRIPTION"
msgstr ""
"Цей юніт отримує раз на хід <<acc:{GLOBAL.PROPERTIES.BOLSTERED_RESISTANCE.Hyperlink}>>, коли його атакують "
"[hyperlink,GLOBAL.MagicConcept]магічною атакою[/hyperlink]."

msgid "UNITPROPERTIES@BOLSTERING_RESISTANCE@DESCRPTION"
msgstr ""
"Цей юніт отримує раз на хід <<acc:{GLOBAL.PROPERTIES.BOLSTERED_RESISTANCE.Hyperlink}>>, коли його атакують "
"[hyperlink,GLOBAL.MagicConcept]магічною атакою[/hyperlink]."

msgid "UNITPROPERTIES@BOLSTERING_RESISTANCE@NAME"
msgstr "Підтримуючий опір"

msgid "UNITPROPERTIES@BREACHING@DESCRIPTION"
msgstr "Ігнорує {BREACHING>MODIFIERS>ResolvedResistance}% [Resistance/] [hyperlink,GLOBAL.ResistanceConcept]опору[/hyperlink] цілі."

msgid "UNITPROPERTIES@BREACHING@NAME"
msgstr "Прорив"

msgid "UNITPROPERTIES@CAMOUFLAGE@DESCRIPTION"
msgstr "Цей юніт невидимий на [hyperlink,GLOBAL.WorldMapConcept]світовій мапі[/hyperlink]."

msgid "UNITPROPERTIES@CAMOUFLAGE@NAME"
msgstr "Універсальний камуфляж"

msgid "UNITPROPERTIES@CANNOT_REGENERATE@DESCRIPTION"
msgstr "Цей юніт не відновлює здоров'я природним шляхом на світовій мапі."

msgid "UNITPROPERTIES@CANNOT_REGENERATE@NAME"
msgstr "Неможливість регенерації"

msgid "UNITPROPERTIES@CAVALRY_SLAYER@DESCRIPTION"
msgstr ""
"Цей юніт завдає +{CAVALRY_SLAYER_DAMAGE_UP>ResolvedMultiplier}% шкоди наступним юнітам: <<c:"
"{GLOBAL.PROPERTIES.CAVALRY_GROUP.Hyperlink}>>."

msgid "UNITPROPERTIES@CAVALRY_SLAYER@MOD_DESCRIPTION"
msgstr ""
"+{CAVALRY_SLAYER_DAMAGE_UP>ResolvedMultiplier}% шкоди проти юнітів <<gen:c:{GLOBAL.PROPERTIES.CAVALRY_GROUP.Hyperlink}>> і <<gen:c:"
"{GLOBAL.PROPERTIES.LARGE_TARGET.Hyperlink}>>."

msgid "UNITPROPERTIES@CAVALRY_SLAYER@MOD_DESCRIPTION_2"
msgstr ""
"+{CAVALRY_SLAYER_DAMAGE_UP>ResolvedMultiplier}% шкоди проти юнітів <<gen:c:{GLOBAL.PROPERTIES.CAVALRY_GROUP.Hyperlink}>> і <<gen:c:"
"{GLOBAL.PROPERTIES.LARGE_TARGET.Hyperlink}>>."

