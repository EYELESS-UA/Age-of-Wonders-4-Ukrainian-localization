msgid "INTERFACE@MAP_SETUP_TOOLTIP@DRY"
msgstr "Встановіть частоту появи тропічних зон відносно інших зон"

msgid "INTERFACE@MAP_SETUP_TOOLTIP@EARTH"
msgstr "Встановіть частоту появи земельних територій відносно інших територій"

msgid "INTERFACE@MAP_SETUP_TOOLTIP@ENDLESS_UNIT_RANKS"
