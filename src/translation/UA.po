msgid "DIPLOMACY@TRADE@BREAK_TREATY_WARNING"
msgstr ""
"[fireCol]Розірвання угод дасть протилежному правителю {CasusBelliValue} очок <<gen:c:{GLOBAL.CasusBelliConcept.Hyperlink}>> проти "
"тебе і буде вважатися [evilact/] [hyperlink,GLOBAL.AlignmentConcept]негативним[/hyperlink] вчинком ({AlignmentValue}).[/fireCol]"

msgid "DIPLOMACY@TRADE@CANCEL_TREATY"
msgstr "Скасувати угоду"

msgid "DIPLOMACY@TRADE@CANCEL_TREATY_DESCRIPTION"
