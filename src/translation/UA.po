msgid "UNITPROPERTIES@COMBO_MODIFIER_NAME"
msgstr "Підвищена точність"

msgid "UNITPROPERTIES@CONDEMNED@DESCRIPTION"
msgstr "{statusResistance} одиниць [statuseffectresistance/] [hyperlink,GLOBAL.StatusResistanceConcept]опору ефектам[/hyperlink]"

msgid "UNITPROPERTIES@CONDEMNED@MODIFIER_DESCRIPTION"
msgstr ""
"Базовий шанс {CONDEMN_RESISTANCE>ResolvedStrength}% накласти {GLOBAL.PROPERTIES.CONDEMNED.Hyperlink} на юніта до кінця битви."

