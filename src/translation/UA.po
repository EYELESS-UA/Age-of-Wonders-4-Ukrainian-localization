msgid "INTERFACE@MAP_SETUP_TOOLTIP@LANDMASS_TYPE_COAST"
msgstr "Переважно суша з невеликим океаном, що створює довгу берегову лінію."

msgid "INTERFACE@MAP_SETUP_TOOLTIP@LANDMASS_TYPE_ISLANDS"
