"{GLOBAL.TurnConcept.Hyperlink}>>.[bullet/]Зцілити {CULT_OF_TYRANNY_HEALING>NumHitpointsToRestore} [temphp/] "
"[hyperlink,GLOBAL.TemporaryHitPointConcept]тимчасових очок здоров'я[/hyperlink].[/bulletlist]"

msgid "CULTURE_DARK@CULTOFTYRANNY@CULT_OF_TYRANNY@MODIFIER_NAME"
msgstr "Експлуатація вразливості"

msgid "CULTURE_DARK@CULTOFTYRANNY@CULT_OF_TYRANNY@MODIFIER_PROPERTY_DESCRIPTION"
