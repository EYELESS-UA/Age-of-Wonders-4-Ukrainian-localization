msgid "INTERFACE@MAP_SETUP_TOOLTIP@LANDMASS_TYPE_LAND"
msgstr "Переважно суша з обмеженою кількістю води."

msgid "INTERFACE@MAP_SETUP_TOOLTIP@LAVA"
msgstr "Встановіть частоту появи територій, покритих лавою, порівняно з іншими типами територій."

msgid "INTERFACE@MAP_SETUP_TOOLTIP@LORD_TC_AI_PROFILE"
msgstr "Рівень складності бою проти ШІ гравців"

msgid "INTERFACE@MAP_SETUP_TOOLTIP@MAGIC_VICTORY"
msgstr ""
"Увімкнути/вимкнути перемогу через магію[br/]Перемога через магію досягається шляхом вивчення книг, побудови покращень у провінціях "
"джерел і застосування закляття, яке завершує гру після визначеної кількості ходів."

msgid "INTERFACE@MAP_SETUP_TOOLTIP@MANGROVE"
msgstr "Встановіть частоту появи мангрових територій порівняно з іншими типами територій."

msgid "INTERFACE@MAP_SETUP_TOOLTIP@MARAUDER_TC_AI_PROFILE"
msgstr "Рівень складності бою проти армій мародерів"

msgid "INTERFACE@MAP_SETUP_TOOLTIP@MOUNTAINS"
msgstr "Встановіть частоту появи гірських територій порівняно з іншими типами територій."

msgid "INTERFACE@MAP_SETUP_TOOLTIP@MUSHROOM_FOREST"
msgstr "Встановіть частоту появи територій, покритих грибними лісами, порівняно з іншими типами територій."

msgid "INTERFACE@MAP_SETUP_TOOLTIP@OBSERVE_COMBAT"
msgstr "Виберіть, коли спостерігати за ручним боєм гравця, керованого людиною."

msgid "INTERFACE@MAP_SETUP_TOOLTIP@OBSERVE_COMBAT_ALWAYS"
msgstr "Завжди спостерігати за боєм."

msgid "INTERFACE@MAP_SETUP_TOOLTIP@OBSERVE_COMBAT_NEVER"
msgstr "Ніколи не спостерігати за боєм."

msgid "INTERFACE@MAP_SETUP_TOOLTIP@OBSERVE_COMBAT_VISIBLE"
msgstr "Спостерігати за боєм тільки, коли він ведеться на видимих полях."

msgid "INTERFACE@MAP_SETUP_TOOLTIP@OCEAN"
msgstr "Встановіть частоту появи океанічних зон порівняно з іншими зонами."

msgid "INTERFACE@MAP_SETUP_TOOLTIP@PLAYERS"
msgstr "Виберіть кількість гравців у цій грі."

msgid "INTERFACE@MAP_SETUP_TOOLTIP@PLAYER_DISTANCE"
msgstr "Генерує мапу, розмір якої залежить від кількості гравців, із змінною відстанню між стартовими позиціями гравців."

msgid "INTERFACE@MAP_SETUP_TOOLTIP@PLAYER_EMPIRE_MECHANICS"
msgstr ""
"Після увімкнення [hyperlink,GLOBAL.LeaderConcept]володарі[/hyperlink] [hyperlink,GLOBAL.PantheonLoreConcept]Пантеону[/hyperlink] "
"починають з [hyperlink,GLOBAL.AscensionTraitConcept]рисами Вознесіння[/hyperlink], "
"[hyperlink,GLOBAL.AscendedTransformationConcept]трансформаціями[/hyperlink] та піднесеними навичками героя. Крім того, володарі "
"пантеону з позначкою \"герой\" можуть бути запропоновані в якості героїв, а після перемоги піднесені до пантеону.[br/]"
"[br/]Володарі пантеону завжди можуть бути обрані незалежно від цього налаштування."

msgid "INTERFACE@MAP_SETUP_TOOLTIP@PLAYER_EMPIRE_MECHANICS_BONUSTRAIT"
msgstr ""
"Після вибору [hyperlink,GLOBAL.LeaderConcept]володарі[/hyperlink] [hyperlink,GLOBAL.PantheonLoreConcept]Пантеону[/hyperlink] "
"починають з [hyperlink,GLOBAL.AscensionTraitConcept]рисами Вознесіння[/hyperlink]."
"{LOC.INTERFACE@MAP_SETUP_TOOLTIP@PLAYER_EMPIRE_MECHANICS_GENERAL}"

msgid "INTERFACE@MAP_SETUP_TOOLTIP@PLAYER_EMPIRE_MECHANICS_GENERAL"
msgstr ""
"[br/][br/]Вожді пантеону можуть бути завжди обрані, незалежно від цього налаштування, а після перемоги вознестись до Пантеону."

msgid "INTERFACE@MAP_SETUP_TOOLTIP@PLAYER_EMPIRE_MECHANICS_HERORECRUITMENT"
msgstr ""
"Після вибору [hyperlink,GLOBAL.LeaderConcept]володарі[/hyperlink] [hyperlink,GLOBAL.PantheonLoreConcept]Пантеону[/hyperlink] "
"позначені як герої для вербування можуть бути запропоновані як герої. Володарі з Пантеону не можуть бути вербовані як герої в "
"мультиплеєрному режимі та в сюжетних землях.{LOC.INTERFACE@MAP_SETUP_TOOLTIP@PLAYER_EMPIRE_MECHANICS_GENERAL}"

msgid "INTERFACE@MAP_SETUP_TOOLTIP@PLAYER_EMPIRE_MECHANICS_TRANSFORMATIONS"
msgstr ""
"Після вибору [hyperlink,GLOBAL.LeaderConcept]володарі[/hyperlink] [hyperlink,GLOBAL.PantheonLoreConcept]Пантеону[/hyperlink] "
"починають з [hyperlink,GLOBAL.AscendedTransformationConcept]трансформаціями[/hyperlink] та здібностями героя."
"{LOC.INTERFACE@MAP_SETUP_TOOLTIP@PLAYER_EMPIRE_MECHANICS_GENERAL}"

msgid "INTERFACE@MAP_SETUP_TOOLTIP@RANDOM_TRAIT_FILTER_LIST"
