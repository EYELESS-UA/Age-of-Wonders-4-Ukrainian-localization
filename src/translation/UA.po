msgid "DLC@GIANTKINGS@TOME_GEOMANCY@SKILL2@BLIGHT@NAME"
msgstr "Геомантична кристалізація: Блайт"

msgid "DLC@GIANTKINGS@TOME_GEOMANCY@SKILL2@DESCRIPTION"
msgstr ""
"Перетворіть цільову расу на резонансні кристали, що самонаповнюються магією довкілля, отримуючи:[bulletlist][bullet/]Тип юніта "
"{GLOBAL.PROPERTIES.ELEMENTAL.Hyperlink}.[bullet/]Опір певній шкоді залежно від місцевості, на якій знаходиться юніт.[bullet/]+"
"{amount2} шкоди від атак залежно від місцевості, на якій знаходиться юніт.[/bulletlist][br/]"
"{LOC.INTERFACE@ENCHANTMENT_NON_REPEATING@INSERT}"

msgid "DLC@GIANTKINGS@TOME_GEOMANCY@SKILL2@FIRE@NAME"
msgstr "Геомантична кристалізація: Вогонь"

msgid "DLC@GIANTKINGS@TOME_GEOMANCY@SKILL2@FROST@NAME"
msgstr "Геомантична кристалізація: Мороз"

msgid "DLC@GIANTKINGS@TOME_GEOMANCY@SKILL2@LIGHTNING@NAME"
msgstr "Геомантична кристалізація: Блискавка"

