msgid "WILDLIFE_UNITPROPERTIES@WILDHUNT_PRESENCE_03@NAME"
msgstr "Вплив Штормів^mn{1}x{2}"

msgid "WILDLIFE_UNITPROPERTIES@WILDHUNT_PRESENCE_03@PROP_DESCRIPTION"
msgstr "Юніти власника ефекту отримують:[bulletlist][bullet/]{GLOBAL.PROPERTIES.WIND_BARRIER.Hyperlink}[/bulletlist]"

