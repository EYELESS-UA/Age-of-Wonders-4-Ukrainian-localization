msgid "DLC@EMPIRESANDASHES@STORY_REALM_01@PROGENITOR_MEET@ASTRAL_OPTION@SUCCESS"
msgstr "{EventPlayer.FirstName} цінує твоє звернення."

msgid "DLC@EMPIRESANDASHES@STORY_REALM_01@PROGENITOR_PATH_BLOCKED@TOOLTIP"
