msgstr "Знай, що знання — це сила, а силу треба поважати."

msgid "DLC@ELDRITCHREALMS@RACETRAITS_WORLD@KEEPERS_OF_KNOWLEDGE@MODIFIER_DESCRIPTION"
msgstr "Хранителі знань: Розблоковано книги"

msgid "DLC@ELDRITCHREALMS@RACETRAITS_WORLD@KEEPERS_OF_KNOWLEDGE@NAME"
