msgid "TRAITS_BACKGROUND_CHARACTERS@MAIN_TYPE@RACIAL_LEADER@RELATION_MODIFIER"
msgstr "Походження лідера: чемпіон народу"

msgid "TRAITS_BACKGROUND_CHARACTERS@MAIN_TYPE@UNIT_RULER"
