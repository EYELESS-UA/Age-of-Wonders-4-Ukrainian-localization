msgid "DLC@EMPIRESANDASHES@STORY_REALM_01@CONTACT_PROGENITORS_QUEST_INTRO@NATURE_CHECK@SUCCESS"
msgstr "Птахи співають на всі боки про твої добрі наміри щодо Манухарі."

