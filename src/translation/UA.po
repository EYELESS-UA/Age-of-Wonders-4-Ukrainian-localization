msgid "UNITPROPERTIES@CURSE_EATER@NAME"
msgstr "Поглинач проклять"

msgid "UNITPROPERTIES@DAMAGE_REFLECTION@DESCRIPTION"
msgstr "Відбиває {DAMAGE_REFLECTION>ResolvedDamageReflected}% усієї шкоди, отриманої від атак, на атакуючого."

msgid "UNITPROPERTIES@DAMAGE_REFLECTION@NAME"
