msgid "DLC@SECRETSOFTHEARCHMAGES@STORY_REALM_MISSION_02@KARISSA_QUEST@CUSTOM_PREDICTION@BREAK_WITH_KARISSA"
msgstr "Zrywasz z <<ins:{Karissa}>> i samotnie kontynuujesz swoj nikczemn misj zniszczenia."

msgid "DLC@SECRETSOFTHEARCHMAGES@STORY_REALM_MISSION_02@KARISSA_QUEST@CUSTOM_PREDICTION@DECLARE_WAR_ON_ALL"
msgstr ""
"Od teraz moesz wypowiada wojn tylko nowo napotkanym <<dat:c:m:{GLOBAL.EmpireConcept.Hyperlink}>>.[bulletlist][bullet/]Za kade <<c:"
"{GLOBAL.EmpireConcept.Hyperlink}>>, ktremu wypowiesz wojn, zyskujesz +1 <<gen:c:{GLOBAL.ChaosConcept.Hyperlink}>>.[/bulletlist]"

msgid "DLC@SECRETSOFTHEARCHMAGES@STORY_REALM_MISSION_02@KARISSA_QUEST@CUSTOM_PREDICTION@DESTROY_CHAINS"
msgstr ""
"Twoim zadaniem jest zniszczenie i rozmontowanie wszystkich piciu poczonych miast otaczajcych <<acc:{EventRealm}>>.[bulletlist]"
